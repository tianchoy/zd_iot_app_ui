<template>
	<!--
		客服悬浮按钮

		交互（参考 llk-mini 的 liu-drag-button）：
		- 可上下左右拖动，松手后按「离屏幕中线更近的一侧」自动吸附到左/右边缘，带滑入动画；
		- 不做贴边收起：任何时候（含页面滚动）都完整展示，避免只露半边看不清；
		- 背景透明，只展示客服 logo 本身（图片自带底色），不套白底方块。
		未配置任何客服渠道时整体不渲染。
	-->
	<view
		v-if="enabled"
		class="cs-fab"
		:style="containerStyle"
		@touchstart="onTouchStart"
		@touchmove="onTouchMove"
		@touchend="onTouchEnd"
		@touchcancel="onTouchEnd"
		@click="onTap"
	>
		<view class="cs-icon-wrap">
			<image class="cs-icon" src="/static/service.png" mode="aspectFit" />
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref, computed, onMounted, onUnmounted } from 'vue'
	import { emptyCustomerService, hasAnyChannel, openCustomerService } from '@/common/customerService.uts'
	import type { CustomerServiceConfig } from '@/common/customerService.uts'

	/**
	 * 客服配置：由页面从接口下发（卡片详情 objectMap 或租户页面配置）。
	 *
	 * <p>历史实现把 corpId / kfid 链接**硬编码在本组件里**，运营改客服账号必须发版；
	 * 现在只认配置，未配置任何渠道时整个悬浮球不渲染（产品口径：
	 * 「都没有配置则不展示客服 logo」）。</p>
	 */
	const props = defineProps<{
		config?: CustomerServiceConfig
	}>()

	// 不给 props 设「对象工厂默认值」：uni-app x 对 withDefaults 的引用类型默认值支持有限，
	// 这里统一在读取处兜底，避免 props.config 为 undefined 时模板直接不渲染。
	const cfg = computed<CustomerServiceConfig>(() => props.config ?? emptyCustomerService())

	const emit = defineEmits<{
		/**
		 * 需要在页面展示手机号/二维码弹框（降级渠道）。
		 *
		 * <p>事件名必须用下划线：uni-app x 的模板编译不会把 `@show-popup` 归一成
		 * `showPopup`，写成驼峰会「emit 出去了但父页面收不到」——表现为点客服 logo
		 * 完全没反应。项目内其它自定义事件（connect_service / connect_tousu）同理。</p>
		 */
		show_popup: []
	}>()

	const enabled = computed<boolean>(() => hasAnyChannel(cfg.value))

	// 图标固定 48*48（视觉更大更好点）
	const ICON_SIZE = 48
	/** 吸附后与屏幕左右边缘的间距（px） */
	const EDGE_GAP = 2
	/** 吸附动画时长，与 style 里的 transition 保持一致 */
	const SNAP_MS = 250

	const windowWidth = ref<number>(375)
	const windowHeight = ref<number>(667)

	// 当前位置（px，相对视口左上角）
	const posX = ref<number>(0)
	const posY = ref<number>(0)
	// 是否处于「松手吸附」的动画窗口：拖动跟手时不能有过渡，否则会拖出橡皮筋感
	const snapping = ref<boolean>(false)

	let startClientX = 0
	let startClientY = 0
	let startPosX = 0
	let startPosY = 0
	let moved = false
	let snapTimer: number | null = null

	const clamp = (v: number, min: number, max: number): number => {
		if (v < min) return min
		if (v > max) return max
		return v
	}

	const containerStyle = computed<UTSJSONObject>(() => {
		return {
			transform: 'translate(' + posX.value + 'px,' + posY.value + 'px)',
			transition: snapping.value ? ('transform ' + SNAP_MS + 'ms ease') : 'none'
		}
	})

	/**
	 * 松手吸附：以图标中心点判断靠左还是靠右，吸到对应边缘。
	 *
	 * <p>和参考组件同一口径（中线左 → 贴左，中线右 → 贴右），
	 * 拖到屏幕中间松手也不会停在中间挡内容。</p>
	 */
	const snapToEdge = () => {
		const centerX = posX.value + ICON_SIZE / 2
		const isLeft = centerX < windowWidth.value / 2
		snapping.value = true
		posX.value = isLeft ? EDGE_GAP : (windowWidth.value - ICON_SIZE - EDGE_GAP)
		if (snapTimer != null) {
			clearTimeout(snapTimer!)
		}
		snapTimer = setTimeout(() => {
			snapping.value = false
			snapTimer = null
		}, SNAP_MS + 30)
	}

	/**
	 * 按统一优先级打开客服（客服地址 → 企业微信客服 → 手机号/二维码弹框）。
	 *
	 * <p>本组件只负责「点一下」，渠道判定与降级全在 {@code common/customerService.uts}，
	 * 避免与充值页出现两套口径。</p>
	 */
	const handleOpenCustomerService = () => {
		openCustomerService(cfg.value, () => {
			// 降级渠道：弹框由页面渲染（组件不持有 UI，避免每处各写一套）
			emit('show_popup')
		})
	}

	const onTouchStart = (e: any) => {
		snapping.value = false
		const t = e.touches[0]
		startClientX = t.clientX
		startClientY = t.clientY
		startPosX = posX.value
		startPosY = posY.value
		moved = false
	}

	const onTouchMove = (e: any) => {
		const t = e.touches[0]
		const dx = t.clientX - startClientX
		const dy = t.clientY - startClientY
		// 阈值 8px（与设备端一致）：手指轻点时的细微抖动不应被判成拖动，
		// 否则 onTap 会把这次点击当成拖动结束而吞掉，表现为「点了没反应」。
		if (Math.abs(dx) > 8 || Math.abs(dy) > 8) {
			moved = true
		}
		posX.value = clamp(startPosX + dx, 0, windowWidth.value - ICON_SIZE)
		posY.value = clamp(startPosY + dy, 0, windowHeight.value - ICON_SIZE)
	}

	const onTouchEnd = () => {
		// 只有真的拖过才吸附；单纯点击保持原位（避免点一下按钮就滑走）
		if (moved) {
			snapToEdge()
		}
	}

	// 必须以原生 TAP 手势调用 openCustomerServiceChat，否则报
	// "can only be invoked by user TAP gesture"
	const onTap = () => {
		// 拖动结束后可能附带触发 click，忽略
		if (moved) {
			moved = false
			return
		}
		handleOpenCustomerService()
	}

	onMounted(() => {
		try {
			// @ts-ignore
			const info = uni.getWindowInfo()
			windowWidth.value = info.windowWidth
			windowHeight.value = info.windowHeight
		} catch (e) {
			// 兜底尺寸
		}
		// 默认吸附右侧、垂直居中
		posX.value = windowWidth.value - ICON_SIZE - EDGE_GAP
		posY.value = (windowHeight.value - ICON_SIZE) / 2
	})

	onUnmounted(() => {
		if (snapTimer != null) {
			clearTimeout(snapTimer!)
			snapTimer = null
		}
	})
</script>

<style scoped lang="scss">
	.cs-fab {
		position: fixed;
		left: 0;
		top: 0;
		width: 48px;
		height: 48px;
		z-index: 999;
		touch-action: none;
		pointer-events: auto;
		background-color: transparent;
		// uni-app x 的 view 默认 overflow:hidden，会把上跳超出的部分裁掉；48*48 只约束图标，不约束跳动高度
		overflow: visible;
	}

	// 透明容器：只承载跳动动画，不再画白底/阴影/圆角
	.cs-icon-wrap {
		width: 48px;
		height: 48px;
		background-color: transparent;
		display: flex;
		align-items: center;
		justify-content: center;
		animation: cs-bounce 1.2s ease-in-out infinite;
	}

	.cs-icon {
		width: 48px;
		height: 48px;
	}

	@keyframes cs-bounce {
		0%, 100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(-8px);
		}
	}
</style>
