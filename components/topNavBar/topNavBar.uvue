<template>
	<!-- 状态栏占位（固定定位） -->
	<view v-if="isShowStyle" :style="statusBarStyle"></view>
	<!-- 导航栏（固定定位） -->
	<view v-if="isShowStyle" class="navbar" :style="navBarStyle">
		<view class="back-btn" :style="{ visibility: showBack ? 'visible' : 'hidden' }">
			<rice-icon v-if="showBack" name="arrow-left" size="35rpx" color="#333" class="icon" @click="handleBack"></rice-icon>
		</view>
		<view class="title" :style="{ color: textColor, 'line-height': navBarHeight + 'px' }">
			<slot name="title">{{ displayTitle }}</slot>
		</view>
		<view class="capsule">
			<view class="capsule-item">
				<view v-if="showCapsule" :class="{ 'capsule-text-action': !isIcon && rightActionBackgroundColor !== 'transparent' }"
            :style="!isIcon ? { backgroundColor: rightActionBackgroundColor } : {}" @click="emit('capsuleClick', 'menu')">
					<rice-icon v-if="isIcon" :name="Icon" size="26" :color="iconColor"></rice-icon>
					<text v-else :style="{ fontSize: rightTextFontSize }">{{rightText}}</text>
				</view>
			</view>
		</view>
	</view>

	<!-- 非固定定位模式（普通布局） -->
	<template v-else>
		<view :style="{ height: statusBarHeight + 'px', backgroundColor: backgroundColor }"></view>
		<view class="navbar" :style="{ height: navBarHeight + 'px', backgroundColor: backgroundColor }">
			<view class="back-btn" :style="{ visibility: showBack ? 'visible' : 'hidden' }">
				<rice-icon v-if="showBack" name="arrow-left" size="40rpx" class="icon" @click="handleBack"></rice-icon>
			</view>
			<view class="title" :style="{ color: textColor, 'line-height': navBarHeight + 'px' }">
				<slot name="title">{{ displayTitle }}</slot>
			</view>
			<view class="capsule">
				<view class="capsule-item">
					<view v-if="showCapsule" :class="{ 'capsule-text-action': !isIcon && rightActionBackgroundColor !== 'transparent' }"
              :style="!isIcon ? { backgroundColor: rightActionBackgroundColor } : {}" @click="emit('capsuleClick', 'menu')">
						<rice-icon v-if="isIcon" :name="Icon" size="26" :color="iconColor"></rice-icon>
						<text v-else :style="{ fontSize: rightTextFontSize }">{{rightText}}</text>
					</view>
				</view>
			</view>
		</view>
	</template>

	<!-- 固定定位模式下的占位元素（防止内容被遮挡） -->
	<view v-if="isShowStyle" :style="{ height: totalNavHeight + 'px' }"></view>
</template>

<script setup lang="uts">
import { onMounted, computed } from 'vue'
import { getPlatformInfo } from '@/api/http.uts'

const props = defineProps({
	title: String,
	showBack: { type: Boolean, default: true },
	backText: { type: String, default: '' },
	showCapsule: { type: Boolean, default: true },
	backgroundColor: { type: String, default: '#f4f7fb' },
	textColor: { type: String, default: '#000000' },
	isIcon: { type: Boolean, default: true },
	Icon: { type: String, default: 'add-circle' },
	rightText: { type: String, default: '' },
	rightActionBackgroundColor: { type: String, default: 'transparent' },
	rightTextFontSize: { type: String, default: '22rpx' },
	isShowStyle: { type: Boolean, default: true },
	iconColor: { type: String, default: '#606266' }
});

const emit = defineEmits(['back', 'capsuleClick']);

// 页面未显式传 title 时，用后台平台信息接口返回的名称兜底，避免导航栏出现空白。
// 服务端按上报的 appId 反查，优先取当前小程序 / 公众号自己的名称，未配置则回退租户级平台名称。
// 各业务页传的都是页面名（「我的」「卡片」…），这里只兜底「没传标题」的情况，不覆盖页面名。
const platformName = ref<string>('')
onMounted(() => {
	if (props.title != null && props.title.length > 0) {
		return
	}
	getPlatformInfo()
		.then((res) => {
			if (res != null && res.code == 200 && res.data != null) {
				const name = res.data.platformName
				if (name != null && name.length > 0) {
					platformName.value = name
				}
			}
		})
		.catch(() => {
			console.log('读取平台品牌信息失败，导航栏保持空白')
		})
})
const displayTitle = computed(() => {
	if (props.title != null && props.title.length > 0) {
		return props.title
	}
	return platformName.value
})

const statusBarHeight = ref(20);
const navBarHeight = ref(44);

// 计算总高度
const totalNavHeight = computed(() => statusBarHeight.value + navBarHeight.value);

// 状态栏样式
const statusBarStyle = computed(() => ({
	height: statusBarHeight.value + 'px',
	backgroundColor: props.backgroundColor,
	position: 'fixed',
	width: '100%',
	left: 0,
	top: 0,
	zIndex: 100
}));

// 导航栏样式
const navBarStyle = computed(() => ({
	height: navBarHeight.value + 'px',
	backgroundColor: props.backgroundColor,
	position: 'fixed',
	width: '100%',
	left: 0,
	top: statusBarHeight.value + 'px',
	zIndex: 100
}));

// 获取导航栏信息
const getNavBarInfo = () => {
	// #ifdef MP-WEIXIN
	try {
		const systemInfo = uni.getSystemInfoSync();
		statusBarHeight.value = systemInfo.statusBarHeight || 20;

		const menuButtonInfo = uni.getMenuButtonBoundingClientRect();
		if (menuButtonInfo) {
			const navHeight = (menuButtonInfo.top - statusBarHeight.value) * 2 + menuButtonInfo.height;
			navBarHeight.value = navHeight > 0 ? navHeight : 44;
		}
	} catch (e) {
		console.error('获取导航栏信息失败', e);
	}
	// #endif

	// #ifdef H5
	statusBarHeight.value = 0;
	navBarHeight.value = 44;
	// #endif
};

// 处理返回事件
const handleBack = () => {
	if (props.showBack) {
		emit('back');
	}
};

onMounted(() => {
	getNavBarInfo();
});
</script>

<style scoped>
.navbar {
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	align-items: center;
	box-sizing: border-box;
}

.back-btn {
	display: flex;
	align-items: center;
	width: 70rpx;
	height: 40rpx;
	z-index: 10;
	justify-content: center;
	flex-shrink: 0;
}

.title {
	flex: 1;
	text-align: center;
	font-weight: bold;
	font-size: 30rpx;
	overflow: hidden;
	text-overflow: ellipsis;
	white-space: nowrap;
	padding: 0 20rpx;
	display: flex;
	flex-direction: row;
	align-items: center;
	justify-content: center;
}

.capsule {
	display: flex;
	align-items: center;
	justify-content: flex-end;
	flex-shrink: 0;
	min-width: 70rpx;
  margin-right: 20rpx;
}

.capsule-item {
	display: flex;
	justify-content: center;
	align-items: center;
	white-space: nowrap;
}

.capsule-text-action {
	border: 1px solid #bbf7d0;
	border-radius: 40rpx;
	color: #16a34a;
	font-size: 24rpx;
	font-weight: bold;
	padding: 10rpx 25rpx;
	white-space: nowrap;
}

.icon {
	width: 40rpx;
	height: 40rpx;
}

/* #ifdef APP-ANDROID */
.navbar {
	position: relative;
	justify-content: center;
}

.title {
	position: absolute;
	left: 0;
	right: 0;
	width: 100%;
	padding: 0;
	z-index: 1;
}

.back-btn,
.capsule {
	z-index: 2;
}
/* #endif */
</style>
