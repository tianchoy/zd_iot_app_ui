// 订单详情里去支付Xcx
export function goPayXcx(orderId:string, merchantConfigId: string, withToken: boolean = true, mpToken: string = ''): Promise<ApiResponse<any>> {
  // #ifdef MP-WEIXIN
  const url = (ApiUrl.goPayXcx as string) + orderId
  const token = true
  // #endif

  // #ifdef H5
  // mpToken 为空表示未完成公众号授权，后端自动回退微信H5支付
  const mpTokenQuery = mpToken.length > 0 ? '?mpToken=' + encodeURIComponent(mpToken) : ''
  const url = (ApiUrl.goPayGnH5 as string) + orderId + '/' + merchantConfigId + mpTokenQuery
  const token = false
  // #endif
  // #ifndef MP-WEIXIN || H5
  // 其他平台默认使用H5配置
  const url = (ApiUrl.goPayGnH5 as string) + orderId
  const token = false
  // #endif
  
  return request<any>({
    url: url,
    method: 'POST',
    withToken: token
  })
}

