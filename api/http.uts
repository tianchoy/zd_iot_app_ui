// 查询反馈列表（H5）
//
// 必须携带 appId；默认带 token，后端据此返回「当前用户提交的反馈」。
// 传了 rechargeNo 则只查该卡的反馈（用于查没有提交人归属的历史数据）。
export function getFeedbackList(rechargeNo: string = '', withToken: boolean = true): Promise<ApiResponse<FeedbackItem[]>> {
  const data: UTSJSONObject = {
    appId: config.api.auth.appID
  }
  if (rechargeNo.length > 0) {
    data['rechargeNo'] = rechargeNo
  }
  return request<FeedbackItem[]>({
    url: ApiUrl.feedbackList as string,
    method: 'GET',
    data: data,
    withToken: withToken
  })
}

// 查询反馈详情（H5，需携带充值号作为匿名接口的归属凭据）
export function getFeedbackDetail(id: string, rechargeNo: string, withToken: boolean = false): Promise<ApiResponse<FeedbackDetail>> {
  const data: UTSJSONObject = {
    rechargeNo: rechargeNo
  }
  return request<FeedbackDetail>({
    url: (ApiUrl.feedbackDetail as string) + id,
    method: 'GET',
    data: data,
    withToken: withToken
  })
}

// 提交反馈（H5）
export function submitFeedback(data: UTSJSONObject, withToken: boolean = false): Promise<ApiResponse<any>> {
  return request<any>({
    url: ApiUrl.feedbackSubmit as string,
    method: 'POST',
    data: data,
    withToken: withToken
  })
}

// 回复反馈（H5）
export function replyFeedback(data: UTSJSONObject, withToken: boolean = false): Promise<ApiResponse<any>> {
  return request<any>({
    url: ApiUrl.feedbackReply as string,
    method: 'POST',
    data: data,
    withToken: withToken
  })
}

// 关闭反馈（H5，需携带充值号作为匿名接口的归属凭据）
// 注意：POST 的 data 会作为 JSON body 发送，后端按 @RequestParam 接收，故这里必须拼到 URL 上
export function closeFeedback(id: string, rechargeNo: string, withToken: boolean = false): Promise<ApiResponse<any>> {
  return request<any>({
    url: (ApiUrl.feedbackClose as string) + id + '?rechargeNo=' + encodeURIComponent(rechargeNo),
    method: 'POST',
    withToken: withToken
  })
}