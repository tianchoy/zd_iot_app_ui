// 国际版：去支付
// PayerMax 渠道后端返回 approval_url（前端跳转收银台）；
// Stripe 渠道后端返回 clientKey + clientSecret（前端拉起 Stripe Elements）。
export function goPayIntl(data: UTSJSONObject, withToken: boolean = false): Promise<ApiResponse<any>> {
  return request<any>({
    url: (ApiUrl.goPay as string),
    method: 'POST',
    data: data,
    withToken: withToken
  })
}

