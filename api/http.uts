// api/http.uts
import { ApiUrl } from './url'
import { request, type ApiResponse } from './Request.uts'
import { config, getTenantId, setTenantId, getAppId } from '@/common/config.uts'
import type {
  LoginData,
  CountryData,
  TenantInfoData,
  QueryCardListParams,
  CardListSumData,
  BindCard,
  PkgInfoListParams,
  QueryOrderListXcxParams,
  QueryOrderListXcxData,
  QueryOrderDetailXcxData,
  QueryOrderSuccessParams,
  RechargeData,
  FeedbackItem,
  FeedbackDetail,
  PlatformInfoData
} from './types'

// 查询平台品牌与备案信息（匿名接口，登录前也可展示品牌）
//
// 身份线索按端区分，不要混用：
// - 小程序：appId 是唯一可信线索（路径 tenantId 只作旧包兜底）；
// - H5：编译产物里没有小程序 appid、也没有租户号，只认卡号（rechargeNo）；
//   首屏还没有卡号时不传，后端回退平台自身，拿到卡号后再取一次即可覆盖。
export async function getPlatformInfo(tenantId: string = '', rechargeNo: string = ''): Promise<ApiResponse<PlatformInfoData>> {
	// #ifdef MP-WEIXIN
	const effectiveTenantId = tenantId.length > 0 ? tenantId : getTenantId()
	const url = (ApiUrl.platformInfo as string) + '/' + effectiveTenantId + '?appId=' + getAppId()
	// #endif
	// #ifdef H5
	// H5 产物里没有小程序身份：只按卡号，首屏无卡时由后端回退平台自身
	const cardQuery = rechargeNo.length > 0 ? '?rechargeNo=' + encodeURIComponent(rechargeNo) : ''
	const url = (ApiUrl.platformInfo as string) + cardQuery
	// #endif
	// #ifndef MP-WEIXIN || H5
	// App 等原生端保留路径租户兜底（旧行为），卡号传了则后端按卡优先
	const fallbackTenantId = tenantId.length > 0 ? tenantId : getTenantId()
	const cardQuery = rechargeNo.length > 0 ? '?rechargeNo=' + encodeURIComponent(rechargeNo) : ''
	const url = (ApiUrl.platformInfo as string) + '/' + fallbackTenantId + cardQuery
	// #endif
	const res = await request<PlatformInfoData>({
		url,
		method: 'GET',
		withToken: false
	})
	// 小程序 / App：落库服务端解析出的租户号，供后续请求复用；H5 没有租户概念，跳过
	// （否则会把平台兜底的 000000 写进运行时租户，反而污染后续请求）
	// #ifndef H5
	if (res != null && res.code == 200 && res.data != null) {
		const resolved = (res.data as UTSJSONObject)['tenantId'] as string
		if (resolved != null && resolved.length > 0) {
			setTenantId(resolved)
		}
	}
	// #endif
	return res
}

// 查询国家列表
export function getCountryList(withToken: boolean = false): Promise<ApiResponse<CountryData[]>> {
  return request<CountryData[]>({
    url: ApiUrl.countries as string,
    method: 'GET',
    withToken
  })
}

// 登录
/*
* 登录需要这三个固定的参数
* tenantId
* clientId:12353d4772a25656d6d2a67d53353cc3
* grantType:xcx
*/
export function login(data: UTSJSONObject, withToken: boolean = true): Promise<ApiResponse<LoginData>> {
  return request<LoginData>({
    url: ApiUrl.login as string,
    method: 'POST',
    data: {
      ...data,
      tenantId: getTenantId(),
      clientId: config.api.auth.clientId,
      grantType: config.api.auth.grantType,
      // 多小程序识别：C端上报自身 appid，服务端据此反查所属租户与 appSecret
      appId: getAppId(),
    },
    withToken
  })
}

// 获取租户页面配置（自动适配平台）
//
// - 小程序：tenantId 为兜底值，同时携带自身 appId，服务端以 appId 反查到的租户为准；
// - H5：产物里没有小程序 appid 与租户号，只按卡号（rechargeNo）定位租户，卡号为空时
//   后端回退平台自身；因此 H5 分支不拼 appId、也不拼路径 tenantId。
export async function getTenantInfo(tenantId: string, withToken: boolean = true, rechargeNo: string = ''): Promise<ApiResponse<TenantInfoData>> {
	// #ifdef MP-WEIXIN
	const effectiveTenantId = tenantId.length > 0 ? tenantId : getTenantId()
	const url = (ApiUrl.getTenantPageConfigXcx as string) + '/' + effectiveTenantId + '?appId=' + getAppId()
	const token = true
	// #endif

	// #ifdef H5
	// H5 产物里没有小程序 appid 与租户号：身份只来自卡号
	const cardQuery = rechargeNo.length > 0 ? '?rechargeNo=' + encodeURIComponent(rechargeNo) : ''
	const url = (ApiUrl.getTenantPageConfigH as string) + cardQuery
	const token = false
	// #endif

	// #ifndef MP-WEIXIN || H5
	// 其他平台（App 等）沿用路径租户兜底，卡号传了则后端按卡优先
	const fallbackTenantId = tenantId.length > 0 ? tenantId : getTenantId()
	const cardQuery = rechargeNo.length > 0 ? '?rechargeNo=' + encodeURIComponent(rechargeNo) : ''
	const url = (ApiUrl.getTenantPageConfigH as string) + '/' + fallbackTenantId + cardQuery
	const token = false
	// #endif

	const res = await request<TenantInfoData>({
		url: url,
		method: 'GET',
		withToken: token
	})
	// 小程序 / App：落库服务端按 appId 反查到的租户号，后续请求按它取，
	// 否则会出现「后台改的是 A 租户、客户端读的是打包常量 B 租户」。
	// H5 没有租户概念（后续请求都按卡），不写运行时租户，避免把平台 000000 缓存下来。
	// #ifndef H5
	if (res != null && res.code == 200 && res.data != null) {
		const resolved = (res.data as UTSJSONObject)['tenantId'] as string
		if (resolved != null && resolved.length > 0) {
			setTenantId(resolved)
		}
	}
	// #endif
	return res
}

// 获取公众号H5授权地址（仅微信内置浏览器调用）
// H5 产物不带 appId / tenantId：租户完全由卡号确定（后端按 card_info 反查），
// 因此这里只传回跳地址与卡号；未配置公众号时后端返回失败，调用方按原 H5 支付继续。
export function getWxMpH5AuthUrl(returnUrl: string, iccid: string = ''): Promise<ApiResponse<any>> {
  const iccidQuery = iccid.length > 0 ? '&iccid=' + encodeURIComponent(iccid) : ''
  return request<any>({
    url: (ApiUrl.wxMpH5AuthUrl as string) + '?returnUrl=' + encodeURIComponent(returnUrl) + iccidQuery,
    method: 'GET',
    withToken: false,
    showError: false
  })
}

// 查询卡列表
export function queryCardList(params: QueryCardListParams, withToken: boolean = true): Promise<ApiResponse<RechargeData[]>> {
  const data: UTSJSONObject = {
    rechargeNo: params.rechargeNo,
    status: params.status,
    isSort: params.isSort
  }
  return request<RechargeData[]>({
    url: ApiUrl.queryCardList as string,
    method: 'GET',
    data: data,
    withToken: withToken
  })
}

// 查询卡列表统计
export function queryCardListSum(withToken: boolean = true): Promise<ApiResponse<CardListSumData>> {
  return request<CardListSumData>({
    url: ApiUrl.queryCardListSum as string,
    method: 'GET',
    withToken: withToken
  })
}

// 查询卡详情Xcx
export function queryCardDetail(id: string,countryCode?: string, isFind?:string, withToken: boolean = true): Promise<ApiResponse<RechargeData>> {
	// #ifdef MP-WEIXIN
	const url = (ApiUrl.queryCardDetailXcx as string) + id + '/' + isFind
  const token = true
	// #endif

	// #ifdef H5 && VERSION_INT
	// 国际版：把国家码拼到路径，后端据此返回对应国家/币种的套餐
	const url = (ApiUrl.card_detail as string) + id + '/' + (countryCode ?? '')
  const token = true
	// #endif

	// #ifdef H5
	// #ifndef VERSION_INT
	const url = (ApiUrl.card_detail as string) + id
  const token = true
	// #endif
	// #endif

	// #ifndef MP-WEIXIN || H5 || VERSION_INT || VERSION_CN
	// 其他平台默认使用H5配置
	const url = (ApiUrl.card_detail as string) + id
  const token = true
	// #endif


	return request<RechargeData>({
		url: url,
		method: 'GET',
		withToken: token
	})
}


// 绑定卡
export function userBindCard(data: BindCard, withToken: boolean = true): Promise<ApiResponse<any>> {
  const body: UTSJSONObject = {
    rechargeNo: data.rechargeNo
  }
  return request<any>({
    url: ApiUrl.userBindCard as string,
    method: 'POST',
    data: body,
    withToken: withToken
  })
}

// 解绑卡
export function userUnBindCard(id: string, withToken: boolean = true): Promise<ApiResponse<any>> {
  return request<any>({
    url: (ApiUrl.userUnBindCard as string) + id,
    method: 'DELETE',
    withToken: withToken
  })
}



// 查询套餐信息列表 
export function queryPkgInfoList(data: PkgInfoListParams, withToken: boolean = true): Promise<ApiResponse<any>> {
	// #ifdef MP-WEIXIN
	const url = (ApiUrl.queryXcxCardList as string)
  const token = true
	// #endif

	// #ifdef H5
	const url = (ApiUrl.queryPkgInfoList as string)
  const token = false
	// #endif

	// #ifndef MP-WEIXIN || H5
	// 其他平台默认使用H5配置
	const url = (ApiUrl.queryPkgInfoList as string)
  const token = false
	// #endif

	const body: UTSJSONObject = {
		rechargeNo: data.rechargeNo,
		status: data.status
	}

	return request<any>({
		url: url,
		method: 'GET',
		data: body,
		withToken: token
	})
}

