/**
 * 客服渠道统一封装（卡项目：小程序 / 公众号H5 / 外部H5 / App）
 *
 * <p>统一口径（产品确认）：**客服地址 &gt; 企业微信客服 &gt; 客服手机号/二维码**。
 * 微信小程序端例外：客服地址整条渠道视为未配置，优先级从企业微信客服开始。</p>
 *
 * <p>与后端的分工：服务端只下发原始字段（空值不下发 key），**不做优先级裁剪**——
 * 同一份配置在小程序、微信内 H5、外部浏览器里可执行的动作不同，服务端无法判定。
 * 所有「能不能跳」的判断集中在本文件，页面只调用 {@link openCustomerService}。</p>
 *
 * <p>环境能力：</p>
 * <ul>
 *   <li>小程序：`uni.openCustomerServiceChat` 可用（必须用户 TAP 同步调用）；
 *       客服地址（外部链接）整体忽略：不复制、不提示、也不参与渠道判定。</li>
 *   <li>微信内置浏览器 H5：客服地址用 `window.open`；企业微信客服直接打开 kfid 链接。</li>
 *   <li>外部浏览器 / App 内 WebView：企业微信客服不可用，跳过该渠道继续降级。</li>
 * </ul>
 *
 * @author zd-iot
 */

import { isWechatWebView } from './config.uts'

/** 客服渠道标识 */
export const CS_CHANNEL_NONE = 'none'
export const CS_CHANNEL_JUMP = 'jump'
export const CS_CHANNEL_WECOM = 'wecom'
export const CS_CHANNEL_POPUP = 'popup'

/** 客服配置（与后端下发的 6 个字段一一对应；空串 = 未配置） */
export type CustomerServiceConfig = {
	serviceJumpUrl: string
	serviceCorpId: string
	serviceKfidUrl: string
	servicePhone: string
	serviceQrcode: string
	serviceTime: string
}

/** 空配置：接口还没回来 / 接口失败时使用，等价于「什么渠道都没配」 */
export function emptyCustomerService(): CustomerServiceConfig {
	return {
		serviceJumpUrl: '',
		serviceCorpId: '',
		serviceKfidUrl: '',
		servicePhone: '',
		serviceQrcode: '',
		serviceTime: ''
	}
}

/**
 * 从接口响应构造客服配置。
 *
 * <p>用 UTSJSONObject + getString 取值而不是字段直读：后端对空值**不下发 key**，
 * 直读缺失字段在 UTS 里会拿到 undefined 并污染后续判断。</p>
 */
export function buildCustomerServiceConfig(data: UTSJSONObject | null): CustomerServiceConfig {
	if (data == null) {
		return emptyCustomerService()
	}
	return {
		serviceJumpUrl: data.getString('serviceJumpUrl', ''),
		serviceCorpId: data.getString('serviceCorpId', ''),
		serviceKfidUrl: data.getString('serviceKfidUrl', ''),
		servicePhone: data.getString('servicePhone', ''),
		serviceQrcode: data.getString('serviceQrcode', ''),
		serviceTime: data.getString('serviceTime', '')
	}
}

/**
 * 过渡兜底：接口异常且从未成功拿到配置时，沿用改造前写死在卡片页的企业微信客服。
 *
 * <p><b>仅用于请求异常</b>；接口正常返回但字段为空（运营主动清空）时仍然隐藏入口，
 * 否则运营会发现「后台清不掉客服」。待所有租户后台配好企微客服后可删除本函数。</p>
 */
export function legacyCustomerService(): CustomerServiceConfig {
	return {
		serviceJumpUrl: '',
		serviceCorpId: 'ww686122ec6a4db85a',
		serviceKfidUrl: 'https://work.weixin.qq.com/kfid/kfc030824eb947a0c9a',
		servicePhone: '',
		serviceQrcode: '',
		serviceTime: ''
	}
}

/** 企业微信客服是否配置完整（corpId 与 kfid 链接缺一不可） */
export function hasWecom(cfg: CustomerServiceConfig): boolean {
	return cfg.serviceCorpId.trim().length > 0 && cfg.serviceKfidUrl.trim().length > 0
}

/** 是否配置了客服手机号或二维码（降级弹框的两个内容） */
export function hasPopupChannel(cfg: CustomerServiceConfig): boolean {
	return cfg.servicePhone.trim().length > 0 || cfg.serviceQrcode.trim().length > 0
}

/**
 * 当前环境是否存在**任一可执行动作**：false 时页面不渲染客服入口。
 *
 * <p>与 {@link openCustomerService} 的降级链逐条对应：只配了企微客服但当前是
 * 外部浏览器 / App 时，企微唤不起来且又没有电话/二维码，入口就不该出现——
 * 否则会出现「logo 显示、点了毫无反应」。</p>
 *
 * <p>微信小程序端把客服地址视为未配置（不复制、不提示），因此只配了客服地址时
 * 小程序不渲染入口；H5 与其它环境仍按原逻辑计入。</p>
 */
export function hasAnyChannel(cfg: CustomerServiceConfig): boolean {
	return resolveChannel(cfg) != CS_CHANNEL_NONE
}

/**
 * 客服地址是否作为有效渠道参与判定。
 *
 * <p>仅微信小程序端返回 false：外部链接打不开，原先「复制链接 + toast 后继续降级」
 * 既会弹出误导性提示，又会让只配了地址的小程序显示一个点了没用的入口。
 * H5 / App 保持原逻辑。</p>
 */
function hasServiceJump(cfg: CustomerServiceConfig): boolean {
	// #ifdef MP-WEIXIN
	return false
	// #endif
	return cfg.serviceJumpUrl.trim().length > 0
}

/** 外部浏览器/小程序无法直接打开外部链接：H5 才可直接打开，其余环境只能复制 */
export function canOpenUrlDirectly(): boolean {
	// #ifdef H5
	return true
	// #endif
	return false
}

/** 企业微信客服是否能在当前环境唤起 */
export function canOpenWecom(): boolean {
	// #ifdef MP-WEIXIN
	return true
	// #endif

	// #ifdef H5
	// 微信内置浏览器（公众号 H5）可直接打开 kfid 链接进微信客服；外部浏览器不行
	return isWechatWebView()
	// #endif

	return false
}

/**
 * 解析当前环境下的实际客服渠道。
 *
 * <p>顺序严格按「客服地址 → 企业微信客服 → 手机号/二维码」；某渠道在当前环境不可用时
 * **跳过并继续下降**，而不是整块失效。</p>
 */
export function resolveChannel(cfg: CustomerServiceConfig): string {
	const hasJump = hasServiceJump(cfg)
	// 1) 客服地址：H5 可直接打开
	if (hasJump && canOpenUrlDirectly()) {
		return CS_CHANNEL_JUMP
	}
	// 2) 企业微信客服：仅小程序 / 微信内置浏览器可用，其它环境跳过继续降级
	if (hasWecom(cfg) && canOpenWecom()) {
		return CS_CHANNEL_WECOM
	}
	// 3) 客服地址在 App 等环境只能复制，也算一个可执行动作（复制后仍会继续降级）；
	//    微信小程序端 hasJump 恒为 false，不会走到这一步
	if (hasJump) {
		return CS_CHANNEL_JUMP
	}
	// 4) 手机号 / 二维码弹框
	if (hasPopupChannel(cfg)) {
		return CS_CHANNEL_POPUP
	}
	return CS_CHANNEL_NONE
}

/** 客服手机号列表（后端用英文逗号分隔） */
export function splitServicePhones(cfg: CustomerServiceConfig): string[] {
	const raw = cfg.servicePhone.trim()
	if (raw.length == 0) {
		return [] as string[]
	}
	const list: string[] = []
	raw.split(',').forEach((item: string) => {
		const value = item.trim()
		if (value.length > 0) {
			list.push(value)
		}
	})
	return list
}

/**
 * 按优先级打开客服。
 *
 * @param cfg          客服配置
 * @param onShowPopup  需要展示手机号/二维码弹框时回调（渠道为 POPUP 时）
 */
export function openCustomerService(cfg: CustomerServiceConfig, onShowPopup: () => void): void {
	const hasJump = hasServiceJump(cfg)

	// 1) 客服地址优先：H5 直接打开后结束；App 只完成复制，继续往下降级。
	//    微信小程序端 hasJump 恒为 false —— 完全跳过复制/toast，直接走企业微信客服
	if (hasJump) {
		openUrl(cfg.serviceJumpUrl)
		if (canOpenUrlDirectly()) {
			return
		}
	}

	// 2) 企业微信客服：当前环境唤不起时跳过；唤起失败的异步回调里继续降级
	if (hasWecom(cfg) && canOpenWecom()) {
		openWecom(cfg.serviceCorpId, cfg.serviceKfidUrl, () => {
			if (hasPopupChannel(cfg)) {
				onShowPopup()
			} else {
				uni.showToast({ title: '客服打开失败，请稍后重试', icon: 'none' })
			}
		})
		return
	}

	// 3) 手机号 / 二维码弹框
	if (hasPopupChannel(cfg)) {
		onShowPopup()
		return
	}

	// 4) 绝不静默返回：App 等环境只复制过链接时 openUrl 已给过 toast，不再重复提示。
	//    小程序端 hasJump 恒为 false，不会复制，也不会走到这个 return
	if (hasJump) {
		return
	}
	if (hasWecom(cfg)) {
		// 配置了企微但当前环境唤不起（外部浏览器 / App WebView）
		uni.showToast({ title: '请在微信内打开以联系在线客服', icon: 'none' })
	} else {
		uni.showToast({ title: '暂未配置客服，请联系管理员', icon: 'none' })
	}
}

/** 打开客服地址：H5 直接新窗口；App 复制链接（微信小程序端不再调用本函数） */
function openUrl(url: string): void {
	// #ifdef H5
	// @ts-ignore
	window.open(url, '_blank')
	// #endif

	// #ifndef H5
	uni.setClipboardData({
		data: url,
		success: () => {
			uni.showToast({
				title: '客服链接已复制，请在浏览器打开',
				icon: 'none'
			})
		}
	})
	// #endif
}

/**
 * 唤起企业微信客服。
 *
 * <p>小程序必须由用户 TAP 同步调用；H5 是整页跳转、没有 fail 回调，
 * 故 onFail 只在小程序分支生效。</p>
 */
function openWecom(corpId: string, kfidUrl: string, onFail: () => void): void {
	// #ifdef MP-WEIXIN
	// @ts-ignore 仅微信小程序提供该 API
	if (typeof uni.openCustomerServiceChat === 'function') {
		// @ts-ignore
		uni.openCustomerServiceChat({
			corpId: corpId,
			extInfo: {
				url: kfidUrl
			},
			fail: (res: any) => {
				// 企微后台未绑定小程序 / 客服账号停用 / 基础库过低：继续降级
				console.log('打开企业微信客服失败', res)
				onFail()
			}
		})
	} else {
		onFail()
	}
	// #endif

	// #ifdef H5
	// 仅微信内置浏览器会走到这里（canOpenWecom 已判定），直接打开 kfid 进微信客服
	// @ts-ignore
	window.location.href = kfidUrl
	// #endif
}
