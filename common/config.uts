// common/config.ts
export type AuthApiPaths = {
  tenantId: string
  clientId: string
  grantType: string
  appID: string
}

// ApiPaths 只引用已定义的 interface
export type ApiPaths = {
  auth: AuthApiPaths
}

// 其他配置类型
export type ConfigInfo = {
  name: string
  versionCode: number
  versionName: string
  appId?: string
  logo?: string
  desc?: string
  isCN?: boolean
}

export type StorageKeys = {
  token: string
  refreshToken: string
}

export type ProjectConfig = {
  baseUrl: string
  timeout: number
  env: string
  api: ApiPaths
  storage: StorageKeys
  configInfo: ConfigInfo
  loginPagePath?: string
  loginRequiredPaths?: string[]
}

// 环境配置
const ENV = 'prod' //  dev | prod

const API_CONFIG: UTSJSONObject = {
  dev: {
    baseUrl: 'http://127.0.0.1:8081',
    timeout: 30000
  },
  prod: {
    baseUrl: 'https://cmph5.zdiot.cn/prod-api',
    timeout: 30000
  }
}

const currentConfig = API_CONFIG[ENV] as UTSJSONObject

// 导出配置对象
export const config: ProjectConfig = {
  baseUrl: currentConfig['baseUrl'] as string,
  timeout: currentConfig['timeout'] as number,
  env: ENV,


  api: {
    auth: {
      // 打包说明：多个小程序共用同一套代码时，tenantId 一般相同（同一租户），
      // 而 appID 必须改成目标小程序的 appid，并与 manifest.json 的 mp-weixin.appid 保持一致。
      // 服务端按 appID 反查所属租户与 appSecret，填错会导致登录/支付失败。
      tenantId: '000000', // 租户ID
      clientId: '12353d4772a25656d6d2a67d53353cc3',
      grantType: 'xcx',
      appID: 'wxf451813ad3364a12' // 当前小程序 appid
    },
  },

  storage: {
    token: 'access_token',
    refreshToken: 'refresh_token',
  },

  configInfo: {
    name: '中导云卡',
    versionCode: 1,
    versionName: '1.0.0',
    appId: 'your-app-id',
    isCN: true,
  },
  loginPagePath: '',
  loginRequiredPaths: []
}

// 运行时租户号存储键：服务端按 appId 反查到的真实租户。
// 打包常量 tenantId 只是兜底值，多小程序/多租户场景下会与后台实际配置的租户不一致，
// 因此服务端反查结果需要落库并优先使用。
const RUNTIME_TENANT_ID_KEY = 'runtime_tenant_id'

// 获取租户ID：优先用运行时落库的租户号，取不到才回退打包常量
export function getTenantId(): string {
  const runtime = uni.getStorageSync(RUNTIME_TENANT_ID_KEY)
  if (runtime != null && (runtime as string).length > 0) {
    return runtime as string
  }
  return config.api.auth.tenantId
}

// 落库服务端反查到的租户号（页面配置是匿名接口，登录前也能拿到）
export function setTenantId(tenantId: string) {
  if (tenantId == null || tenantId.length == 0) {
    return
  }
  uni.setStorageSync(RUNTIME_TENANT_ID_KEY, tenantId)
}

//获取当前小程序 appid（多小程序识别：登录/拉取配置时上报给服务端）
export function getAppId(): string {
  return config.api.auth.appID
}

// 获取当前登录用户的 token
export function getToken(): string {
  const token = uni.getStorageSync(config.storage.token)
  if (token == null) {
    return ''
  }
  return token as string
}

// 设置当前登录用户的 token
export function setToken(token: string, refreshToken: string = '') {
  uni.setStorageSync(config.storage.token, token)
  if (refreshToken.length > 0) {
    uni.setStorageSync(config.storage.refreshToken, refreshToken)
  }
}

// 清除当前登录用户的 token
export function clearToken() {
  uni.removeStorageSync(config.storage.token)
  uni.removeStorageSync(config.storage.refreshToken)
}

// 微信手机号登录开关（租户页面配置接口下发）
// 约定：'1' = 免手机号（openid 静默登录）；'0' = 需要用户授权手机号
const WX_GET_PHONE_LOGIN_KEY = 'wxGetPhoneLogin'

// 缓存接口下发的手机号登录开关
// 只有明确为 '0' 才记为需要手机号，其余（含缺失、null、异常值）一律归一化为 '1'
export function setWxGetPhoneLogin(value: any) {
  const raw = value == null ? '' : '' + value
  uni.setStorageSync(WX_GET_PHONE_LOGIN_KEY, raw === '0' ? '0' : '1')
}

// 是否需要用户授权手机号
// 兜底策略：配置尚未取到或取值异常时按免手机号处理，避免误跳授权登录页
export function isPhoneLoginRequired(): boolean {
  const value = uni.getStorageSync(WX_GET_PHONE_LOGIN_KEY)
  if (value == null) {
    return false
  }
  return ('' + value) === '0'
}

// 本地存储操作
export function setStorageSync(key: string, value: any) {
  uni.setStorageSync(key, value)
}

// 从存储中获取值
export function getStorageSync(key: string): string {
  return uni.getStorageSync(key) as string
}

// 从存储中移除值
export function removeStorageSync(key: string) {
  uni.removeStorageSync(key)
}

//判断当前平台是否为微信小程序
export function isWechat(): boolean {
  // #ifdef MP-WEIXIN
  return true
  // #endif

  return false
}

//判断当前平台是否为H5
export function isH5(): boolean {
  // #ifdef H5
  return true
  // #endif
  return false
}

//判断当前是国内版
export function isCN(): boolean {
  // #ifdef VERSION_CN
  return true
  // #endif
  return config.configInfo.isCN
}

//判断当前是否为国际版
export function isINT(): boolean {
  // #ifdef VERSION_INT
  return true
  // #endif
  return false
}
