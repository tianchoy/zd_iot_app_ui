<template>
	<!-- #ifndef MP-WEIXIN -->
	<topNavBar title="卡片" :show-back="false" backgroundColor="#f4f7fb" textColor="#333" :showCapsule="false"></topNavBar>
	<!-- #endif -->
	<view class="container">
		<view class="card-box mb-24">
			<view class="card-label">卡片查询</view>
			<view class="search-value mt-24">
				<rice-input
					v-model="card_number"
					placeholder="请输入卡号"
					class="search-input"
					@input="handleInput"
					@focus="handleInputFocus"
				>
				</rice-input>
				<rice-button class="scan-btn" height="100%" icon="scan" @click="scanCode"></rice-button>
				<rice-button type="primary" color="#1989fa" textColor="#ffffff" height="100%" @click="handleQuery">查询</rice-button>
				<!-- 历史卡号候选：点选只填入，不自动查询。
				     刻意不用 scroll-view + 动态 rpx 高度：H5 端 :style 里的 rpx 不参与编译转换会失效，
				     整块高度变 0 就看不见了；这里直接按行铺开，最多展示前 5 条 -->
				<view class="history-panel" v-if="showHistory && visibleHistory.length > 0">
					<view
						v-for="(item, index) in visibleHistory"
						:key="index"
						class="history-item"
						@click="handleHistorySelect(item)"
					>
						<text class="history-text">{{ item }}</text>
					</view>
				</view>
			</view>
		</view>
		<!-- 候选展开时的全屏遮罩：点空白处收起。刻意不用 blur 收起 —— rice-input 的 blur 延迟 100ms 才触发，会抢掉候选点击。
		     必须带上 visibleHistory.length 判断：模糊联想无匹配时不显示遮罩，否则会凭空挡住整页点击 -->
		<view v-if="showHistory && visibleHistory.length > 0" class="history-mask" @click="closeHistory"></view>
		<!-- <rice-button type="primary" color="#1989fa" textColor="#ffffff"  @click="toMyTest">test</rice-button> -->
		<view class="card-box card-list-box">
			<view class="card-tabs">
				<rice-tabs
				  v-model="current"
				  line-color="#ffffff"
				  :list="tabs"
				  :line-width="0"
				  :title-active-color="'#2563eb'"
				  :title-inactive-color="'#334155'"
				  @change="handleClick"
				  :customStyle="{height:'85rpx',padding:'10rpx',border:'1rpx solid #e5edf6'}"
				>
				</rice-tabs>
			</view>
			<view class="card-list">
				<view class="card-item" v-for="(card, index) in cardList" :key="index" @click="handleDetail(card)">
					<view class="item-head">
						<view class="item-head-label">
							<text class="card-item-title" v-if="card.rechargeNo">{{ card.rechargeNo || '-' }}</text>
							<view class="card-item-content">
								<text v-if="card.pkgName">当前套餐：{{ card.pkgName || '-' }}</text>
								<text v-else>当前套餐：无</text>
							</view>
						</view>
						<text class="status-tag" :class="getStatusClass(card.statusStr)" v-if="card.statusStr">{{ card.statusStr || '未知' }}</text>
					</view>
					<view class="item-package" v-if="card.usedFlow || card.pkgFlow">
						<text class="package-label">流量：</text>
						<text class="package-value">{{ getFlowText(card) }}</text>
					</view>
					<rice-divider dashed :customStyle="{margin: '0'}"/>
					<view class="card-metrics">
						<view class="metric-box">
							<view class="metric-label">到期时间</view>
							<view class="metric-value">{{ card.expirationTime || '-' }}</view>
						</view>
						<view class="metric-box mr-24">
							<view class="metric-label">流量使用</view>
							<view class="metric-value">{{ card.usedPeriod || '-' }}</view>
						</view>
					</view>
					<view class="card-bottom" :style="{justifyContent: card.usedPeriod && card.totalPeriod ? 'space-between' : 'flex-end'}">
						<view class="card-cycle-text" v-if="card.usedPeriod && card.totalPeriod">
							<text class="cycle-label">当前周期：</text>
							<text class="cycle-value">{{ card.usedPeriod }} / {{ card.totalPeriod }}</text>
						</view>
						<rice-button type="primary" size="mini" :customStyle="{fontSize:'24rpx'}" @click="handleRecharge(card.rechargeNo)" >去充值</rice-button>
					</view>
				</view>
			</view>
		</view>

		<!-- 空状态 -->
		<view v-if="cardList.length === 0" class="empty-state">
			<text class="empty-text">暂无卡片数据</text>
		</view>
		<tousu v-if="false" @connect_tousu="handleConnectTousu"></tousu>
	</view>
</template>

<script setup lang="ts">
import { ref, computed, onMounted } from 'vue'
import tousu from '@/components/tousu.uvue'
import { queryCardList, login, getTenantInfo, queryVerify } from '@/api/http.uts'
import { getToken, getTenantId, isWechat, setToken, setStorageSync, setWxGetPhoneLogin, isPhoneLoginRequired } from '@/common/config.uts'
import { CardNoHistory } from '@/utils/cardNoHistory.uts'
import type { RechargeData } from '@/api/types.uts'

const card_number = ref('')

// 卡号历史（最新在前）与候选面板显隐
const historyList = ref<string[]>([])
const showHistory = ref(false)

// 候选最多展示条数（历史本身最多 10 条，下拉只列最近 5 条，避免浮层过高）
const MAX_VISIBLE_HISTORY: number = 5
// 模糊联想：按输入内容从历史里挑出匹配项（前缀优先，其次包含），输入为空则不联想
const visibleHistory = computed<string[]>(() => {
	return CardNoHistory.match(historyList.value, card_number.value, MAX_VISIBLE_HISTORY)
})
const queryKeyword = ref('')
const current = ref(0)
const scrollViewHeight = ref(0)

const cardList = ref<RechargeData[]>([])
const cardCounts = ref<number[]>([0, 0, 0])

type TabItem = {
	name: string
}
const toMyTest = () => {
	uni.navigateTo({
		url: '/pages/recharge/recharge?rechargeNo=8986032541200852469'
	})
}
const tabs = computed<TabItem[]>(() => ([
	{name: `全部 ${cardCounts.value[0]}`},
	{name: `在用 ${cardCounts.value[1]}`},
	{name: `异常 ${cardCounts.value[2]}`}
]))

const handleDetail = (card: RechargeData) => {
	uni.navigateTo({
		url: '/pages/cardDetail/cardDetail?cardNumber=' + card.rechargeNo
	})
}

const getStatusClass = (status: string): string => {
	switch (status) {
		case '在用':
			return 'status-completed'
		case '停机':
			return 'status-pending'
		case '可激活':
			return 'status-refunded'
		default:
			return ''
	}
}

const getFlowText = (card: RechargeData): string => {
	const used = card.usedFlow ?? 0
	const total = card.pkgFlow ?? 0
	return `${used} / ${total}`
}

const checkToken = (): boolean => {
	const token = getToken()
	return !!token
}

const scanCode = () => {
	uni.navigateTo({
		url: '/pages/scanCode/scanCode'
	})
}

const handleInput = () => {
	if (card_number.value.trim() === '') {
		queryKeyword.value = ''
		// 输入框被清空：收起候选，且之后不再展开（空框不弹候选）
		showHistory.value = false
		return
	}
	// 有内容时才允许展开候选；首次输入时补一次历史读取
	if (historyList.value.length === 0) {
		historyList.value = CardNoHistory.list()
	}
	if (historyList.value.length > 0) {
		showHistory.value = true
	}
}

// 输入框获得焦点：只在「输入框有内容」且「有历史」时才展开候选
const handleInputFocus = () => {
	const list = CardNoHistory.list()
	historyList.value = list
	const inputLength = card_number.value.trim().length
	showHistory.value = inputLength > 0 && list.length > 0
}

// 点选历史卡号：只填入并收起，不自动查询/跳转（跳转不可逆，保留用户手动点「查询」）
const handleHistorySelect = (cardNo: string) => {
	card_number.value = cardNo
	showHistory.value = false
}

// 收起候选（点遮罩时触发）
const closeHistory = () => {
	showHistory.value = false
}

// 回填最近一次查询过的卡号：仅在输入框为空时填，避免覆盖用户正在输入的内容
const fillLatestCardNo = () => {
	const list = CardNoHistory.list()
	historyList.value = list
	if (card_number.value.trim().length > 0) return
	if (list.length === 0) return
	card_number.value = list[0]
}

// 验证卡片是否有效
const CardVerify = async (id: string): Promise<boolean> => {
	try {
		const res = await queryVerify(id)
		if (res.code == 200) {
			if (res.data) {
				return true
			} else {
				uni.showToast({
					title: '卡号无效',
					icon: 'none'
				})
				return false
			}
		} else {
			uni.showToast({
				title: res.msg || '验证失败',
				icon: 'none'
			})
			return false
		}
	} catch (error) {
		uni.showToast({
			title: error.msg || '卡号无效',
			icon: 'none'
		})
		return false
	}
}

const handleQuery = async () => {
	const keyword = card_number.value.trim()
	if (!keyword) {
		uni.showToast({
			title: '请输入卡号',
			icon: 'none'
		})
		return
	}
	queryKeyword.value = keyword
	const isValid = await CardVerify(keyword)
	if (isValid) {
		// 只在校验通过、即将跳转时写入历史，输错的卡号不会被记住
		CardNoHistory.record(keyword)
		historyList.value = CardNoHistory.list()
		showHistory.value = false
		uni.navigateTo({
			url: '/pages/cardDetail/cardDetail?cardNumber=' + keyword
		})
	}
}

const onScanResult = async (data: UTSJSONObject) => {
	const result = data.getString('result') ?? ''
	if (result.length > 0) {
		card_number.value = result
		showHistory.value = false
		uni.showToast({
			title: '扫码成功',
			icon: 'success'
		})
		await handleQuery()
	}
}


const getCardList = async (state: string): Promise<RechargeData[]> => {
	console.log('查询卡片列表state', state)
	try {
		const res = await queryCardList({
			status: state,
			isSort: true
		})
		console.log('查询卡片列表', res)
		if (res.code == 200) {
			return Array.isArray(res.data) ? res.data : [] as RechargeData[]
		}
		return [] as RechargeData[]
	} catch (error) {
		uni.showToast({
			title: '查询失败，请稍后重试',
			icon: 'none'
		})
		return [] as RechargeData[]
	}
}

// 去充值
const handleRecharge = (rechargeNo: string) => {
	console.log('去充值', rechargeNo)
	uni.navigateTo({
		url: '/pages/recharge/recharge?rechargeNo=' + rechargeNo
	})
}



// 获取 code
const code = ref<string>('')
const getCode = async (): Promise<boolean> => {
	return new Promise((resolve) => {
		uni.login({
			provider: 'weixin',
			success: (res) => {
				code.value = res.code
				login({
					isLogin: "1",
					xcxCode: code.value,
				}).then((loginRes) => {
					if (loginRes.code == 200) {
						setToken(loginRes.data.access_token, loginRes.data.refreshToken)
						resolve(true)
					} else {
						resolve(false)
					}
				}).catch(() => {
					resolve(false)
				})
			},
			fail: (err) => {
				console.error('登录失败:', err)
				resolve(false)
			}
		})
	})
}

// 获取租户页面配置（含手机号登录开关）
const getTenantInfos = async () => {
	try {
		const res = await getTenantInfo(getTenantId(), false)
		if (res.code == 200) {
			// 约定：'1' = 免手机号；'0' = 需要授权手机号
			setWxGetPhoneLogin(res.data.wxGetPhoneLogin)
		}
	} catch (error) {
		// 请求失败时沿用本地缓存，避免被误判为“需要手机号”
		console.error('获取租户配置失败，沿用本地缓存:', error)
	}
}

// 需要手机号模式：先用 openid 换 userId，再跳转手机号授权登录页
const userId = ref<string>('')
const userLoginByOpenid = async (codes: string) => {
	try {
		const res = await login({
			xcxCode: codes,
			isLogin: '1',
		})
		if (res.code == 200) {
			userId.value = '' + res.data.id
			setStorageSync('userId', userId.value)
			uni.navigateTo({
				url: '/pages/login/login?userId=' + userId.value
			})
		}
	} catch (error) {
		console.error('获取用户信息失败:', error)
	}
}

// 加载卡片数据
const loadCardData = async () => {
	const [allList, inUseList, abnormalList] = await Promise.all([
		getCardList('0'),
		getCardList('1'),
		getCardList('2')
	])

	cardCounts.value = [allList.length, inUseList.length, abnormalList.length]
	cardList.value = allList
}

const platform = async () => {
	// 1. 微信环境且无token时，先完成登录
	if (isWechat()) {
		await getTenantInfos()
		// 租户号是接口反查后才落库的（见 api/http.uts 的 setTenantId），
		// 首次启动的 onShow 可能还在用打包常量；这里等租户确定后再补一次回填，
		// 避免存储 key 前缀变化导致历史"看起来丢了"
		fillLatestCardNo()

		// '0' = 需要授权手机号：未登录时跳转登录页授权，本页暂不加载数据
		if (isPhoneLoginRequired() && !checkToken()) {
			cardList.value = []
			cardCounts.value = [0, 0, 0]
			uni.login({
				provider: 'weixin',
				success: (res) => {
					userLoginByOpenid(res.code)
				},
				fail: (err) => {
					console.error('微信登录失败:', err)
				}
			})
			return
		}

		// '1' = 免手机号：openid 静默登录后加载数据
		if (!checkToken()) {
			const loginSuccess = await getCode()

			// 登录失败时，不加载数据
			if (!loginSuccess) {
				console.log('登录失败，跳过数据加载')
				uni.showToast({
					title: '登录失败，请先登录',
					icon: 'none'
				})
				return
			}
		}
		await loadCardData()
	}
}

const handleClick = (e: UTSJSONObject) => {
	if (isWechat()) {
		if (!checkToken()) return;
	}

	console.log('点击了', e.index)

	if (e.index != null) {
		current.value = e.index as number
		getCardList(current.value.toString()).then((list) => {
			console.log('查询卡片列表', list)
			if(list){
				cardList.value = list
				cardCounts.value[current.value] = list.length
			}
		})
	}
}

onLoad(() => {
	platform()
	uni.$on('loadSimList',()=>{
		loadCardData()
	})
	uni.$on('scanResult', onScanResult)
})

onShow(() => {
	// tabBar 首页每次切回都会触发；只在输入框为空时回填最近一次卡号，避免覆盖用户输入
	fillLatestCardNo()
})

onUnload(() => {
	uni.$off('loadSimList')
	uni.$off('scanResult', onScanResult)
})
</script>

<style lang="scss" scoped>
	.container{
		display: flex;
		flex-direction: column;
		background-color: #f4f7fb;
		padding-bottom: 40rpx;
		// uni-app x 给 view 的默认样式是 overflow:hidden，会把溢出父盒子的历史候选浮层整个裁掉
		// （DOM 有、尺寸也对，就是看不见）。这里连同下面的 .card-box / .search-value 一起放开
		overflow: visible;

		// #ifdef MP-WEIXIN || H5
		min-height: 100%;
		// #endif

		// 历史候选展开时的全屏透明遮罩：承载「点浮层外部收起」。
		// z-index 低于候选浮层(200)、高于页面内容，避免依赖 rice-input 延迟 100ms 的 blur 事件
		.history-mask{
			position: fixed;
			top: 0;
			left: 0;
			right: 0;
			bottom: 0;
			z-index: 90;
		}

		.card-box{
			display: flex;
			flex-direction: column;
			margin: 0 24rpx;
			background-color: #ffffff;
			border:1rpx solid #e7edf5;
			border-radius: 24rpx;
			padding: 24rpx;
			// 同上：候选浮层挂在搜索行下方，会溢出本卡片，禁止裁剪
			overflow: visible;

			.card-tabs{
				margin:24rpx;
				margin-bottom: 0;
			}

			.search-value{
				position: relative;
				// z-index 低于候选浮层(200)、高于全屏遮罩(90)：遮罩只负责「点空白收起」，不能盖住输入行
				z-index: 91;
				// 关键：候选浮层用 position:absolute + top:100% 挂在本行盒子之外，
				// 本行若沿用 uni-view 默认的 overflow:hidden，浮层会被整块裁掉（有 DOM 但看不见）
				overflow: visible;

				display: flex;
				flex-direction: row;
				border:1rpx solid #dbe5f0;
				border-radius: 24rpx;

				.search-input{
					flex:1;
					padding: 0 25rpx;
					height: 95rpx;
					border: none;
					background: transparent;
					color: #0f172a;
					font-size: 30rpx;
				}
				.scan-btn{
					border-left: 1px solid #eef2f7;
				}
				// 历史卡号候选浮层：挂在整个搜索行下方，宽度与搜索行对齐
				.history-panel{
					position: absolute;
					left: 0;
					right: 0;
					top: 100%;
					margin-top: 8rpx;
					z-index: 200;
					background-color: #ffffff;
					border: 1rpx solid #dbe5f0;
					border-radius: 16rpx;
					box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.12);
					overflow: hidden;

					.history-item{
						display: flex;
						flex-direction: row;
						align-items: center;
						height: 96rpx;
						padding: 0 28rpx;
						box-sizing: border-box;
						border-bottom: 1rpx solid #f1f5f9;

						&:active{
							background-color: #f5f7fa;
						}

						&:last-child{
							border-bottom: none;
						}

						.history-text{
							flex: 1;
							font-size: 28rpx;
							color: #334155;
							line-height: 1.4;
						}
					}
				}
			}

			.card-item{
				display: flex;
				flex-direction: column;
				border-bottom: 1px solid #e7edf5;
				padding: 24rpx 24rpx 30rpx 24rpx;
				margin-bottom: 30rpx;

				.item-head{
					display: flex;
					flex-direction: row;
					align-items: flex-start;
					justify-content: space-between;
					margin-bottom: 18rpx;

					.card-item-title{
						font-size: 32rpx;
						font-weight: 800;
						color: #0f172a;
						line-height: 1.25;
					}
					.card-item-content{
						margin-top: 15rpx;
						font-size: 24rpx;
						color: #94a3b8;
						line-height: 1.45;
					}

					.status-tag {
						font-size: 24rpx;
						padding: 6rpx 16rpx;
						border-radius: 20rpx;
					}
					.status-completed {
						background: #e6ffee;
						color: #07c160;
						border: 1rpx solid #07c160;
					}

					.status-pending {
						background: #fff2f0;
						color: #f56c6c;
						border: 1rpx solid #f56c6c;
					}
					.status-refunded{
						color:#e6a23c;
						background-color: #fffbe8;
						border: 1rpx solid #e6a23c;
					}
				}
				.item-package{
					margin: 20rpx 0;
					display: flex;
					flex-direction: row;
					align-items: center;
					min-width: 0;

					.package-label{
						font-size: 12px;
						color: #64748b;
						line-height: 1.4;
					}
					.package-value{
						flex: 1;
						font-size: 25rpx;
						font-weight: 700;
						color: #334155;
						line-height: 1.45;
						white-space: nowrap;
						overflow: hidden;
						text-overflow: ellipsis;
					}
				}
				.card-metrics{
					display: flex;
					flex-direction: row;
					flex-wrap: wrap;
					margin: 20rpx 0;
					gap: 24rpx;

					.metric-box{
						flex:1;
						box-sizing: border-box;
						background: #f8fbff;
						border: 1rpx solid #e8eef7;
						border-radius: 25rpx;
						padding: 20rpx 20rpx 10rpx;
						min-width: 0;

						.metric-label{
							font-size: 25rpx;
							color: #94a3b8;
							line-height: 1.4;
						}
						.metric-value{
							margin-top: 15rpx;
							font-size: 25rpx;
							font-weight: 800;
							color: #0f172a;
