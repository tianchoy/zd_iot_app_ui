<template>
	<!-- #ifndef MP-WEIXIN -->
	<topNavBar title="支付结果" :show-back="false" backgroundColor="#f4f7fb" textColor="#333" :showCapsule="false"></topNavBar>
	<!-- #endif -->
	<view class="container">
		<!-- 状态区域：以订单查询结果为准，避免接口失败时误报成功 -->
		<view class="status-section">
			<view class="success-icon" v-if="isConfirmed">
				<text class="checkmark">✓</text>
			</view>
			<text class="status-text">{{ statusText }}</text>
		</view>

		<!-- 卡片详情区域 -->
		<view class="card-container">
			<!-- 卡号 -->
			<view class="info-row" v-if="d('rechargeNo')">
				<text class="label">卡号</text>
				<text class="value">{{ d('rechargeNo') }}</text>
			</view>

			<!-- ICCID -->
			<view class="info-row" v-if="d('iccid')">
				<text class="label">ICCID</text>
				<text class="value">{{ d('iccid') }}</text>
			</view>

			<!-- 订单编号 -->
			<view class="info-row" v-if="d('orderNo')">
				<text class="label">订单编号</text>
				<text class="value">{{ d('orderNo') }}</text>
			</view>

			<!-- 套餐名称 -->
			<view class="info-row" v-if="d('pkgName')">
				<text class="label">套餐名称</text>
				<text class="value">{{ d('pkgName') }}</text>
			</view>

			<!-- 套餐类型 -->
			<view class="info-row" v-if="d('pkgCategory')">
				<text class="label">套餐分类</text>
				<text class="value">{{ d('pkgCategory') }}</text>
			</view>

			<!-- 支付方式 -->
			<view class="info-row" v-if="ds('payType') != ''">
				<text class="label">支付方式</text>
				<text class="value">{{ d('payType') }}</text>
			</view>

			<!-- 支付金额 (突出显示) -->
			<view class="info-row" v-if="d('payAmount')">
				<text class="label">支付金额</text>
				<text class="value amount">￥{{ d('payAmount') }}</text>
			</view>

			<view class="info-row" v-if="d('payTime')">
				<text class="label">支付时间</text>
				<text class="value">{{ d('payTime') }}</text>
			</view>
		</view>

		<!-- 按钮区域 -->
		<view class="button-section">
			<button v-if="!isConfirmed" class="action-btn primary-btn mb-24" @click="getOrderDetail">重新查询支付结果</button>
			<button class="action-btn primary-btn mb-24" @click="handleViewOrder">查看订单</button>
			<button class="action-btn secondary-btn" @click="handleBackCard">返回卡片详情</button>
		</view>
	</view>
</template>

<script setup lang="uts">
	import {queryOrderSuccess} from '@/api/http'
	import { isWechat,isH5 } from '@/common/config.uts'

	const orderId = ref<string>('')
	const payChannelId = ref<string>('')
	const orderDetail = ref<any>({})
	// 支付结果确认状态：confirming 确认中 / success 已确认 / failed 确认失败
	const status = ref<string>('confirming')
	const isConfirmed = computed<boolean>(() => status.value === 'success')
	const statusText = computed<string>(() => {
		if (status.value === 'success') {
			return '支付成功'
		}
		if (status.value === 'confirming') {
			return '支付结果确认中...'
		}
		return '支付结果待确认'
	})

	/** 模板中安全访问 orderDetail 属性 */
	function d(key: string): any {
		const val = (orderDetail.value as UTSJSONObject)[key]
		return val as any
	}

	/** 获取 string 类型的属性值 */
	function ds(key: string): string {
		const val = (orderDetail.value as UTSJSONObject)[key]
		return val != null ? (val as string) : ''
	}

	// 查看订单点击处理
	const handleViewOrder = () => {
		if (!orderId.value) {
			uni.showToast({
				title: '订单号缺失，请到订单列表查看',
				icon: 'none'
			})
			return
		}
		uni.redirectTo({
			url: `/pages/orderDetail/orderDetail?orderNo=${orderId.value}&from=paySuccess`
		})

	}

	// 返回卡片详情点击处理
	const handleBackCard = () => {
		const rechargeNo = ds('rechargeNo')
		if (rechargeNo === '') {
			uni.showToast({
				title: '卡号信息缺失，请到订单列表查看',
				icon: 'none'
			})
			return
		}
		uni.reLaunch({
			url: `/pages/cardDetail/cardDetail?cardNumber=${rechargeNo}`
		})
	}

	// 查询订单，用返回结果确认支付状态；失败时不再直接展示"支付成功"
	const getOrderDetail = async () => {
		if (!orderId.value || !payChannelId.value) {
			status.value = 'failed'
			uni.showToast({
				title: '订单参数缺失，请到订单列表查看',
				icon: 'none'
			})
			return
		}
		status.value = 'confirming'
		try {
			const res = await queryOrderSuccess(orderId.value,payChannelId.value)
			if(res.code == 200 && res.data != null){
				console.log('订单详情:',res)
				orderDetail.value = res.data
				status.value = 'success'
				return
			}
			status.value = 'failed'
			uni.showToast({
				title: res.msg || '支付结果确认失败，请稍后重试',
				icon: 'none'
			})
		} catch (error) {
			console.error('查询支付结果失败:', error)
			status.value = 'failed'
			uni.showToast({
				title: '支付结果确认失败，请稍后重试',
				icon: 'none'
			})
		}
	}

	onLoad((options: UTSJSONObject) => {
		console.log('orderId:',options)
		const oid = options['orderId'] as string
		orderId.value = oid != null ? oid : ''
		const pid = options['payChannelId'] as string
		payChannelId.value = pid != null ? pid : ''
		getOrderDetail()
	})
</script>

<style lang="scss" scoped>
	.container {
		background-color: #f4f7fb;
		padding: 40rpx 32rpx;
		display: flex;
		flex-direction: column;
		box-sizing: border-box;
		// #ifdef MP-WEIXIN || H5
		min-height: 100%;
		// #endif
	}

	// 成功状态区域
	.status-section {
		display: flex;
		flex-direction: column;
		align-items: center;
		margin-bottom: 40rpx;

		.success-icon {
			width: 120rpx;
			height: 120rpx;
			background-color: #07c160;
			border-radius: 50%;
			display: flex;
			flex-direction: row;
			align-items: center;
			justify-content: center;
			margin-bottom: 20rpx;

			.checkmark {
				color: #ffffff;
				font-size: 80rpx;
				font-weight: 600;
				line-height: 1;
			}
		}

		.status-text {
			font-size: 40rpx;
			font-weight: 500;
			color: #333333;
		}
	}

	// 卡片容器
	.card-container {
		background-color: #ffffff;
		border: 1px solid #e7edf5;
		border-radius: 24rpx;
		padding: 32rpx;
		margin-bottom: 60rpx;
		box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
	}

	// 信息行
	.info-row {
		display: flex;
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		padding: 24rpx 0;
		border-bottom: 1rpx solid #f0f0f0;


		.label {
			font-size: 24rpx;
			color: #64748b;
			flex-shrink: 0;
			width: 160rpx;
		}

		.value {
			font-size: 25rpx;
			color: #0f172a;
			font-weight: bold;
			text-align: right;
			flex: 1;
		}

		.amount {
			font-weight: bold;
			color: #ff6b00;
		}
	}

	// 按钮区域
	.button-section {
		display: flex;
		flex-direction: column;

		.action-btn {
			width: 100%;
			height: 88rpx;
			line-height: 88rpx;
			border-radius: 44rpx;
			font-size: 30rpx;
			font-weight: 500;
			text-align: center;
			border: none;
			padding: 0;

			&::after {
				border: none;
			}
		}

		.primary-btn {
			background-color: #2563eb;
			color: #ffffff;
		}

		.secondary-btn {
			background-color: #ffffff;
			color: #2563eb;
			border: 2rpx solid #2563eb;
		}
	}
</style>
