<template>
	<!-- #ifndef MP-WEIXIN -->
	<topNavBar :title="$t('pay')" :show-back="true" @back="backPath" backgroundColor="#f4f7fb" textColor="#333" :showCapsule="false"></topNavBar>
	<!-- #endif -->
	<view class="container">
		<view class="order-card">
			<text class="title">{{ $t('orderInfo') }}</text>
			<view class="row" v-if="orderDetail?.pkgName">
				<text class="label">{{ $t('pkgName') }}</text>
				<text class="value">{{ orderDetail?.pkgName }}</text>
			</view>
			<view class="row" v-if="orderDetail?.validityPeriod">
				<text class="label">{{ $t('validityPeriod') }}</text>
				<text class="value">{{ orderDetail?.validityPeriod }} {{ orderDetail?.pkgType == 1 ? $t('day') : $t('month') }}</text>
			</view>
			<view class="row" v-if="orderDetail?.orderNo">
				<text class="label">{{ $t('orderNo') }}</text>
				<text class="value">{{ orderDetail?.orderNo }}</text>
			</view>
			<view class="row" v-if="orderDetail?.availableRegions">
				<text class="label">{{ $t('availableRegions') }}</text>
				<text class="value">{{ orderDetail?.availableRegions }}</text>
			</view>
			<view class="amount" v-if="orderDetail?.payCurrencyAmount">
				<text>{{ orderDetail?.signPosition == '0' ? orderDetail?.symbol : '' }} {{ orderDetail?.payCurrencyAmount }} {{ orderDetail?.signPosition == '1' ? orderDetail?.symbol : '' }}</text>
			</view>
		</view>

		<text class="section">{{ $t('paymentMethod') }}</text>
		<view class="method-card">
			<view
				v-for="(item, index) in options"
				:key="item.value"
				class="method"
				:class="{ selected: selected == item.value }"
				@click="selectMethod(item.value)"
			>
				<view class="method-left">
					<!-- 私有桶签名地址过期时重建图片并回源换地址；同秒重签 URL 可能相同，必须靠 key -->
					<image v-if="item.logoUrl" :key="'pay-logo-' + String(index) + '-' + String(logoRetryKey)"
						:src="item.logoUrl" mode="aspectFit" class="logo" @error="onLogoError"></image>
					<view class="method-text">
						<text class="mlabel">{{ item.label }}</text>
						<text v-if="item.desc" class="mdesc">{{ item.desc }}</text>
					</view>
				</view>
				<view class="radio" :class="{ on: selected == item.value }"></view>
			</view>
			<view v-if="options.length == 0" class="empty">
				<text>{{ $t('pleaseSelectPayment') }}</text>
			</view>
		</view>
	</view>
	<view class="bottom-bar">
		<rice-button type="primary" width="100%" height="96rpx" @click="handlePay">{{ $t('confirmPay') }}</rice-button>
	</view>
</template>

<script setup lang="uts">
	import { ref, onLoad } from 'vue'
	import { queryOrderIntl, goPayIntl } from '@/api/http.uts'
	import i18n from '@/i18n'

	const t = (key: string): string => i18n.global.t(key) as string

	const orderId = ref<string>('')
	const msisdn = ref<string>('')
	const countryCode = ref<string>('')
	const pkgName = ref<string>('')
	const orderDetail = ref<any>(null)
	const options = ref<Array<any>>([])
	const selected = ref<string>('')
	// 图片加载失败重试：递增 key 强制重建 <image>，防抖避免多张图同时 403 打 N 次接口
	const logoRetryKey = ref(0)
	let logoRefreshing = false
	// 自动重拉上限：OSS 持续不可用或同秒重签 URL 相同时，避免无限打接口
	let logoRetryCount = 0

	onLoad((opt: UTSJSONObject) => {
		const options = opt as any
		orderId.value = options.orderId || ''
		msisdn.value = options.msisdn || ''
		countryCode.value = options.countryCode || ''
		pkgName.value = options.pkgName || ''
		getOrderDetail(orderId.value)
	})

	const backPath = () => {
		if (!msisdn.value || !countryCode.value) {
			uni.navigateBack()
		} else {
			uni.reLaunch({
				url: '/pages/recharge/recharge?rechargeNo=' + msisdn.value + '&country=' + countryCode.value + '&from=h5Search'
			})
		}
	}

	const getOrderDetail = async (id: string) => {
		try {
			uni.showLoading({ title: t('loading') })
			const res = await queryOrderIntl(id)
			uni.hideLoading()
			if (res.code == 200 && res.data != null) {
				orderDetail.value = res.data
				const payTypeVos = res.data.payTypeVos || []
				options.value = payTypeVos.map((item: any) => ({
					label: item.payTypeName,
					value: item.payTypeId,
					logoUrl: item.logoUrl,
					desc: item.payTypeDescribe
				}))
				if (options.value.length > 0) {
					selected.value = options.value[0].value
				}
			} else {
				uni.showToast({ title: res.msg || t('dataLoadFailed'), icon: 'none' })
			}
		} catch (error) {
			uni.hideLoading()
			uni.showToast({ title: t('dataLoadFailed'), icon: 'none' })
		}
		}

		/**
		* 只刷新支付方式图标地址：不重建 selected，避免用户已选渠道被悄悄改回第一项。
		* 后端每次下发都会重新签发 7 天私有链接。
		*/
		const refreshPayTypeLogos = async () => {
		if (logoRefreshing) return
		logoRefreshing = true
		try {
			const res = await queryOrderIntl(orderId.value)
			if (res.code != 200 || res.data == null) return
			const payTypeVos = res.data.payTypeVos || []
			const urlById = new Map<string, string>()
			payTypeVos.forEach((item: any) => {
				// 显式转 String：UTS 编译到 App 时 any 直接写入 Map<string,string> 可能类型不匹配
				urlById.set(String(item.payTypeId), String(item.logoUrl ?? ''))
			})
			options.value = options.value.map((item: any) => {
				const fresh = urlById.get(String(item.value)) ?? ''
				return {
					label: item.label,
					value: item.value,
					desc: item.desc,
					// 后端偶发返回空值时保留原图标，否则 v-if 会让图片消失且不再触发 @error
					logoUrl: fresh.length > 0 ? fresh : item.logoUrl
				}
			})
		} catch (error) {
			console.error('刷新支付方式图标失败:', error)
		} finally {
			logoRefreshing = false
		}
		}

		const onLogoError = () => {
		// 上限后不再递增 key，避免「重建→失败→再重建」的无限循环
		if (logoRefreshing || logoRetryCount >= 3) return
		// 同一秒重签可能返回完全相同的 URL，不递增 key 微信会复用失败缓存
		logoRetryKey.value++
		logoRetryCount++
		void refreshPayTypeLogos()
		}

		const selectMethod = (value: string) => {
		selected.value = value
	}

	const handlePay = async () => {
		if (!selected.value) {
			uni.showToast({ title: t('pleaseSelectPayment'), icon: 'none' })
			return
		}
		uni.showLoading({ title: t('paying') })
		const data = {
			orderId: orderId.value,
			payChannelId: selected.value,
			payTypeCategory: ''
		}
		try {
			const res = await goPayIntl(data)
			if (res.code != 200) {
				uni.hideLoading()
				uni.showToast({ title: res.msg || t('payFailedDesc'), icon: 'none' })
				return
			}
			const result = res.data as any
			const approval_url = result?.approval_url
			const clientKey = result?.clientKey
			const clientSecret = result?.clientSecret
			if (approval_url) {
				// PayerMax：跳转第三方收银台（仅 H5 浏览器）
				// #ifdef H5
				window.location.href = approval_url
				// #endif
				// #ifndef H5
				uni.hideLoading()
				uni.showToast({ title: t('payLinkFailed'), icon: 'none' })
				// #endif
			} else if (clientKey && clientSecret) {
				// Stripe：拉起 Stripe Elements 收银台
				uni.hideLoading()
				uni.navigateTo({
					url: '/pages/payStripe/payStripe?clientKey=' + encodeURIComponent(clientKey)
						+ '&clientSecret=' + encodeURIComponent(clientSecret)
						+ '&pkgName=' + encodeURIComponent(pkgName.value)
						+ '&orderId=' + encodeURIComponent(orderId.value)
						+ '&msisdn=' + encodeURIComponent(msisdn.value)
						+ '&countryCode=' + encodeURIComponent(countryCode.value)
				})
			} else {
				uni.hideLoading()
				uni.showToast({ title: t('payLinkFailed'), icon: 'none' })
			}
		} catch (error) {
			uni.hideLoading()
			uni.showToast({ title: t('payFailedDesc'), icon: 'none' })
		}
	}
</script>

<style lang="scss" scoped>
	.container {
		display: flex;
		flex-direction: column;
		background-color: #f4f7fb;
		flex: 1;
		padding: 24rpx;
	}
	.order-card {
		background: #ffffff;
		border: 1rpx solid #e5edf6;
		border-radius: 20rpx;
		padding: 28rpx;
		margin-bottom: 24rpx;
		.title {
			font-size: 32rpx;
			font-weight: bold;
			color: #1e293b;
			display: block;
			margin-bottom: 20rpx;
		}
		.row {
			display: flex;
			flex-direction: row;
			justify-content: space-between;
			padding: 16rpx 0;
			.label {
				font-size: 26rpx;
				color: #64748b;
			}
			.value {
				font-size: 26rpx;
				color: #334155;
				font-weight: 500;
				max-width: 60%;
				text-align: right;
			}
		}
		.amount {
			margin-top: 16rpx;
			text-align: center;
			font-size: 44rpx;
			font-weight: 800;
			color: #ef4444;
		}
	}
	.section {
		font-size: 28rpx;
		font-weight: bold;
		color: #334155;
		margin: 12rpx 8rpx 20rpx;
	}
	.method-card {
		background: #ffffff;
		border: 1rpx solid #e5edf6;
		border-radius: 20rpx;
		padding: 8rpx 24rpx;
		.method {
			display: flex;
			flex-direction: row;
			align-items: center;
			justify-content: space-between;
			padding: 28rpx 0;
			border-bottom: 1rpx solid #f1f5f9;
			&:last-child {
				border-bottom: none;
			}
			&.selected {
				.radio.on {
					border-color: #2563eb;
					background-color: #2563eb;
				}
			}
			.method-left {
				display: flex;
				flex-direction: row;
				align-items: center;
				flex: 1;
				.logo {
					width: 56rpx;
					height: 56rpx;
					margin-right: 20rpx;
				}
				.method-text {
					display: flex;
					flex-direction: column;
					.mlabel {
						font-size: 28rpx;
						color: #1e293b;
						font-weight: 500;
					}
					.mdesc {
						font-size: 22rpx;
						color: #94a3b8;
						margin-top: 6rpx;
					}
				}
			}
			.radio {
				width: 32rpx;
				height: 32rpx;
				border-radius: 50%;
				border: 2rpx solid #cbd5e1;
				background-color: #fff;
				box-sizing: border-box;
			}
		}
		.empty {
			padding: 40rpx 0;
			text-align: center;
			color: #94a3b8;
			font-size: 26rpx;
		}
	}
	.bottom-bar {
		padding: 20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
		background: #ffffff;
		box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
	}
</style>
