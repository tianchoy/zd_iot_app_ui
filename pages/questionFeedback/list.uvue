	display: flex;
	flex-direction: column;
	min-height: 100%;
	background-color: #f4f7fb;
	padding-bottom: 120rpx;
}

.feedback-list {
	padding: 24rpx;
}

.feedback-item {
	background-color: #ffffff;
	border-radius: 24rpx;
	padding: 24rpx;
	margin-bottom: 24rpx;
	border: 1rpx solid #e7edf5;

	.item-header {
		display: flex;
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 16rpx;

		.feedback-no {
			font-size: 26rpx;
			color: #334155;
			font-weight: bold;
		}
	}

	.item-content {
		font-size: 28rpx;
		color: #0f172a;
		line-height: 1.6;
		margin-bottom: 16rpx;
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		overflow: hidden;
	}

	.item-footer {
		display: flex;
		flex-direction: row;
		justify-content: space-between;
		align-items: center;

		.time {
			font-size: 22rpx;
			color: #94a3b8;
		}

		.type {
			font-size: 22rpx;
			color: #64748b;
		}
	}
}

.empty-state {
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	padding: 120rpx 32rpx;

	.empty-text {
		font-size: 28rpx;
		color: #9ca3af;
	}
}

.submit-btn-container {
	position: fixed;
	bottom: 0;
	left: 0;
	right: 0;
	padding: 24rpx;
	background-color: #ffffff;
	border-top: 1rpx solid #e7edf5;
}

.popup-container {
	display: flex;
	flex-direction: column;
	height: 100%;
}

.popup-header {
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	align-items: center;
	padding: 24rpx;
	border-bottom: 1rpx solid #e7edf5;

	.popup-title {
		font-size: 32rpx;
		font-weight: bold;
		color: #0f172a;
	}

	.popup-close {
		font-size: 28rpx;
		color: #64748b;
	}
}

.popup-content {
	flex: 1;
	overflow-y: auto;
	padding: 24rpx;

	.form-item {
		margin-bottom: 32rpx;

		.form-label {
			display: block;
			font-size: 28rpx;
			color: #334155;
			margin-bottom: 16rpx;
		}

		.content-input {
			width: 100%;
			height: 200rpx;
			padding: 20rpx;
			font-size: 28rpx;
			background-color: #f8fafc;
			border-radius: 16rpx;
			border: 1rpx solid #e2e8f0;
		}

		.phone-input {
			width: 100%;
			height: 80rpx;
			padding: 0 20rpx;
			font-size: 28rpx;
			background-color: #f8fafc;
			border-radius: 16rpx;
			border: 1rpx solid #e2e8f0;
		}

		.image-upload {
			display: flex;
			flex-direction: row;
			flex-wrap: wrap;
			gap: 16rpx;

			.image-item {
				position: relative;
				width: 160rpx;
				height: 160rpx;

				.preview-image {
					width: 100%;
					height: 100%;
					border-radius: 12rpx;
				}

				.delete-btn {
					position: absolute;
					top: -12rpx;
					right: -12rpx;
					width: 36rpx;
					height: 36rpx;
					background-color: #ef4444;
					color: #ffffff;
					border-radius: 50%;
					display: flex;
					align-items: center;
					justify-content: center;
					font-size: 24rpx;
				}
			}

			.upload-btn {
				width: 160rpx;
				height: 160rpx;
				background-color: #f8fafc;
				border: 2rpx dashed #cbd5e1;
				border-radius: 12rpx;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;

				.plus {
					font-size: 48rpx;
					color: #94a3b8;
				}

				.text {
					font-size: 22rpx;
					color: #94a3b8;
					margin-top: 8rpx;
				}
			}
		}
	}
}

.popup-footer {
	padding: 24rpx;
	border-top: 1rpx solid #e7edf5;
}
</style>
