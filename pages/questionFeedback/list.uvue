<template>
	<!-- #ifndef MP-WEIXIN -->
	<topNavBar title="我的反馈" :show-back="true" @back="goBack" backgroundColor="#f4f7fb" textColor="#333" :showCapsule="false"></topNavBar>
	<!-- #endif -->
	<view class="page-container">
		<!-- 卡号筛选入口：默认展示「我提交的反馈」，输入卡号可查该卡的历史反馈（老数据没有提交人归属） -->
		<view class="card-box">
			<view class="search-value">
				<rice-input
					v-model="inputCardNo"
					placeholder="按卡号筛选（留空看我的反馈）"
					class="search-input"
				></rice-input>
				<rice-button type="primary" color="#1989fa" textColor="#ffffff" height="100%" @click="handleQuery">查询</rice-button>
				<rice-button type="default" textColor="#606266" height="100%" @click="handleReset">全部</rice-button>
			</view>
			<view class="search-tip" v-if="filterCardNo.length > 0">当前筛选卡号：{{ filterCardNo }}</view>
		</view>

		<!-- 反馈列表 -->
		<view class="feedback-list" v-if="feedbackList.length > 0">
			<view class="feedback-item" v-for="(item, index) in feedbackList" :key="index" @click="handleDetail(item)">
				<view class="item-header">
					<text class="feedback-no">{{ item.feedbackNo }}</text>
				</view>
				<view class="item-content">{{ item.feedbackContent || '-' }}</view>
				<view v-if="item.replyContent" class="latest-reply">
					<text class="latest-reply-label">最新回复</text>
					<text class="latest-reply-content">{{ item.replyContent }}</text>
				</view>
				<view class="order-no">接入号：{{ item.msisdn || '-' }}</view>
				<view class="order-no">订单编号：{{ item.orderNo || '-' }}</view>
				<view class="item-footer">
					<text class="time">{{ item.createTime }}</text>
					<rice-tag :type="getStatusType(item.status)" :text="getStatusText(item.status)" size="small" plain-fill></rice-tag>
				</view>
			</view>
		</view>

		<!-- 空状态 -->
		<view class="empty-state" v-else-if="!loading">
			<text class="empty-text">{{ emptyText }}</text>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref, computed } from 'vue'
	import { getFeedbackList } from '@/api/http.uts'

	// H5 下页面参数（query）会被当作组件 attrs 透传，而本页根节点是
	// 「条件编译的 topNavBar + 容器」这种多根结构，Vue 无法自动继承 → 控制台刷警告。
	// 这里显式关闭属性继承消除该警告；页面参数仍由 onLoad(options) 读取，行为不变。
	defineOptions({
		inheritAttrs: false
	})

	type FeedbackItem = {
		id: number,
		feedbackNo: string,
		feedbackType: string,
		feedbackContent: string,
		status: string,
		createTime: string,
		userPhone: string,
		imgOssUrl: string,
		msisdn: string,
		orderNo: string,
		packageName: string,
		replyContent: string,
		rechargeNo: string
	}

	const loading = ref(true)
	const feedbackList = ref<FeedbackItem[]>([])
	const inputCardNo = ref('')
	// 当前生效的卡号筛选值：空串表示「我提交的反馈」（后端按登录态取 create_by）
	const filterCardNo = ref('')

	const emptyText = computed<string>(() => filterCardNo.value.length > 0
		? '未查询到该卡号的反馈，请确认卡号是否正确'
		: '暂无反馈记录')

	// 获取状态标签类型
	const getStatusType = (status: string): string => {
		const typeMap = new Map<string, string>()
		typeMap.set('0', 'warning')
		typeMap.set('1', 'primary')
		typeMap.set('2', 'success')
		typeMap.set('3', 'default')
		return typeMap.get(status) ?? 'default'
	}

	// 获取状态文字
	const getStatusText = (status: string): string => {
		const textMap = new Map<string, string>()
		textMap.set('0', '待处理')
		textMap.set('1', '处理中')
		textMap.set('2', '已回复')
		textMap.set('3', '已关闭')
		return textMap.get(status) ?? status
	}

	// 查询反馈列表：filterCardNo 为空时后端按当前登录用户返回「我提交的反馈」
	const loadFeedbackList = async () => {
		loading.value = true
		try {
			const res = await getFeedbackList(filterCardNo.value)
			if (res.code == 200) {
				const rows = res.data as FeedbackItem[]
				// 不用 Array.isArray：uni-app x 各端对 JSON 数组的运行时表示不一致，用长度判定更稳
				feedbackList.value = rows != null && rows.length >= 0 ? rows : []
			} else {
				uni.showToast({ title: res.msg ?? '查询失败', icon: 'none' })
			}
		} catch (error) {
			console.error('查询反馈列表异常:', error)
		} finally {
			loading.value = false
		}
	}

	// 按卡号筛选（查历史反馈）
	const handleQuery = async () => {
		const cardNo = inputCardNo.value.trim()
		if (cardNo.length === 0) {
			uni.showToast({ title: '请输入卡号', icon: 'none' })
			return
		}
		filterCardNo.value = cardNo
		await loadFeedbackList()
	}

	// 清除筛选，回到「我的反馈」
	const handleReset = async () => {
		inputCardNo.value = ''
		filterCardNo.value = ''
		await loadFeedbackList()
	}

	// 查看详情：归属凭据用该条反馈自身的充值号，而不是筛选值
	const handleDetail = (item: FeedbackItem) => {
		uni.navigateTo({
			url: `/pages/questionFeedback/detail?feedbackId=${item.id}&rechargeNo=${encodeURIComponent(item.rechargeNo ?? '')}`
		})
	}

	const goBack = () => {
		uni.navigateBack({ delta: 1 })
	}

	onLoad(() => {
		loadFeedbackList()
	})
</script>

<style lang="scss" scoped>
.page-container {
	display: flex;
	flex-direction: column;
	// #ifdef MP-WEIXIN || H5
	min-height: 100%;
	// #endif
	background-color: #f5f7fa;
	padding-bottom: 48rpx;

	.card-box {
		display: flex;
		flex-direction: column;
		margin: 20rpx 20rpx 0 20rpx;
		background-color: #ffffff;
		border: 1rpx solid #e7edf5;
		border-radius: 24rpx;
		padding: 24rpx;

		.search-value {
			display: flex;
			flex-direction: row;
			border: 1rpx solid #dbe5f0;
			border-radius: 24rpx;

			.search-input {
				flex: 1;
				padding: 0 25rpx;
				height: 95rpx;
				border: none;
				background: transparent;
				color: #0f172a;
				font-size: 30rpx;
			}
		}

		.search-tip {
			margin-top: 16rpx;
			font-size: 24rpx;
			color: #909399;
		}
	}
}

.feedback-list {
	padding: 20rpx;
}

.feedback-item {
	margin-bottom: 20rpx;
	padding: 28rpx;
	border: 0;
	border-radius: 20rpx;
	background-color: #ffffff;

	.item-header {
		display: flex;
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 16rpx;

		.feedback-no {
			font-size: 26rpx;
			color: #303133;
			font-weight: 600;
		}
	}

	.item-content {
		font-size: 28rpx;
		color: #303133;
		line-height: 1.6;
		margin-bottom: 16rpx;
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		overflow: hidden;
	}

	.latest-reply {
		display: flex;
		flex-direction: column;
		gap: 8rpx;
		margin: 20rpx 0;
		padding: 16rpx;
		border-radius: 16rpx;
		background-color: #f4f4f4;

		.latest-reply-label {
			font-size: 24rpx;
			color: #909399;
		}

		.latest-reply-content {
			display: -webkit-box;
			overflow: hidden;
			color: #606266;
			font-size: 26rpx;
			line-height: 1.5;
			-webkit-box-orient: vertical;
			-webkit-line-clamp: 2;
		}
	}

	.order-no {
		margin-bottom: 20rpx;
		font-size: 26rpx;
		color: #606266;
	}

	.item-footer {
		display: flex;
		flex-direction: row;
		justify-content: space-between;
		align-items: center;

		.time {
			font-size: 22rpx;
			color: #909399;
		}
	}
}

.empty-state {
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	padding: 120rpx 32rpx;

	.empty-text {
		font-size: 28rpx;
		color: #9ca3af;
	}
}

.loading-box {
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	padding: 60px 0;
	color: #909399;
	font-size: 16px;
	gap: 12px;
}

.loading-box .el-icon {
	font-size: 28px;
}
</style>
