<template>
	<topNavBar title="反馈详情" :show-back="true" @back="goBack" backgroundColor="#f4f7fb" textColor="#333" :showCapsule="false"></topNavBar>
	<view class="page-container">
		<!-- 反馈基本信息 -->
		<view class="info-card">
			<view class="info-header">
				<text class="feedback-no">{{ feedbackData.feedbackNo }}</text>
				<rice-tag :type="getStatusType(feedbackData.status)" :text="getStatusText(feedbackData.status)" size="small" plain-fill></rice-tag>
			</view>
			<view class="info-row">
				<text class="label">反馈类型：</text>
				<text class="value">{{ getFeedbackTypeText(feedbackData.feedbackType) }}</text>
			</view>
			<view class="info-row">
				<text class="label">提交时间：</text>
				<text class="value">{{ feedbackData.subTime }}</text>
			</view>
			<view class="info-row" v-if="feedbackData.userPhone">
				<text class="label">联系电话：</text>
				<text class="value">{{ feedbackData.userPhone }}</text>
			</view>
		</view>

		<!-- 沟通记录 -->
		<view class="message-section">
			<view class="section-title">沟通记录</view>
			<view class="message-list">
				<view class="message-item" v-for="(item, index) in feedbackData.feedbackContentList" :key="index">
					<view class="message-header">
						<rice-tag :type="item.sendType === '0' ? 'primary' : 'success'" :text="item.sendType === '0' ? '用户' : '平台'" size="small"></rice-tag>
						<text class="message-time">{{ item.time }}</text>
					</view>
					<view class="message-content">{{ item.replyContent }}</view>
					<view class="message-images" v-if="item.imgOssUrl && item.imgOssUrl.length > 0">
						<image class="msg-image" v-for="(img, imgIndex) in item.imgOssUrl.split(',')" :key="imgIndex" :src="img" mode="aspectFill" @click="previewImage(img, item.imgOssUrl)"></image>
					</view>
				</view>
			</view>
		</view>

		<!-- 底部操作区 -->
		<view class="bottom-action" v-if="feedbackData.status !== '3'">
			<rice-button type="primary" text="继续反馈" :customStyle="{ borderRadius: '40rpx', flex: 1, marginRight: '20rpx' }" @click="handleShowReply"></rice-button>
			<rice-button type="default" text="关闭反馈" :customStyle="{ borderRadius: '40rpx', flex: 1 }" @click="handleClose"></rice-button>
		</view>

		<!-- 继续反馈弹窗 -->
		<rice-popup v-model:show="showReplyPopup" position="bottom" :round="true" :customStyle="{ height: '60%' }">
			<view class="popup-container">
				<view class="popup-header">
					<text class="popup-title">继续反馈</text>
					<text class="popup-close" @click="showReplyPopup = false">关闭</text>
				</view>

				<view class="popup-content">
					<view class="form-item">
						<text class="form-label">反馈内容</text>
						<textarea class="content-input" v-model="replyContent" placeholder="请输入反馈内容" maxlength="500" :showCount="true"></textarea>
					</view>

					<view class="form-item">
						<text class="form-label">上传图片</text>
						<view class="image-upload">
							<view class="image-item" v-for="(img, index) in replyImages" :key="index">
								<image class="preview-image" :src="img" mode="aspectFill" @click="previewReplyImage(index)"></image>
								<view class="delete-btn" @click="removeReplyImage(index)">×</view>
							</view>
							<view class="upload-btn" v-if="replyImages.length < 5" @click="chooseReplyImage">
								<text class="plus">+</text>
								<text class="text">添加图片</text>
							</view>
						</view>
					</view>
				</view>

				<view class="popup-footer">
					<rice-button type="primary" text="提交" :loading="replyLoading" @click="handleReply"></rice-button>
				</view>
			</view>
		</rice-popup>
	</view>
</template>

<script setup lang="uts">
	import { ref } from 'vue'
	import { getFeedbackDetail, replyFeedback, closeFeedback } from '@/api/http.uts'
	import { ApiUrl } from '@/api/url.uts'
	import { http } from '@/api/Request.uts'

	type FeedbackDetail = {
		id: number,
		feedbackNo: string,
		feedbackType: string,
		status: string,
		subTime: string,
		userPhone: string,
		imgOssUrl: string,
		feedbackContentList: FeedbackMessageItem[],
		rechargeNo: string
	}

	type FeedbackMessageItem = {
		sendType: string,
		time: string,
		replyContent: string,
		imgOssUrl: string
	}

	const feedbackId = ref('')
	const feedbackData = ref<FeedbackDetail>({
		id: 0,
		feedbackNo: '',
		feedbackType: '',
		status: '',
		subTime: '',
		userPhone: '',
		imgOssUrl: '',
		feedbackContentList: [],
		rechargeNo: ''
	})

	const showReplyPopup = ref(false)
	const replyContent = ref('')
	const replyImages = ref<string[]>([])
	const replyLoading = ref(false)

	// 获取状态标签类型
	const getStatusType = (status: string): string => {
		const typeMap = new Map<string, string>()
		typeMap.set('0', 'warning')
		typeMap.set('1', 'primary')
		typeMap.set('2', 'success')
		typeMap.set('3', 'default')
		return typeMap.get(status) ?? 'default'
	}

	// 获取状态文字
	const getStatusText = (status: string): string => {
		const textMap = new Map<string, string>()
		textMap.set('0', '待处理')
		textMap.set('1', '处理中')
		textMap.set('2', '已回复')
		textMap.set('3', '已关闭')
		return textMap.get(status) ?? status
	}

	// 获取反馈类型文字
	const getFeedbackTypeText = (type: string): string => {
		const textMap = new Map<string, string>()
		textMap.set('0', '功能建议')
		textMap.set('1', '问题报错')
		textMap.set('2', '投诉举报')
		textMap.set('3', '订单售后')
		textMap.set('4', '其他')
		return textMap.get(type) ?? type
	}

	// 获取详情
	const loadDetail = async () => {
		try {
			const res = await getFeedbackDetail(feedbackId.value, false)
			if (res.code == 200) {
				const data = res.data as FeedbackDetail
				if (data != null) {
					feedbackData.value = data
				}
			} else {
				uni.showToast({ title: res.msg ?? '查询失败', icon: 'none' })
			}
		} catch (error) {
			console.error('查询详情异常:', error)
		}
	}

	// 预览图片
	const previewImage = (current: string, urls: string) => {
		uni.previewImage({
			current: current,
			urls: urls.split(',')
		})
	}

	// 显示回复弹窗
	const handleShowReply = () => {
		replyContent.value = ''
		replyImages.value = []
		showReplyPopup.value = true
	}

	// 选择回复图片
	const chooseReplyImage = () => {
		const maxCount = 5 - replyImages.value.length
		uni.chooseImage({
			count: maxCount,
			sizeType: ['compressed'],
			sourceType: ['album', 'camera'],
			success: (res) => {
				const tempFilePaths = res.tempFilePaths
				if (tempFilePaths != null) {
					for (let i = 0; i < tempFilePaths.length; i++) {
						replyImages.value.push(tempFilePaths[i])
					}
				}
			}
		})
	}

	// 预览回复图片
	const previewReplyImage = (index: number) => {
		uni.previewImage({
			current: index,
			urls: replyImages.value
		})
	}

	// 删除回复图片
	const removeReplyImage = (index: number) => {
		replyImages.value.splice(index, 1)
	}

	// 提交回复
	const handleReply = async () => {
		if (!replyContent.value) {
			uni.showToast({ title: '请输入反馈内容', icon: 'none' })
			return
		}

		replyLoading.value = true
		try {
			// 先上传图片
			const uploadedUrls: string[] = []
			for (let i = 0; i < replyImages.value.length; i++) {
				const uploadResult = await http.upload({
					url: ApiUrl.feedbackUploadImage as string,
					filePath: replyImages.value[i],
					name: 'image',
					withToken: false,
					showLoading: false
				})
				if (uploadResult.code == 200 && uploadResult.data != null) {
					const data = uploadResult.data as UTSJSONObject
					const imgUrl = data['url'] as string ?? ''
					if (imgUrl !== '') {
						uploadedUrls.push(imgUrl)
					}
				}
			}

			// 提交回复
			const formData = new UTSJSONObject()
			formData['id'] = feedbackId.value
			formData['feedbackContent'] = replyContent.value
			if (uploadedUrls.length > 0) {
				formData['imgOssUrl'] = uploadedUrls.join(',')
			}

			const res = await replyFeedback(formData, false)
			if (res.code == 200) {
				uni.showToast({ title: '提交成功', icon: 'success' })
				showReplyPopup.value = false
				loadDetail()
			} else {
				uni.showToast({ title: res.msg ?? '提交失败', icon: 'none' })
			}
		} catch (error) {
			console.error('提交回复异常:', error)
			uni.showToast({ title: '网络异常，请重试', icon: 'none' })
		} finally {
			replyLoading.value = false
		}
	}

	// 关闭反馈
	const handleClose = () => {
		uni.showModal({
			title: '提示',
			content: '确定要关闭此反馈吗？关闭后将无法继续回复。',
			success: (res) => {
				if (res.confirm) {
					doClose()
				}
			}
		})
	}

	const doClose = async () => {
		try {
			const res = await closeFeedback(feedbackId.value, false)
			if (res.code == 200) {
				uni.showToast({ title: '已关闭', icon: 'success' })
				loadDetail()
			} else {
				uni.showToast({ title: res.msg ?? '操作失败', icon: 'none' })
			}
		} catch (error) {
			console.error('关闭反馈异常:', error)
			uni.showToast({ title: '网络异常，请重试', icon: 'none' })
		}
	}

	const goBack = () => {
		uni.navigateBack({ delta: 1 })
	}

	onLoad((options) => {
		feedbackId.value = options.feedbackId as string ?? ''
		loadDetail()
	})
</script>

