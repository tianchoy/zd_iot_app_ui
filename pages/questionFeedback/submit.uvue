<template>
	<!-- #ifndef MP-WEIXIN -->
	<topNavBar title="问题反馈" :show-back="true" @back="goBack" backgroundColor="#f4f7fb" textColor="#333" :showCapsule="true"
      :isIcon="false" rightText="我的反馈" rightActionBackgroundColor="#f0fdf4" @capsuleClick="toMyFeedback"
  ></topNavBar>
	<!-- #endif -->
	<view class="page-container">
		<view class="info-card">
			<view class="info-row">
				<text class="label">卡号</text>
				<text class="value">{{ rechargeNo }}</text>
			</view>
			<view class="info-row" v-if="orderNo">
				<text class="label">订单号</text>
				<text class="value">{{ orderNo }}</text>
			</view>
			<view class="info-row" v-if="pkgName">
				<text class="label">套餐名称</text>
				<text class="value">{{ pkgName }}</text>
			</view>
		</view>

		<view class="form-section">
			<view class="form-item">
				<text class="form-label"><text class="required">*</text>问题描述</text>
				<textarea class="content-input" v-model="feedbackContent" placeholder="请详细描述您的问题" maxlength="200" :showCount="true"></textarea>
			</view>

			<view class="form-item">
				<text class="form-label">问题截图(最多 3 张)</text>
				<view class="image-upload">
					<view class="image-item" v-for="(img, index) in images" :key="index">
						<image class="preview-image" :src="img" mode="aspectFill" @click="previewImage(index)"></image>
						<view class="delete-btn" @click="removeImage(index)">×</view>
					</view>
					<view class="upload-btn" v-if="canAddImage" @click="chooseImage">
						<text class="plus">+</text>
					</view>
				</view>
			</view>

			<view class="form-item">
				<text class="form-label"><text class="required">*</text>联系方式</text>
				<input class="phone-input" v-model="userPhone" placeholder="请输入手机号" type="text" maxlength="11" />
			</view>
		</view>

		<view class="submit-btn-container">
			<rice-button type="primary" text="提交" :loading="submitLoading" :customStyle="{ borderRadius: '40rpx' }" @click="handleSubmit"></rice-button>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref, computed } from 'vue'
	import { submitFeedback } from '@/api/http.uts'
	import { ApiUrl } from '@/api/url.uts'
	import { http } from '@/api/Request.uts'

	// H5 下页面参数（query）会被当作组件 attrs 透传，而本页根节点是
	// 「条件编译的 topNavBar + 容器」这种多根结构，Vue 无法自动继承 → 控制台刷警告。
	// 这里显式关闭属性继承消除该警告；页面参数仍由 onLoad(options) 读取，行为不变。
	defineOptions({
		inheritAttrs: false
	})

	// 问题截图上限（与页面文案「最多 3 张」保持一致）
	const MAX_IMAGE_COUNT: number = 3

	const rechargeNo = ref('')
	const orderNo = ref('')
	const pkgName = ref('')
	const feedbackContent = ref('')
	const userPhone = ref('')
	const images = ref<string[]>([])
	const submitLoading = ref(false)
	const canAddImage = computed<boolean>(() => images.value.length < MAX_IMAGE_COUNT)

	onLoad((options) => {
		rechargeNo.value = options.rechargeNo ?? ''
		orderNo.value = options.orderNo ?? ''
		pkgName.value = options.pkgName ?? ''
	})

	// 选择图片
	//
	// uni.chooseImage 的 count 在各端不保证生效（H5/小程序均出现过返回张数多于请求张数的情况），
	// 因此这里必须按剩余张数自行截断，否则「最多 3 张」的文案形同虚设。
	const chooseImage = () => {
		const remainCount = MAX_IMAGE_COUNT - images.value.length
		if (remainCount <= 0) {
			uni.showToast({ title: `最多上传 ${MAX_IMAGE_COUNT} 张图片`, icon: 'none' })
			return
		}
		uni.chooseImage({
			count: remainCount,
			sizeType: ['compressed'],
			sourceType: ['album', 'camera'],
			success: (res) => {
				const tempFilePaths = res.tempFilePaths
				if (tempFilePaths == null) return
				let added = 0
				for (let i = 0; i < tempFilePaths.length; i++) {
					if (images.value.length >= MAX_IMAGE_COUNT) break
					images.value.push(tempFilePaths[i])
					added++
				}
				// 超出部分被截断时明确告知，避免用户以为图片已全部选上
				if (added < tempFilePaths.length) {
					uni.showToast({ title: `最多上传 ${MAX_IMAGE_COUNT} 张图片，超出部分已忽略`, icon: 'none' })
				}
			}
		})
	}

	// 预览图片
	const previewImage = (index: number) => {
		uni.previewImage({
			current: index,
			urls: images.value
		})
	}

	// 删除图片
	const removeImage = (index: number) => {
		images.value.splice(index, 1)
	}

	// 提交反馈：提交时上传本地图片，再保存OSS主键
	const handleSubmit = async () => {
		const content = feedbackContent.value.trim()
		const phone = userPhone.value.trim()
		if (!content) {
			uni.showToast({ title: '请输入问题描述', icon: 'none' })
			return
		}
		if (!/^1[3-9]\d{9}$/.test(phone)) {
			uni.showToast({ title: '请输入正确的手机号', icon: 'none' })
			return
		}

		submitLoading.value = true
		try {
			const uploadedIds: string[] = []
			// 兜底：即使选图环节被绕过，也只提交前 MAX_IMAGE_COUNT 张
			const uploadImages = images.value.slice(0, MAX_IMAGE_COUNT)
			for (let i = 0; i < uploadImages.length; i++) {
				const uploadResult = await http.upload({
					url: ApiUrl.feedbackUploadImage as string,
					filePath: uploadImages[i],
					name: 'image',
					withToken: false,
					showLoading: false
				})
				const ossId = uploadResult.code == 200 && uploadResult.data != null
					? String(uploadResult.data).trim()
					: ''
				if (!ossId) {
					uni.showToast({ title: uploadResult.msg ?? '图片上传失败', icon: 'none' })
					return
				}
				uploadedIds.push(ossId)
			}

			const formData = new UTSJSONObject()
			formData['rechargeNo'] = rechargeNo.value
			formData['feedbackContent'] = content
			formData['userPhone'] = phone
			formData['feedbackType'] = '3'
			if (orderNo.value) {
				formData['orderNo'] = orderNo.value
			}
			if (pkgName.value) {
				formData['packageName'] = pkgName.value
			}
			if (uploadedIds.length > 0) {
				formData['imgOssIds'] = uploadedIds.join(',')
			}

			// 带 token 提交：后端据此把当前 app 用户写入 create_by，列表才能按「我的反馈」查出这条
			const res = await submitFeedback(formData, true)
			if (res.code == 200) {
				uni.showToast({ title: '提交成功', icon: 'success' })
				uni.redirectTo({
					url: `/pages/questionFeedback/list?rechargeNo=${rechargeNo.value}`
				})
			} else {
				uni.showToast({ title: res.msg ?? '提交失败', icon: 'none' })
			}
		} catch (error) {
			console.error('提交反馈异常:', error)
			uni.showToast({ title: '网络异常，请重试', icon: 'none' })
		} finally {
			submitLoading.value = false
		}
	}

	// 跳转到我的反馈
	const toMyFeedback = () => {
		uni.navigateTo({
			url: `/pages/questionFeedback/list?rechargeNo=${rechargeNo.value}`
		})
	}

	const goBack = () => {
		uni.navigateBack({ delta: 1 })
	}
</script>

<style lang="scss" scoped>
.page-container {
	display: flex;
	flex-direction: column;
	// #ifdef MP-WEIXIN || H5
	min-height: 100%;
	// #endif
	background-color: #f5f7fa;
	padding-bottom: 48rpx;
}

.info-card {
	background-color: #ffffff;
	margin: 20rpx;
	margin-bottom: 0;
	padding: 28rpx;
	border: 0;
	border-radius: 20rpx;

	.info-row {
		display: flex;
		flex-direction: row;
		margin-bottom: 16rpx;

		&:last-child {
			margin-bottom: 0;
		}

		.label {
			font-size: 26rpx;
			color: #606266;
			width: 140rpx;
			flex-shrink: 0;
		}

		.value {
			font-size: 26rpx;
			color: #303133;
			font-weight: 500;
			flex: 1;
		}
	}
}

.form-section {
	background-color: #ffffff;
	margin: 20rpx;
	padding: 28rpx;
	border: 0;
	border-radius: 20rpx;
}

.form-item {
	margin-bottom: 32rpx;

	&:last-child {
		margin-bottom: 0;
	}

	.form-label {
		display: block;
		font-size: 30rpx;
		color: #303133;
		margin-bottom: 16rpx;
		font-weight: 600;

		.required {
			color: #ef4444;
			margin-right: 4rpx;
		}
	}

	.content-input {
		width: 100%;
		height: 200rpx;
		padding: 20rpx;
		font-size: 28rpx;
		background-color: #ffffff;
		border-radius: 14rpx;
		border: 1rpx solid #dcdfe6;
		box-sizing: border-box;
	}

	.phone-input {
		width: 100%;
		height: 80rpx;
		padding: 0 20rpx;
		font-size: 28rpx;
		background-color: #ffffff;
		border-radius: 14rpx;
		border: 1rpx solid #dcdfe6;
		box-sizing: border-box;
	}

	.image-upload {
		display: flex;
		flex-direction: row;
		flex-wrap: wrap;
		gap: 16rpx;

		.image-item {
			position: relative;
			width: 160rpx;
			height: 160rpx;

			.preview-image {
				width: 100%;
				height: 100%;
				border-radius: 12rpx;
			}

			.delete-btn {
				position: absolute;
				top: -12rpx;
				right: -12rpx;
				width: 36rpx;
				height: 36rpx;
				background-color: #ef4444;
				color: #ffffff;
				border-radius: 50%;
				display: flex;
				align-items: center;
				justify-content: center;
				font-size: 24rpx;
			}
		}

		.upload-btn {
			width: 160rpx;
			height: 160rpx;
			display: flex;
			align-items: center;
			justify-content: center;
			background-color: #fafafa;
			border: 1rpx dashed #dcdfe6;
			border-radius: 14rpx;

			.plus {
				font-size: 48rpx;
				color: #94a3b8;
			}
		}
	}
}

.submit-btn-container {
	margin: 56rpx 20rpx 32rpx;
}
</style>
