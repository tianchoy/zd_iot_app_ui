<template>
	<topNavBar title="问题反馈" :show-back="true" @back="goBack" backgroundColor="#f4f7fb" textColor="#333" :showCapsule="true"
      :isIcon="false" rightText="我的反馈" rightActionBackgroundColor="#f0fdf4" @capsuleClick="toMyFeedback"
  ></topNavBar>
	<view class="page-container">
		<view class="info-card">
			<view class="info-row">
				<text class="label">卡号</text>
				<text class="value">{{ rechargeNo }}</text>
			</view>
			<view class="info-row" v-if="orderNo">
				<text class="label">订单号</text>
				<text class="value">{{ orderNo }}</text>
			</view>
			<view class="info-row" v-if="pkgName">
				<text class="label">套餐名称</text>
				<text class="value">{{ pkgName }}</text>
			</view>
		</view>

		<view class="form-section">
			<view class="form-item">
				<text class="form-label"><text class="required">*</text>问题描述</text>
				<textarea class="content-input" v-model="feedbackContent" placeholder="请详细描述您的问题" maxlength="200" :showCount="true"></textarea>
			</view>

			<view class="form-item">
				<text class="form-label">问题截图(最多 3 张)</text>
				<view class="image-upload">
					<view class="image-item" v-for="(img, index) in images" :key="index">
						<image class="preview-image" :src="img" mode="aspectFill" @click="previewImage(index)"></image>
						<view class="delete-btn" @click="removeImage(index)">×</view>
					</view>
					<view class="upload-btn" v-if="images.length < 3" @click="chooseImage">
						<text class="plus">+</text>
					</view>
				</view>
			</view>

			<view class="form-item">
				<text class="form-label"><text class="required">*</text>联系方式</text>
				<input class="phone-input" v-model="userPhone" placeholder="请输入手机号" type="text" maxlength="11" />
			</view>
		</view>

		<view class="submit-btn-container">
			<rice-button type="primary" text="提交" :loading="submitLoading" :customStyle="{ borderRadius: '40rpx' }" @click="handleSubmit"></rice-button>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref } from 'vue'
	import { submitFeedback } from '@/api/http.uts'
	import { ApiUrl } from '@/api/url.uts'
	import { http } from '@/api/Request.uts'

	const rechargeNo = ref('')
	const orderNo = ref('')
	const pkgName = ref('')
	const feedbackContent = ref('')
	const userPhone = ref('')
	const images = ref<string[]>([])
	const submitLoading = ref(false)

	onLoad((options) => {
		rechargeNo.value = options.rechargeNo ?? ''
		orderNo.value = options.orderNo ?? ''
		pkgName.value = options.pkgName ?? ''
	})

	// 选择图片
	const chooseImage = () => {
		const maxCount = 3 - images.value.length
		uni.chooseImage({
			count: maxCount,
			sizeType: ['compressed'],
			sourceType: ['album', 'camera'],
			success: (res) => {
				const tempFilePaths = res.tempFilePaths
				if (tempFilePaths != null) {
					for (let i = 0; i < tempFilePaths.length; i++) {
						images.value.push(tempFilePaths[i])
					}
				}
			}
		})
	}

	// 预览图片
	const previewImage = (index: number) => {
		uni.previewImage({
			current: index,
			urls: images.value
		})
	}

	// 删除图片
	const removeImage = (index: number) => {
		images.value.splice(index, 1)
	}

	// 提交反馈：提交时上传本地图片，再保存OSS主键
	const handleSubmit = async () => {
		const content = feedbackContent.value.trim()
		const phone = userPhone.value.trim()
		if (!content) {
			uni.showToast({ title: '请输入问题描述', icon: 'none' })
			return
		}
		if (!/^1[3-9]\d{9}$/.test(phone)) {
			uni.showToast({ title: '请输入正确的手机号', icon: 'none' })
			return
		}

		submitLoading.value = true
		try {
			const uploadedIds: string[] = []
			for (let i = 0; i < images.value.length; i++) {
				const uploadResult = await http.upload({
					url: ApiUrl.feedbackUploadImage as string,
					filePath: images.value[i],
					name: 'image',
					withToken: false,
					showLoading: false
				})
				const ossId = uploadResult.code == 200 && uploadResult.data != null
					? String(uploadResult.data).trim()
					: ''
				if (!ossId) {
					uni.showToast({ title: uploadResult.msg ?? '图片上传失败', icon: 'none' })
					return
				}
				uploadedIds.push(ossId)
			}

			const formData = new UTSJSONObject()
			formData['rechargeNo'] = rechargeNo.value
			formData['feedbackContent'] = content
			formData['userPhone'] = phone
			formData['feedbackType'] = '3'
			if (orderNo.value) {
				formData['orderNo'] = orderNo.value
			}
			if (pkgName.value) {
				formData['packageName'] = pkgName.value
			}
			if (uploadedIds.length > 0) {
				formData['imgOssIds'] = uploadedIds.join(',')
			}

			const res = await submitFeedback(formData, false)
			if (res.code == 200) {
				uni.showToast({ title: '提交成功', icon: 'success' })
				uni.redirectTo({
					url: `/pages/questionFeedback/list?rechargeNo=${rechargeNo.value}`
				})
			} else {
				uni.showToast({ title: res.msg ?? '提交失败', icon: 'none' })
			}
		} catch (error) {
			console.error('提交反馈异常:', error)
			uni.showToast({ title: '网络异常，请重试', icon: 'none' })
		} finally {
			submitLoading.value = false
		}
	}

	// 跳转到我的反馈
	const toMyFeedback = () => {
		uni.navigateTo({
			url: `/pages/questionFeedback/list?rechargeNo=${rechargeNo.value}`
		})
	}

	const goBack = () => {
		uni.navigateBack({ delta: 1 })
	}
</script>

<style lang="scss" scoped>
.page-container {
	display: flex;
	flex-direction: column;
	// #ifdef MP-WEIXIN || H5
	min-height: 100%;
	// #endif
	background-color: #f5f7fa;
	padding-bottom: 48rpx;
}

.info-card {
	background-color: #ffffff;
	margin: 20rpx;
	margin-bottom: 0;
	padding: 28rpx;
	border: 0;
	border-radius: 20rpx;

	.info-row {
		display: flex;
		flex-direction: row;
		margin-bottom: 16rpx;

		&:last-child {
			margin-bottom: 0;
		}

		.label {
			font-size: 26rpx;
			color: #606266;
			width: 140rpx;
			flex-shrink: 0;
		}

		.value {
			font-size: 26rpx;
			color: #303133;
			font-weight: 500;
			flex: 1;
		}
	}
}

.form-section {
	background-color: #ffffff;
	margin: 20rpx;
	padding: 28rpx;
	border: 0;
	border-radius: 20rpx;
}

.form-item {
	margin-bottom: 32rpx;

	&:last-child {
		margin-bottom: 0;
	}

	.form-label {
		display: block;
		font-size: 30rpx;
		color: #303133;
		margin-bottom: 16rpx;
		font-weight: 600;

		.required {
			color: #ef4444;
			margin-right: 4rpx;
		}
	}

	.content-input {
		width: 100%;
		height: 200rpx;
		padding: 20rpx;
		font-size: 28rpx;
		background-color: #ffffff;
		border-radius: 14rpx;
		border: 1rpx solid #dcdfe6;
		box-sizing: border-box;
	}

	.phone-input {
		width: 100%;
		height: 80rpx;
		padding: 0 20rpx;
		font-size: 28rpx;
		background-color: #ffffff;
		border-radius: 14rpx;
		border: 1rpx solid #dcdfe6;
		box-sizing: border-box;
	}

	.image-upload {
		display: flex;
		flex-direction: row;
		flex-wrap: wrap;
		gap: 16rpx;

		.image-item {
			position: relative;
			width: 160rpx;
			height: 160rpx;

			.preview-image {
				width: 100%;
				height: 100%;
				border-radius: 12rpx;
			}

			.delete-btn {
				position: absolute;
				top: -12rpx;
				right: -12rpx;
				width: 36rpx;
				height: 36rpx;
				background-color: #ef4444;
				color: #ffffff;
				border-radius: 50%;
				display: flex;
				align-items: center;
				justify-content: center;
				font-size: 24rpx;
			}
		}

		.upload-btn {
			width: 160rpx;
			height: 160rpx;
			display: flex;
			align-items: center;
			justify-content: center;
			background-color: #fafafa;
			border: 1rpx dashed #dcdfe6;
			border-radius: 14rpx;

			.plus {
				font-size: 48rpx;
				color: #94a3b8;
			}
		}
	}
}

.submit-btn-container {
	margin: 56rpx 20rpx 32rpx;
}
</style>
