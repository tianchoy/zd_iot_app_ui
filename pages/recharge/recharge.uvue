<template>
	<!-- 微信半屏小程序由微信提供顶部导航栏，不能再叠加自定义导航栏；H5 等端继续使用项目自定义导航。 -->
	<!-- #ifndef MP-WEIXIN -->
	<!-- 测试版：取消 App 内隐藏 H5 标题的做法，统一由 H5 自带「充值首页」栏作为唯一标题；
	     对应的 App 端已隐藏其原生导航栏（见 App 侧 WebContent 的 hideAppBar）。 -->
	<topNavBar :title="$t('rechargeHome')" :show-back="showBack" @back="goBack" backgroundColor="#f4f7fb" textColor="#333" :showCapsule="false"></topNavBar>
	<!-- #endif -->
	<!-- 外跳优先级高于渲染：判定期间不渲染充值页内容，避免「先渲染再跳」的闪烁 -->
	<view v-if="h5RedirectPending" style="display: flex; align-items: center; justify-content: center; height: 60vh;">
		<text style="font-size: 26rpx; color: #999999;">{{ $t('opening') }}</text>
	</view>
	<view class="container" v-if="!h5RedirectPending">
		<view class="card-info">
			<view class="card-title">
				<text class="title">{{ $t('cardInfo') }}</text>
				<rice-tag :text="cardDetail?.statusStr || t('unknown')" :round="true" plain-fill size="small" :type="getOrderStatusType(cardDetail?.statusStr)"></rice-tag>
			</view>
			<view class="card-number" v-if="cardDetail?.rechargeNo">{{ cardDetail?.rechargeNo || $t('unknown') }}</view>
			<view class="info-list">
				<view class="info-item" v-if="cardDetail?.pkgName">
					<text class="label">{{ $t('currentPlan') }}</text>
					<text class="value">{{ cardDetail?.pkgName || $t('unknown') }}</text>
				</view>
				<view class="info-item"  v-if="cardDetail?.effectiveTime || cardDetail?.expirationTime">
					<text class="label">{{ $t('validityPeriod') }}</text>
					<view class="value" style="display: flex; flex-direction: row; align-items: center; flex-wrap: nowrap; white-space: nowrap;">
						<text style="font-size: 22rpx;" v-if="cardDetail?.effectiveTime">{{ cardDetail?.effectiveTime }} </text>
						<text style="font-size: 22rpx;" v-if="cardDetail?.expirationTime">~ {{ cardDetail?.expirationTime }}</text>
					</view>
				</view>
			</view>
			<view class="flow-box" v-if="cardDetail?.pkgFlow">
				<view class="flow-label">
					<text class="value" style="font-size: 22rpx;">{{ $t('used') }} {{ DataFormat.formatTraffic(cardDetail?.usedFlow) }} / {{ $t('remaining') }} {{ DataFormat.formatTraffic(cardDetail?.unUsedFlow) }} / {{ $t('totalFlow') }} {{ DataFormat.formatTraffic(cardDetail?.pkgFlow) }}</text>
				</view>
				<rice-progress :percentage="percentage" show-text />
			</view>
			<view class="card-bottom">
				<rice-button class="btn mr-24" @click="toMyPackage">{{ $t('cardPlans') }}</rice-button>
				<rice-button class="btn" @click="toOrderRecord">{{ $t('orderRecord') }}</rice-button>
			</view>
		</view>
		<view class="pkg-box">
			<rice-tabs
				v-model="active"
				line-color="#ffffff"
				:list="tabs"
				:line-width="0"
				:title-active-color="'#2563eb'"
				:title-inactive-color="'#64748b'"
				@change="changeTab"
				:customStyle="{height:'85rpx',padding:'10rpx',border:'1rpx solid #e5edf6'}"
			>
			</rice-tabs>
			<view class="pkg-content">
				<!-- 套餐包列表 -->
				<block v-if="active === 0">
					<view
						v-for="(item, index) in packageList"
						:key="item.pkgId || index"
						class="pkg-card"
						:class="{ 'pkg-card-selected': selectedPackageIndex === index }"
						@click="selectPackage(index,item)"
					>
						<view class="pkg-info">
							<view class="pkg-name">
								<text class="pkg-title">{{ item.pkgName }}</text>
								<text v-if="item.tag" class="pkg-tag">{{ item.tag }}</text>
							</view>
							<view class="pkg-desc">
								<text class="pkg-icon" v-if="item.pkgFlow">{{ $t('traffic') }} {{ DataFormat.formatTraffic(item.pkgFlow) }}</text>
								<text class="pkg-icon" v-if="item.validityPeriod">{{ $t('validityPeriod') }} {{ item.validityPeriod }}{{ item?.pkgType == '1' ? $t('day') : $t('month') }}</text>
							</view>
						</view>
						<view class="pkg-price">
							<view class="price-wrapper">
								<template v-if="isINT()">
									<text class="price-number">{{ intlPkgPrice(item.sellingPrice, item.symbol || '', item.signPosition || '') }}</text>
								</template>
								<template v-else>
									<text class="price-symbol">¥</text>
									<text class="price-number">{{ AmountUtil.format(item.sellingPrice, {showSymbol: false}) }}</text>
								</template>
							</view>
							<view class="price-original" v-if="item.crossedOutPrice && item.crossedOutPrice != item.sellingPrice">
								<template v-if="isINT()">{{ intlPkgPrice(item.crossedOutPrice, item.symbol || '', item.signPosition || '') }}</template>
								<template v-else>¥{{ AmountUtil.format(item.crossedOutPrice, {showSymbol: false}) }}</template>
							</view>
						</view>
					</view>
					<view v-if="packageList.length == 0" class="empty-state">{{ $t('noPkgAvailable') }}</view>
				</block>
				<!-- 加油包列表 -->
				<block v-else>
					<view
						v-for="(item, index) in refillList"
						:key="item.pkgId || index"
						class="pkg-card"
						:class="{ 'pkg-card-selected': selectedRefillIndex == index }"
						@click="selectRefill(index)"
					>
						<view class="pkg-info">
							<view class="pkg-name">
								<text class="pkg-title">{{ item.pkgName }}</text>
								<text v-if="item.tag" class="pkg-tag">{{ item.tag }}</text>
							</view>
							<view class="pkg-desc">
								<text class="pkg-icon" v-if="item.pkgFlow">{{ $t('traffic') }} {{ DataFormat.formatTraffic(item.pkgFlow) }}</text>
								<text class="pkg-icon" v-if="item.validityPeriod">{{ $t('validityPeriod') }} {{ item.validityPeriod }}{{ item?.pkgType == '1' ? $t('day') : $t('month') }}</text>
							</view>
						</view>
						<view class="pkg-price">
							<view class="price-wrapper">
								<template v-if="isINT()">
									<text class="price-number">{{ intlPkgPrice(item.sellingPrice, item.symbol || '', item.signPosition || '') }}</text>
								</template>
								<template v-else>
									<text class="price-symbol">¥</text>
									<text class="price-number">{{ AmountUtil.format(item.sellingPrice, {showSymbol: false}) }}</text>
								</template>
							</view>
							<view class="price-original" v-if="item.crossedOutPrice && item.crossedOutPrice != item.sellingPrice">
								<template v-if="isINT()">{{ intlPkgPrice(item.crossedOutPrice, item.symbol || '', item.signPosition || '') }}</template>
								<template v-else>¥{{ AmountUtil.format(item.crossedOutPrice, {showSymbol: false}) }}</template>
							</view>
						</view>
					</view>
					<view v-if="refillList.length == 0" class="empty-state">{{ $t('noRefillAvailable') }}</view>
				</block>
			</view>
		</view>
	</view>
	<rice-popup
		v-model:show="showPopup"
		position="bottom"
		@close="onPopupClose"
	>
		<Payment
			:amount="currentPrice"
			@cancel="handleCancelPayment"
			@confirm="handleConfirmPayment"
			:cardNumber="cardDetail?.rechargeNo"
			:productName="currentPackage?.pkgName"
			:traffic="currentPackage?.pkgFlow"
			:validityPeriod="currentPackage?.validityPeriod"
			:pkgType="currentPackage?.pkgType"
			:payMethod="cardDetail?.objectMap.payInfo"
		/>
	</rice-popup>
	<view class="bottom-box" v-if="packageList.length > 0 || refillList.length > 0">
		<view class="tips" v-if="showTips && cardDetail?.objectMap?.rechargeTip">
			<text class="tips-text">{{ cardDetail?.objectMap.rechargeTip }}</text>
			<view class="tips-close" @click="closeTips">
				<rice-icon name="clear" :color="'#cbd5e1'" size="35rpx" />
			</view>
			<view class="tips-arrow"></view>
		</view>
		<view class="pay-content">
			<view class="price-box">
				<text class="price-label">{{ $t('currentAmount') }}</text>
				<text class="price-value">{{ currentPriceText }}</text>
			</view>
			<rice-button type="primary" width="300rpx" height="110rpx" @click="choosePayment" class="btn">{{ $t('goPay') }}</rice-button>
		</view>
	</view>
	<view ref="formContainer" class="form-container"></view>
	<!-- 客服入口与卡片详情页共用同一组件（同一套 logo / 拖动手感 / 渠道降级） -->
	<customer-service v-if="hasCustomerService" :config="customerServiceConfig"
		@show_popup="showCustomService = true"></customer-service>
	<tousu v-if="false" @connect_tousu="handleConnectTousu"></tousu>
	<customerServicePopup v-model:show="showCustomService" :qrcode="customerServiceConfig.serviceQrcode"
		:phones="phoneList" :wechatTip="$t('addWechatTip')"
		:phoneLabel="$t('servicePhone')" :callText="$t('makeCall')"
		:serviceTime="customerServiceConfig.serviceTime"
		@qrcodeError="refreshCustomerService"></customerServicePopup>
</template>

<script setup lang="uts">
	import { ref, computed } from 'vue';
	import { queryCardDetail, addOrder, goPayXcx, login,getTenantInfo} from '@/api/http.uts';
	import type {RechargeData,PkgXcxVo} from '@/api/types'
	import { config , getTenantId,getAppId,isWechat,isH5,setToken,setStorageSync,getToken,setWxGetPhoneLogin,isPhoneLoginRequired,isINT} from '@/common/config.uts';
	import Payment from '@/components/payment.uvue';
	import tousu from '@/components/tousu.uvue';
	import customerServicePopup from '@/components/customerServicePopup.uvue';
	import customerService from '@/components/customer-service.uvue';
	import { emptyCustomerService, hasAnyChannel, splitServicePhones } from '@/common/customerService.uts';
	import type { CustomerServiceConfig } from '@/common/customerService.uts';
	import {DataFormat} from '@/utils/dataFormat.uts';
	import {AmountUtil} from '@/utils/amount.uts';
	import i18n from '@/i18n';
	// 脚本侧翻译助手（与 intlPay/payStripe/feedback 一致）
	const t = (key: string): string => i18n.global.t(key) as string
	import { ensureWxMpAuth, consumeMpTokenFromQuery, getMpToken, clearMpToken, invokeMpJsapiPay,
		PAY_STATUS_OK, PAY_STATUS_CANCEL, PAY_STATUS_TIMEOUT, PAY_STATUS_NOT_WECHAT } from '@/utils/wxMpAuth.uts';
	defineOptions({
		inheritAttrs: false
	})
	const showTips = ref<boolean>(true);
	const showCustomService = ref<boolean>(false);
	// 外跳优先级高于渲染：判定期间不渲染页面内容，避免「先渲染再跳」的闪烁
	const h5RedirectPending = ref<boolean>(true);

	const closeTips = () => {
		showTips.value = false;
	}

	const showPopup = ref<boolean>(false);
	// 添加标记：是否正在支付流程中
	const isInPaymentProcess = ref<boolean>(false);
	// 通联收银台小程序 appid（后端按支付渠道下发）：跳转与 1038 回跳判定都用它，
	// 不能用自身 appid —— 微信禁止小程序跳转自身，且回跳时 referrerInfo 是收银台的 appid
	const cashierAppId = ref<string>('');
	// 是否显示返回按钮
	const showBack = ref<boolean>(true);
	// 是否由 App 内 WebView 打开（source=app）：决定返回按钮走原生关闭通道
	const isFromApp = ref<boolean>(false);
	// H5 端「支付中」加载态兜底定时器
	let payLoadingTimer: number | null = null
	const clearPayLoadingTimer = () => {
		if (payLoadingTimer != null) {
			clearTimeout(payLoadingTimer!)
			payLoadingTimer = null
		}
	}
	const hidePayLoading = () => {
		clearPayLoadingTimer()
		uni.hideLoading()
	}

	/** 卡详情 */
	const cardDetail = ref<RechargeData | null>(null)

	// 计算流量使用百分比
	const percentage = computed<number>((): number => {
		const detail = cardDetail.value
		if (detail == null) return 0
		const usedFlow = detail.usedFlow
		const totalFlow = detail.pkgFlow

		// 如果没有数据，返回0
		if (usedFlow == null || totalFlow == null) {
			return 0;
		}

		const used = Number.parseFloat(usedFlow);
		const total = Number.parseFloat(totalFlow);

		// 避免除以0
		if (total === 0) {
			return 0;
		}

		// 计算百分比，保留整数
		let percent = (used / total) * 100;

		// 限制百分比在0-100之间
		percent = Math.min(100, Math.max(0, percent));

		return Math.round(percent);
	});

	const active = ref<number>(0);
	// tab 名称走多语言，切换语言后即时刷新
	const tabs = computed<any[]>((): any[] => [
		{
			name: t('pkgTab')
		},
		{
			name: t('refillTab')
		}
	]);

	// 套餐包列表
	const packageList = ref<Array<PkgXcxVo>>([]);
	// 加油包列表
	const refillList = ref<Array<PkgXcxVo>>([]);

	// 选中的套餐包索引
	const selectedPackageIndex = ref<number>(0);
	// 选中的加油包索引
	const selectedRefillIndex = ref<number>(0);
	// 选中的套餐包
	const selectedPackage = ref<PkgXcxVo | null>(null);

	// 从URL参数中获取的默认pkgId
	const defaultPkgId = ref<string>('');

	// 当前选中的套餐/加油包
	const currentPackage = computed<PkgXcxVo | null>((): PkgXcxVo | null => {
		if (active.value === 0) {
			return packageList.value[selectedPackageIndex.value] ?? null;
		}
		return refillList.value[selectedRefillIndex.value] ?? null;
	});

	// 当前价格（根据选中的套餐/加油包计算）
	const currentPrice = computed<string>((): string => {
		if (active.value === 0) {
			const item = packageList.value[selectedPackageIndex.value];
			return item ? item.sellingPrice : '0.00';
		} else {
			const item = refillList.value[selectedRefillIndex.value];
			return item ? item.sellingPrice : '0.00';
		}
	});

	// 国际版：套餐价格按自带币种符号展示（与原文一致，保留两位小数）
	const intlPkgPrice = (price: string, symbol: string, signPosition: string): string => {
		const num = Number(price || '0').toFixed(2)
		if (signPosition == '0') {
			return (symbol || '') + ' ' + num
		}
		return num + ' ' + (symbol || '')
	}

	// 国际版底部「当前套餐金额」按币种符号展示，国内版沿用 ¥ 格式化
	const currentPriceText = computed<string>((): string => {
		if (isINT()) {
			const pkg = currentPackage.value
			return intlPkgPrice(currentPrice.value, pkg?.symbol || '', pkg?.signPosition || '')
		}
		return AmountUtil.format(currentPrice.value)
	});

	// 根据 pkgCategory 分类套餐和加油包，并按 pkgSort 排序
	const classifyPackages = (packages: Array<PkgXcxVo>) => {
		const packagesList: Array<PkgXcxVo> = [];
		const refillsList: Array<PkgXcxVo> = [];

		packages.forEach((item, index) => {
			// pkgCategory: 3为套餐，4为加油包
			if (item.pkgCategory == '3') {
				packagesList.push(item);
			} else if (item.pkgCategory == '4') {
				refillsList.push(item);
			}
		});

		// 按 pkgSort 排序（升序，数值越小越靠前）
		// pkgSort 为 null 或 undefined 的排到最后
		const sortByPkgSort = (a: PkgXcxVo, b: PkgXcxVo) => {
			const sortA = a.pkgSort ?? Number.MAX_SAFE_INTEGER;
			const sortB = b.pkgSort ?? Number.MAX_SAFE_INTEGER;
			return sortA - sortB;
		};

		packageList.value = packagesList.sort(sortByPkgSort);
		refillList.value = refillsList.sort(sortByPkgSort);

		// 根据URL参数中的pkgId设置默认选中
		setDefaultSelection();
	};

	// 设置默认选中的套餐/加油包
	const setDefaultSelection = () => {
		const packagesList = packageList.value;
		const refillsList = refillList.value;
		const defaultId = defaultPkgId.value;

		// 如果有默认pkgId，尝试匹配
		if (defaultId) {
			// 先在套餐包中查找
			const pkgIndex = packagesList.findIndex(item => item.pkgId === defaultId);
			if (pkgIndex !== -1) {
				selectedPackageIndex.value = pkgIndex;
				active.value = 0;
				return;
			}

			// 再在加油包中查找
			const refillIndex = refillsList.findIndex(item => item.pkgId === defaultId);
			if (refillIndex !== -1) {
				selectedRefillIndex.value = refillIndex;
				active.value = 1;
				return;
			}
		}

		// 如果没有默认pkgId或未匹配到，优先选中第一个套餐，没有套餐则选中第一个加油包
		if (packagesList.length > 0) {
			selectedPackageIndex.value = 0;
			active.value = 0;
		} else if (refillsList.length > 0) {
			selectedRefillIndex.value = 0;
			active.value = 1;
		} else {
			// 如果都没有，重置索引
			selectedPackageIndex.value = 0;
			selectedRefillIndex.value = 0;
		}
	};

	const getOrderStatusType = (status: string): string => {
		const typeMap = new Map<string, string>()
		typeMap.set('在用', 'success')
		typeMap.set('停机', 'error')
		return typeMap.get(status) ?? 'warning'
	}

	interface TabEvent {
		index: number
	}

	const changeTab = (e: TabEvent) => {
		active.value = e.index;
	}

	const selectPackage = (index: number, item: PkgXcxVo) => {
		selectedPackageIndex.value = index;
		selectedPackage.value = item;
	}

	const selectRefill = (index: number) => {
		selectedRefillIndex.value = index;
	}

	// 选择支付方式
	const choosePayment = () => {
		if (active.value === 0 && packageList.value.length === 0) {
			uni.showToast({
				title: t('noPkgSelectable'),
				icon: 'none'
			});
			return;
		}
		if (active.value === 1 && refillList.value.length === 0) {
			uni.showToast({
				title: t('noRefillSelectable'),
				icon: 'none'
			});
			return;
		}
		// 国际版：不走国内微信/支付宝弹窗，直接建单后进入支付方式选择页
		if (isINT()) {
			createIntlOrder();
			return;
		}
		showPopup.value = true;
	}

	// 国际版下单：参数含 msisdn / registerCountry，下单成功后跳转支付方式页
	const createIntlOrder = async () => {
		const detail = cardDetail.value
		const currentItem = currentPackage.value
		if (detail == null || currentItem == null) {
			uni.showToast({
				title: t('selectPkgFirst'),
				icon: 'none'
			});
			return;
		}
		uni.showLoading({
			title: t('paying')
		});
		const params = {
			pkgId: currentItem.pkgId,
			msisdn: cardNumber.value,
			registerCountry: country.value,
			orderSource: '2',
			operateScope: '1',
			pkgName: currentItem.pkgName
		}
		// 记录最近卡号，供「我的订单」按卡号过滤
		setStorageSync('lastRechargeNo', cardNumber.value)
		try {
			const res = await addOrder(params)
			if (res.code == 200) {
				const orderId = (res.data?.id ?? res.data?.orderId) as string
				if (!orderId) {
					uni.hideLoading()
					uni.showToast({
						title: res.msg || t('orderFailed'),
						icon: 'none'
					});
					return;
				}
				uni.hideLoading()
				uni.navigateTo({
					url: '/pages/intlPay/intlPay?orderId=' + orderId
						+ '&msisdn=' + encodeURIComponent(cardNumber.value)
						+ '&countryCode=' + encodeURIComponent(country.value)
						+ '&pkgName=' + encodeURIComponent(currentItem.pkgName)
				})
			} else {
				uni.hideLoading()
				uni.showToast({
					title: res.msg || t('orderFailed'),
					icon: 'none'
				});
			}
		} catch (error) {
			uni.hideLoading()
			uni.showToast({
				title: t('orderFailedRetry'),
				icon: 'none'
			});
		}
	}

	// 取消支付
	const handleCancelPayment = () => {
		showPopup.value = false;
	}

	const orderNo = ref<string>('')
	// 当前待支付单对应的套餐：取消支付后再次支付时，只有同一套餐才复用该单，
	// 避免重复下单触发服务端「订单正在创建，请勿重复支付」；切换套餐则重新下单。
	const pendingPkgId = ref<string>('')
	const payChannelId = ref<string>('')
	// 支付失败/未知状态统一收尾：清理加载态与支付流程标记
	const handlePayFailed = (message: string) => {
		uni.hideLoading()
		uni.showToast({
			title: message,
			icon: 'none',
			duration: 1000
		})
		isInPaymentProcess.value = false
	}
	const toPay = (data:any) => {
		if(!data){
			handlePayFailed('支付参数缺失，请稍后重试')
			return
		}
		const res = data as any
		if(res.orderNo) orderNo.value = res.orderNo
		if(res.payChannelId) payChannelId.value = res.payChannelId
		// 设置正在支付流程中
		isInPaymentProcess.value = true

		if(res.payWxType == 'wechat_pay'){
			uni.requestPayment({
				provider: 'wxpay',
				timeStamp: res.timeStamp,
				nonceStr: res.nonceStr,
				package: res.package,
				paySign: res.paySign,
				signType: res.signType,

				success: (payRes) => {
					console.log('微信支付成功',payRes)
					uni.hideLoading()
					isInPaymentProcess.value = false
					uni.redirectTo({
						url: '/pages/paySuccess/paySuccess?orderId=' + orderNo.value + '&payChannelId=' + payChannelId.value
					})
				},
				fail: (payErr) => {
					console.error('微信支付失败:', payErr)
					handlePayFailed('微信支付失败，请您重新支付')
					setTimeout(() => {
						uni.reLaunch({
							url: '/pages/orderDetail/orderDetail?orderNo=' + orderNo.value
						});
					}, 1000);
				},
			})
			return
		}

		if(res.payWxType == 'allin_pay'){
			if(res.payWxClass == '0'){
				uni.requestPayment({
					timeStamp: res.timeStamp,
					nonceStr: res.nonceStr,
					package: res.package,
					paySign: res.paySign,
					signType: res.signType,
					success: (payRes) => {
						uni.hideLoading()
						isInPaymentProcess.value = false
						uni.redirectTo({
							url: '/pages/paySuccess/paySuccess?orderId=' + orderNo.value + '&payChannelId=' + payChannelId.value
						})
					},
					fail: (payErr) => {
						console.error('通联支付失败:', payErr)
						handlePayFailed('通联支付失败，请您重新支付')
						setTimeout(() => {
							uni.reLaunch({
								url: '/pages/orderDetail/orderDetail?orderNo=' + orderNo.value
							});
						}, 1000);
					},
				});
				return
			}

			// 跳转收银台小程序，支付结果由 onShow 的 1038 场景回调处理
			const param = {
				cusid: res.cusid,
				appid: res.appid,
				orgid: res.orgid,
				version: res.version,
				trxamt: res.trxamt,
				reqsn: res.reqsn,
				notify_url: res.notify_url,
				body: res.body,
				remark: res.remark,
				randomstr: res.randomstr,
				paytype: res.paytype,
				signtype: res.signtype,
				sign: res.sign,
			}

			// 收银台 appid 由后端下发（payWxClassAppId）；缺失时回退自身 appid 保持旧行为
			cashierAppId.value = (res.payWxClassAppId as string) ?? ''
			uni.navigateToMiniProgram({
				appId: cashierAppId.value.length > 0 ? cashierAppId.value : config.api.auth.appID,
				extraData: param,
				success: () => {
					console.log('打开收银台小程序成功，等待支付结果回调')
				},
				fail: (payErr) => {
					console.error('打开收银台小程序失败:', payErr)
					handlePayFailed('打开支付小程序失败，请重试')
				},
			})
			return
		}

		// 未知支付方式：避免 loading 与支付标记残留
		handlePayFailed('暂不支持该支付方式，请重新选择')
	}
	const formContainer = ref<HTMLDivElement | null>(null);
	const handleAlipayForm = (formHtml: string) => {
		if (!formContainer.value) return;
		formContainer.value.innerHTML = formHtml;
		const form = formContainer.value.querySelector('form');
		if (form) {
			form.submit();
		} else {
			console.error('未找到支付表单');
		}
	};

	// 下单请求进行中标记，避免快速重复触发产生重复订单
	const isSubmittingOrder = ref<boolean>(false)

	// 确认支付
	const handleConfirmPayment =  async (e: any) => {
		console.log('确认支付:', e)
		// 防重复提交
		if (isSubmittingOrder.value) {
			return
		}
		const merchantConfigId = e as string

		// 支付前校验：卡片详情与所选套餐必须已就绪，避免空指针与无效下单
		const detail = cardDetail.value
		const list = active.value === 0 ? packageList.value : refillList.value
		const index = active.value === 0 ? selectedPackageIndex.value : selectedRefillIndex.value
		const currentItem = (index >= 0 && index < list.length) ? list[index] : null

		if (detail == null) {
			showPopup.value = false
			uni.showToast({
				title: t('cardInfoNotLoaded'),
				icon: 'none'
			})
			return
		}

		if (currentItem == null) {
			showPopup.value = false
			uni.showToast({
				title: t('selectPkgFirst'),
				icon: 'none'
			})
			return
		}

		if (isH5() && !merchantConfigId) {
			uni.showToast({
				title: t('selectPayFirst'),
				icon: 'none'
			})
			return
		}

		// 微信内下单前确保凭证有效：过期/已被上次下单消费时会重新静默授权
		if (isH5() && (await ensureWxMpAuth(cardDetail.value.rechargeNo))) {
			return
		}

		uni.showLoading({
			title: t('paying')
		})

		// 仅 H5 端：支付会跳转/拉起外部应用，加载态可能无人关闭，10s 后兜底自动隐藏
		if (isH5()) {
			clearPayLoadingTimer()
			payLoadingTimer = setTimeout(() => {
				payLoadingTimer = null
				uni.hideLoading()
			}, 10000)
		}

		showPopup.value = false;

		console.log('currentItem:', currentItem,currentItem.pkgId)

		// 同一套餐已存在待支付单时，复用该单重拉起支付，避免重复下单触发
		// 服务端「订单正在创建，请勿重复支付」的防重提示（接口端未返回可复用单号）。
		const canReuse = orderNo.value.length > 0 && pendingPkgId.value === currentItem.pkgId

		// 处理确认逻辑
		isSubmittingOrder.value = true
		try {
			let res
			if (canReuse) {
				// 复用已落库的待支付单（goPayment）：按当前所选渠道 merchantConfigId 重拉起，
				// 不会触发重复下单防重；换渠道（微信↔支付宝）也能正确重新生成预支付。
				res = await goPayXcx(orderNo.value, merchantConfigId, isWechat(), getMpToken())
			} else {
				let params = {}
				if(isWechat()){
					params = {
						pkgId: currentItem.pkgId,
						rechargeNo: cardDetail.value.rechargeNo,
						appId: getAppId(),
					}
				}

				if(isH5()){
					params = {
						pkgId: currentItem.pkgId,
						rechargeNo: cardDetail.value.rechargeNo,
						merchantConfigId,
						// 公众号授权凭证：为空时后端自动回退微信H5支付
						mpToken: getMpToken()
					}
				}
				console.log('params:', params)
				res = await addOrder(params)
			}
			if(res.code == 200){
				// 记住本次下单/重拉起的待支付单与对应套餐：取消后再次支付时复用同一单
				// （走 goPayXcx），而不是重复下单触发「请勿重复支付」防重提示。
				orderNo.value = (res.data?.orderNo ?? orderNo.value) as string
				pendingPkgId.value = currentItem.pkgId
				console.log('添加订单成功:', res)

				if(isWechat()){
					toPay(res.data)
				}
				if(isH5()){
					console.log('H5支付:', res.data)

					if(res.data.payWxType == 'wechat_jsapi'){
						// 后端下单成功不再消费凭证（TTL 内可复用），支付成功后本地才清理
						const payResult = await invokeMpJsapiPay(res.data)
						if (payResult == PAY_STATUS_OK) {
							clearMpToken()
							uni.hideLoading()
							uni.redirectTo({
								url: '/pages/paySuccess/paySuccess?orderId=' + res.data.orderNo + '&payChannelId=' + res.data.payChannelId
							})
						} else if (payResult == PAY_STATUS_CANCEL) {
							// 用户主动取消：订单已落库（待支付），跳到订单详情让用户继续付
							uni.hideLoading()
							isInPaymentProcess.value = false
							uni.showToast({ title: t('payCanceled'), icon: 'none', duration: 1000 })
							setTimeout(() => {
								uni.redirectTo({
									url: '/pages/orderDetail/orderDetail?orderNo=' + res.data.orderNo
								})
							}, 800)
						} else if (payResult == PAY_STATUS_TIMEOUT) {
							// 可能已付款但未拿到回调：不判失败，引导去订单列表确认
							uni.hideLoading()
							isInPaymentProcess.value = false
							uni.showToast({ title: t('payConfirming'), icon: 'none', duration: 2000 })
							setTimeout(() => {
								uni.redirectTo({
									url: '/pages/orderDetail/orderDetail?orderNo=' + res.data.orderNo
								})
							}, 2000)
						} else if (payResult == PAY_STATUS_NOT_WECHAT) {
							handlePayFailed('请在手机微信中打开后支付')
						} else {
							handlePayFailed('支付调起失败，请重试')
						}
						return
					}
					if(res.data.payWxType == 'wechat_pay' || res.data.payWxType == 'allin_pay'){
						window.location.href = res.data.url
					}else{
						handleAlipayForm(res.data.url)
					}
				}
			} else if (res.code == 4601) {
				// 公众号凭证失效：清本地 token，强制重新静默授权（会跳转并回到本页）
				console.warn('[wxMpAuth] 后端判定凭证失效(4601)，重新静默授权')
				hidePayLoading()
				clearMpToken()
				if (await ensureWxMpAuth(cardDetail.value.rechargeNo, true)) {
					return
				}
				uni.showToast({
					title: res.msg || '公众号支付授权已失效，请重新进入页面',
					icon: 'none'
				})
			} else {
				hidePayLoading()
				uni.showToast({
					title: res.msg || '支付失败',
					icon: 'none'
				})
			}
		} catch (error) {
			console.error('创建订单失败:', error)
			hidePayLoading()
			uni.showToast({
				title: error.msg || '支付失败，请稍后重试',
				icon: 'none'
			})
		} finally {
			isSubmittingOrder.value = false
		}
	}

	const onPopupClose = () => {
		console.log('弹窗关闭');
	}

	const goBack = () => {
		// App 内 WebView 打开时，uni.navigateBack 无法关闭原生页面；
		// 改经 window.ZdiotApp 通道通知原生关闭 WebView，回到平台续费页。
		// 浏览器 / 微信等无该通道的环境，继续用 uni.navigateBack。
		const source = (uni.getStorageSync('h5EntrySource') as string | null) ?? ''
		if (source === 'app') {
			const w: any = window
			const bridge: any = w?.ZdiotApp
			if (bridge != null && bridge.postMessage != null) {
				bridge.postMessage(JSON.stringify({ type: 'close' }))
				return
			}
		}
		uni.navigateBack({
			delta: 1
		})
	}

	// 跳转我的套餐
	const toMyPackage = () => {
		console.log('跳转我的套餐:', cardDetail.value.rechargeNo)
		uni.navigateTo({
			url: '/pages/myPkg/myPkg?card_number=' + cardDetail.value.rechargeNo
		})
	}

	// 跳转订单记录
	const toOrderRecord = () => {
		// App 内 WebView 打开时把来源带给订单页：订单页据此隐藏右上角「我的反馈」。
		// 刷新会丢 URL 参数，故订单页同时用本地 h5EntrySource 兜底。
		const sourceSuffix = isFromApp.value ? '&source=app' : ''
		uni.navigateTo({
			url: '/pages/orderRecord/orderRecord?rechargeNo=' + cardDetail.value.rechargeNo + sourceSuffix
		})
	}

	/**
	 * 尝试跳到第三方 H5。
	 *
	 * 地址只取后端下发的 {@code externalH5RedirectUrl}（后端已做完开关判定、
	 * 协议白名单、防自跳与卡号拼接）：前端一旦自行用裸地址拼参，
	 * 就会绕过「启用外跳」开关，导致停用后仍在跳转。
	 *
	 * 由后端统一拼参并做开关/防自跳判定，前端只负责跳转，保证各端口径一致。
	 *
	 * @returns 已发起跳转返回 true；未配置或不可跳返回 false
	 *          （调用方据此判断本页是否需要渲染：跳转优先于渲染）
	 */
	const redirectToExternalH5 = (detail: RechargeData): boolean => {
		let redirected = false
		// #ifdef H5
		// 只认后端拼好的地址：开关停用、协议非法、防自跳被拦时后端一律不下发，
		// 前端不得再用裸地址自行拼参，否则会绕过「启用外跳」开关继续跳转
		const redirectUrl = detail.objectMap?.externalH5RedirectUrl
		if (!redirectUrl) {
			console.log('[externalH5] 后端未下发可跳转地址，按正常页面渲染；裸地址=', detail.objectMap?.externalH5Url)
			return false
		}
		try {
			const target = new URL(redirectUrl)
			if (target.protocol !== 'http:' && target.protocol !== 'https:') {
				console.error('第三方H5地址协议不受支持')
				return false
			}
			// 查到卡详情即跳转（与老系统一致）；replace 不保留本页历史，
			// 从第三方页面返回不会再次落回本页，因此无需再做去重
			console.log('[externalH5] 准备跳转：', target.toString())
			window.location.replace(target.toString())
			redirected = true
		} catch (error) {
			console.error('第三方H5地址无效:', error)
		}
		// #endif
		return redirected
	}

	const getCardDetail = async (cardNumber: string,country: string) => {
		// 空卡号直接拦死，不发请求：后端 /app/card/info/{cardNo} 的路径变量为空时会 404，
		// 过去只提示笼统的「获取卡片信息失败」，用户无从判断。
		// 典型触发：APP 下发的 H5 地址被拼坏（域名配置带了路径/参数），哈希路由错乱导致 rechargeNo 丢失。
		if (cardNumber == null || cardNumber.trim().length === 0) {
			h5RedirectPending.value = false
			console.error('[recharge] 缺少卡号参数，已终止查询；当前地址=', window.location.href)
			uni.showToast({
				title: t('cardNoMissing'),
				icon: 'none',
				duration: 3000
			})
			return
		}
		try {
			const res = await queryCardDetail(cardNumber, country,'0')
			if(res.code == 200){
				const detail = res.data as RechargeData
				cardDetail.value = detail
				if (detail.pkgXcxVos && detail.pkgXcxVos.length > 0) {
					classifyPackages(detail.pkgXcxVos as Array<PkgXcxVo>)
				}
				// 跳转优先于渲染：配了第三方 H5 就跳走（本页内容始终不渲染），否则放开渲染
				if (!redirectToExternalH5(detail)) {
					h5RedirectPending.value = false
				}
			}else{
				h5RedirectPending.value = false
			}
		} catch (error) {
			h5RedirectPending.value = false
			console.error('获取卡片详情失败:', error)
			uni.showToast({
				title: t('cardInfoFailed'),
				icon: 'none'
			})
		}
	}

	const handleBack = () => {
		// App 内 WebView 打开时页面栈只有一页，但 App 侧已隐藏原生导航栏，
		// 返回按钮由 H5 提供（点击经 window.ZdiotApp 通道关闭 WebView 回续费页），
		// 因此这里必须强制显示，不能按页面栈判断。
		if (isFromApp.value) {
			showBack.value = true
			return
		}
		const pages = getCurrentPages();
		if (pages.length > 1) {
			showBack.value = true
		}else{
			showBack.value = false
		}
	}

	const phoneList = computed<string[]>(() => splitServicePhones(customerServiceConfig.value))

	/**
	 * 客服配置：卡片详情 objectMap 下发（空 key = 未配置）。
	 *
	 * <p>本页可能是公众号/外部 H5，也可能是 App 内 WebView；「能不能跳企业微信客服」
	 * 由 common/customerService.uts 按环境判定，页面不做平台判断。</p>
	 */
	const customerServiceConfig = computed<CustomerServiceConfig>(() => {
		const map = cardDetail.value?.objectMap
		if (map == null) {
			return emptyCustomerService()
		}
		return {
			serviceJumpUrl: map.serviceJumpUrl ?? '',
			serviceCorpId: map.serviceCorpId ?? '',
			serviceKfidUrl: map.serviceKfidUrl ?? '',
			servicePhone: map.servicePhone ?? '',
			serviceQrcode: map.serviceQrcode ?? '',
			serviceTime: map.serviceTime ?? ''
		}
	})

	// 任一渠道有值才渲染客服入口（产品口径：全未配置则不展示客服 logo）
	const hasCustomerService = computed<boolean>(() => hasAnyChannel(customerServiceConfig.value))

	const checkToken = (): boolean => {
		const token = getToken()
		return !!token
	}

	const platform = async () => {
		if (isWechat()) {
			if (!checkToken()) {
				await getTenantInfos()

				// '0' = 需要授权手机号：跳转登录页授权，本页不再继续
				if (isPhoneLoginRequired()) {
					uni.login({
						provider: 'weixin',
						success: (res) => {
							userLoginByOpenid(res.code)
						},
						fail: (err) => {
							console.error('微信登录失败:', err)
							// 登录无法继续时兜底放开渲染，避免停在空白判定态
							h5RedirectPending.value = false
						}
					})
					return
				}

				// '1' = 免手机号：静默登录（成功后内部 reLaunch 回本页）
				const loggedIn = await getCode()
				if (!loggedIn) {
					h5RedirectPending.value = false
					uni.showToast({
						title: t('loginFailed'),
						icon: 'none'
					})
				}
			}else{
				getCardDetail(cardNumber.value, country.value)
			}
		}else{
			getCardDetail(cardNumber.value, country.value)
		}
	}

	/**
	 * 外跳优先级高于渲染：进页先探一次卡详情，只要配了第三方 H5 地址就直接跳走 ——
	 * 既不渲染本页内容，也不再走后续登录流程（外跳本身不需要登录）。
	 *
	 * 未配置（或探测失败）才放开渲染，并继续原有 platform() 登录/渲染流程。
	 */
	const redirectIfExternalH5Configured = async () => {
		// #ifdef H5
		// 空卡号时探不到卡详情，也不可能配出有效外跳地址，直接走正常渲染（由 getCardDetail 给出明确提示）
		if (cardNumber.value == null || cardNumber.value.trim().length === 0) {
			return
		}
		try {
			const res = await queryCardDetail(cardNumber.value, country.value, '0')
			if (res.code == 200 && redirectToExternalH5(res.data as RechargeData)) {
				return
			}
		} catch (error) {
			console.error('[externalH5] 外跳探测失败，按正常页面渲染:', error)
		}
		// 第三方外跳未命中才需要公众号授权：外跳站点不归我们管，不能先授权再跳走。
		// 非微信浏览器会直接返回 false（微信不支持外部跳转到公众号网页）
		if (await ensureWxMpAuth(cardNumber.value)) {
			return
		}
		// #endif
		h5RedirectPending.value = false
		platform()
	}

	const cardNumber = ref<string>('')
	const country = ref<string>('')

	// 二维码是 7 天有效的私有桶签名地址：加载失败时重新拉卡详情换一条新地址
	const refreshCustomerService = () => {
		void getCardDetail(cardNumber.value, country.value)
	}

	onLoad((options: UTSJSONObject) => {
		console.log('options:', options)
		const opt = options as any
		const cardNumberValue = opt.rechargeNo
		const countryValue = opt.country
		const from = opt.from
		const pkgId = opt.pkgId
		// 公众号授权回调带回的一次性凭证：存本地并抹掉地址栏参数
		consumeMpTokenFromQuery((opt.mpToken as string | null) ?? '')

		// 记录入口来源：App 内 WebView 打开时带 source=app。
		// 支付流程会 redirectTo 到 paySuccess，URL 参数会丢失，故存本地；
		// paySuccess 据此决定「回跳 App」还是「停留在 H5 结果页」。
		const entrySource = (opt.source as string | null) ?? ''
		if (entrySource === 'app') {
			uni.setStorageSync('h5EntrySource', 'app')
		} else {
			uni.removeStorageSync('h5EntrySource')
		}
		// App 来源：H5 顶部栏与返回按钮由本页提供（App 原生栏已隐藏）；
		// 刷新丢参数时用本地标记兜底
		const storedSource = (uni.getStorageSync('h5EntrySource') as string | null) ?? ''
		isFromApp.value = entrySource === 'app' || storedSource === 'app'

		// 保存默认的pkgId
		if (pkgId) {
			defaultPkgId.value = pkgId
		}

		handleBack()
		if (cardNumberValue) {
			cardNumber.value = cardNumberValue
			country.value = countryValue ?? ''
			// 跳转优先于渲染：先判外跳，配了就直接跳走，不再渲染本页内容
			redirectIfExternalH5Configured()
		} else {
			h5RedirectPending.value = false
			console.error('未获取到卡片号码')
			uni.showToast({
				title: t('cardNotExist'),
				icon: 'none'
			})
		}
	})

	const code = ref<string>('')
	//需要手机号模式：先用 openid 换 userId，再跳转手机号授权登录页
	const userId = ref<string>('')
	const userLoginByOpenid = async (codes: string) => {
		console.log('recharge,,userLoginByOpenid:', codes)
		try {
			const res = await login({
				xcxCode: codes,
				isLogin: '1',
			})
			console.log('recharge,,userLoginByOpenid登录:', res)
			if(res.code == 200){
				userId.value = '' + res.data.id
				setStorageSync('userId', userId.value)
				uni.navigateTo({
					url: '/pages/login/login?userId=' + userId.value + '&from=recharge' + '&rechargeNo=' + cardNumber.value
				})
			}
		} catch (error) {
			console.error('获取用户信息失败:', error)
		}
	}
	//免手机号模式：openid 静默登录
	const getCode = async (): Promise<boolean> => {
		return new Promise((resolve) => {
			uni.login({
				provider: 'weixin',
				success: (res) => {
					code.value = res.code
					login({
						isLogin: '1',
						xcxCode: code.value,
					}).then((loginRes) => {
						if(loginRes.code == 200){
							console.log('登录成功:', loginRes.data.access_token)
							setToken(loginRes.data.access_token, loginRes.data.refreshToken)
							resolve(true)
							uni.reLaunch({
								url: '/pages/recharge/recharge?rechargeNo=' + cardNumber.value
							})
						} else {
							resolve(false)
						}
					}).catch(() => {
						resolve(false)
					})
				},
				fail: (err) => {
					console.error('微信登录失败:', err)
					resolve(false)
				}
			})
		})
	}
	// 获取租户页面配置（含手机号登录开关）
	const getTenantInfos = async () => {
		try {
			// H5 不看 appid/租户，只按当前卡号定位租户；小程序端该参数忽略，仍按 appId 解析
			const res = await getTenantInfo(getTenantId(), false, cardNumber.value)
			if(res.code == 200){
				// 约定：'1' = 免手机号；'0' = 需要授权手机号
				setWxGetPhoneLogin(res.data.wxGetPhoneLogin)
			}
		} catch (error) {
			// 请求失败时沿用本地缓存，避免被误判为“需要手机号”
			console.error('获取租户配置失败，沿用本地缓存:', error)
		}
	}



	onShow(() => {
		const options = uni.getEnterOptionsSync();
		console.log('options.scene:', options.scene)
		// 1011扫描二维码  1012长按图片识别二维码  1013相册选择二维码 1037小程序打开小程序 1038 从另一个小程序返回
		// 只有在支付流程中才处理支付回调
		if (!isInPaymentProcess.value) {
			return
		}
		// scene 为数字类型，必须统一按数字比较，否则回调分支永远不会执行
		if (Number(options.scene) != 1038) {
			return
		}
		// 从收银台小程序返回时，来源小程序 appId 应与配置的收银台 appId 一致
		// （旧口径拿自身 appid 比对，收银台 appid 与自身不同后该判定永远不成立）
		const referrerInfo = options.referrerInfo
		if (referrerInfo == null) {
			return
		}
		const expectedAppId = cashierAppId.value.length > 0 ? cashierAppId.value : config.api.auth.appID
		if (referrerInfo.appId != expectedAppId) {
			return
		}
		// 代表从收银台小程序返回
		let extraData = referrerInfo.extraData;
		if (!extraData) {
			uni.hideLoading()
			uni.showToast({
				title: t('payCanceledRetry'),
				icon: 'none',
				duration: 1000
			});
			// 重置支付流程标记
			isInPaymentProcess.value = false
			return
		} else {
			if (extraData.code == 'success') {
				uni.hideLoading()
				uni.showToast({
					title: t('paySuccess'),
					icon: 'success',
					duration: 1000,
					success() {
						// 重置支付流程标记
						isInPaymentProcess.value = false
						// 使用 redirectTo 替换当前页面，避免页面栈累积
						uni.redirectTo({
							url: '/pages/paySuccess/paySuccess?orderId=' + orderNo.value + '&payChannelId=' + payChannelId.value
						})
					}
				});
			} else if (extraData.code == 'cancel') {
				uni.hideLoading()
				uni.showToast({
					title: t('payCanceledRetry'),
					icon: 'none',
					duration: 1000
				});
				// 重置支付流程标记
				setTimeout(() => {
					uni.reLaunch({
						url: '/pages/orderDetail/orderDetail?orderNo=' + orderNo.value
					});
				}, 1000);
				isInPaymentProcess.value = false
				return
			} else {
				uni.hideLoading()
				uni.showToast({
					title: t('payFailedRetry'),
					icon: 'none',
					duration: 1000
				});
				// 重置支付流程标记
				isInPaymentProcess.value = false
				return
			}
		}
	})

</script>

