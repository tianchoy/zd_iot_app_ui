<template>
	<!-- #ifndef MP-WEIXIN -->
	<topNavBar title="查询卡号" :show-back="false" textColor="#333" :showCapsule="false"></topNavBar>
	<!-- #endif -->
	<view class="container">
		<!-- 候选展开时的全屏遮罩：点空白处收起。刻意不用 blur 收起，避免与候选点击抢时序。
		     必须带上 visibleHistory.length 判断：模糊联想无匹配时不显示遮罩，否则会凭空挡住整页点击 -->
		<view v-if="showHistory && visibleHistory.length > 0" class="history-mask" @click="closeHistory"></view>
		<view class="main-content">
			<!-- 标题区域 -->
			<view class="title-section">
				<text class="main-title">快捷充值</text>
				<text class="sub-title">输入卡号，快速查询缴费</text>
				<text class="desc-text">支持短信链接、二维码、APP跳转进入H5页面，未登录</text>
				<text class="desc-text">也可直接充值。</text>
			</view>
			
			<!-- 卡号查询卡片 -->
			<view class="card-box">
				<view class="card-label">卡号查询</view>
				<view class="search-tips">请输入卡号,或点击输入框右侧扫描图标识别卡号</view>
				<view class="search-value">
					<input
						v-model="cardNumber"
						placeholder="请输入卡号,或扫描图标识别卡号"
						class="search-input"
						@input="handleInput"
						@focus="handleInputFocus"
					/>
					<view class="scan-btn" @click="handleScan">
						<rice-icon name="scan" size="40rpx" color="#666"></rice-icon>
					</view>
					<!-- 历史卡号候选：点选只填入，不自动查询。
					     刻意不用 scroll-view + 动态 rpx 高度：H5 端 :style 里的 rpx 不参与编译转换会失效，
					     整块高度变 0 就看不见了；这里直接按行铺开，最多展示前 5 条 -->
					<view class="history-panel" v-if="showHistory && visibleHistory.length > 0">
						<view
							v-for="(item, index) in visibleHistory"
							:key="index"
							class="history-item"
							@click="handleHistorySelect(item)"
						>
							<text class="history-text">{{ item }}</text>
						</view>
					</view>
				</view>
				
				<!-- 选择国家/地区 -->
				<view class="select-country-wrapper" v-if="isINT()">
					<view class="select-label">选择国家/地区</view>
					<view class="select-trigger" @tap="openSelectCountry">
						<text class="select-value" :class="{ placeholder: !selectedCountry }">
							{{ selectedCountryLabel || '请选择国家/地区' }}
						</text>
						<text class="select-arrow">▼</text>
					</view>
				</view>
				
				<view class="query-btn" @click="handleQuery">
					<text class="query-btn-text">查询缴费</text>
				</view>
			</view>
			
			<!-- 使用说明 -->
			<view class="instruction-box">
				<view class="instruction-title">使用说明</view>
				<view class="instruction-list">
					<text class="instruction-item">1.H5支持未登录快速充值。</text>
					<text class="instruction-item">2.APP跳转场景可直接进入充值首页，无需经过本入口页。</text>
				</view>
			</view>
		</view>
	</view>
	
	<!-- 底部弹窗 -->
	<rice-popup
		v-model:show="showCountryPopup"
		position="bottom"
		@close="onPopupClose"
	>
		<view class="popup-header">
			<text class="popup-title">选择国家/地区</text>
		</view>
		
		<SearchSelect
			ref="searchSelectRef"
			v-model="selectedCountry"
			:options="countryOptions"
			maxHeight="800rpx"
			minHeight="800rpx"
			search-placeholder="搜索国家/地区名称"
			@change="onCountryChange"
		/>
	</rice-popup>
</template>

<script setup lang="uts">
	import { ref, computed, onMounted, onUnmounted } from 'vue'
	import SearchSelect from '@/components/selectCountry.uvue'
	import { getCountryList,queryVerify } from '@/api/http.uts'
	import type { CountryData } from '@/api/types.uts'
	import {isINT,isCN} from '@/common/config.uts'
	import { CardNoHistory } from '@/utils/cardNoHistory.uts'
	
	const cardNumber = ref<string>('')
	
	// 卡号历史（最新在前）与候选面板显隐
	const historyList = ref<string[]>([])
	const showHistory = ref(false)

	// 候选最多展示条数（历史本身最多 10 条，下拉只列最近 5 条，避免浮层过高）
	const MAX_VISIBLE_HISTORY: number = 5
	// 模糊联想：按输入内容从历史里挑出匹配项（前缀优先，其次包含），输入为空则不联想
	const visibleHistory = computed<string[]>(() => {
		return CardNoHistory.match(historyList.value, cardNumber.value, MAX_VISIBLE_HISTORY)
	})
	
	// 国家/地区相关
	const showCountryPopup = ref<boolean>(false)
	const selectedCountry = ref<string>('')
	const searchSelectRef = ref(null)
	const resCountry = ref<string>('')
	
	// 国家/地区选项列表
	const countryOptions = ref<UTSJSONObject[]>([])
	
	// 显示选中的国家/地区标签
	const selectedCountryLabel = computed<string>(() : string => {
		if (!selectedCountry.value) return ''
		for (let i = 0; i < countryOptions.value.length; i++) {
			const opt = countryOptions.value[i] as UTSJSONObject
			if (opt['value'] === selectedCountry.value) {
				const label = opt['label']
				return label == null ? '' : '' + label
			}
		}
		return ''
	})
	
	// 打开国家/地区选择弹窗
	const openSelectCountry = () => {
		showCountryPopup.value = true
	}
	
	// 国家/地区选择变化
	const onCountryChange = (value: string | number | null, item: any) => {
		// console.log('选中国家/地区:', value, item)
		showCountryPopup.value = false
		resCountry.value = value as string
		console.log('选中国家/地区:', resCountry.value)
	}
	
	// 关闭弹窗时重置搜索
	const onPopupClose = () => {
		showCountryPopup.value = false
	}

	// 验证卡片是否有效
	const CardVerify = async (id: string): Promise<boolean> => {
		try {
			const res = await queryVerify(id)
			if (res.code == 200) {
				if (res.data) {
					return true
				} else {
					uni.showToast({
						title: '卡号无效',
						icon: 'none'
					})
					return false
				}
			} else {
				uni.showToast({
					title: res.msg || '验证失败',
					icon: 'none'
				})
				return false
			}
		} catch (error) {
			uni.showToast({
				title: error.msg || '卡号无效',
				icon: 'none'
			})
			return false
		}
	}
	
	// 扫码
	const handleScan = () => {
		uni.navigateTo({
			url: '/pages/scanCode/scanCode'
		})
	}

	// 输入框内容变化：清空时收起候选；有内容时（且存在历史）展开
	const handleInput = () => {
		if (cardNumber.value.trim().length === 0) {
			showHistory.value = false
			return
		}
		if (historyList.value.length === 0) {
			historyList.value = CardNoHistory.list()
		}
		if (historyList.value.length > 0) {
			showHistory.value = true
		}
	}

	// 输入框获得焦点：只在「输入框有内容」且「有历史」时才展开候选
	const handleInputFocus = () => {
		const list = CardNoHistory.list()
		historyList.value = list
		const inputLength = cardNumber.value.trim().length
		showHistory.value = inputLength > 0 && list.length > 0
	}

	// 点选历史卡号：只填入并收起，不自动查询/跳转（跳转不可逆，保留用户手动点「查询缴费」）
	const handleHistorySelect = (cardNo: string) => {
		cardNumber.value = cardNo
		showHistory.value = false
	}

	// 收起候选（点遮罩时触发）
	const closeHistory = () => {
		showHistory.value = false
	}

	// 回填最近一次查询过的卡号：仅在输入框为空时填，避免覆盖用户正在输入的内容
	const fillLatestCardNo = () => {
		const list = CardNoHistory.list()
		historyList.value = list
		if (cardNumber.value.trim().length > 0) return
		if (list.length === 0) return
		cardNumber.value = list[0]
	}
	
	// 查询缴费
	const handleQuery = async () => {
		const keyword = cardNumber.value.trim()
		if (!keyword) {
			uni.showToast({
				title: '请输入卡号',
				icon: 'none'
			})
			return
		}
		if (isINT() && !selectedCountry.value) {
			uni.showToast({
				title: '请选择国家/地区',
				icon: 'none'
			})
			return
		}
		uni.showToast({
			title: '查询中...',
			icon: 'loading'
		})
		const isValid = await CardVerify(keyword)
		if (isValid) {
			// 只在校验通过、即将跳转时写入历史，输错的卡号不会被记住
			CardNoHistory.record(keyword)
			historyList.value = CardNoHistory.list()
			showHistory.value = false
		}
		// 跳转到充值页面
		if(isCN() && isValid){
			uni.navigateTo({
				url: `/pages/recharge/recharge?rechargeNo=${keyword}&from=h5Search`
			})
		}
		if(isINT() && isValid){
			uni.navigateTo({
				url: `/pages/recharge/recharge?rechargeNo=${keyword}&country=${selectedCountry.value}&from=h5Search`
			})
		}
		
	}
	
	// 监听扫码结果
	const onScanResult = (data: UTSJSONObject) => {
		const result = data.getString('result') ?? ''
		if (result.length > 0) {
			cardNumber.value = result
			showHistory.value = false
			uni.showToast({
				title: '扫码成功',
				icon: 'success'
			})
		}
	}

	// 初始化国家列表
	const initCountryList = async () => {
		const res = await getCountryList(false)
		console.log('查询国家列表:', res)
		if (res.code == 200) {
			countryOptions.value = res.data.map((item: CountryData): UTSJSONObject => {
				return {
					value: item.letterCode,
					label: item.fullName
				} as UTSJSONObject
			})
		}
	}
	
	onMounted(() => {
		if(isINT()){
			initCountryList()
		}
		uni.$on('scanResult', onScanResult)
	})
	
	// 每次显示都回填一次：从充值页返回时同样生效（仅在输入框为空时填，不会覆盖用户输入）
	onShow(() => {
		fillLatestCardNo()
	})
	
	onUnmounted(() => {
		uni.$off('scanResult', onScanResult)
	})
</script>

<style lang="scss" scoped>
	.container {
		display: flex;
		flex-direction: column;
		// #ifdef MP-WEIXIN || H5
		min-height: 100%;
		// #endif
		background-color: #f5f7fa;
		// uni-app x 给 view 的默认样式是 overflow:hidden，会把溢出父盒子的历史候选浮层整个裁掉
		// （DOM 有、尺寸也对，就是看不见）。这里连同 .main-content / .card-box / .search-value 一起放开
		overflow: visible;

		// 历史候选展开时的全屏透明遮罩：承载「点浮层外部收起」。
		// z-index 低于候选浮层(200)、高于页面内容，不依赖 blur 事件
		.history-mask {
			position: fixed;
			top: 0;
			left: 0;
			right: 0;
			bottom: 0;
			z-index: 90;
		}
	}
	
	.main-content {
		display: flex;
		flex-direction: column;
		padding:0 24rpx;
		// 同上：候选浮层会穿过本层，禁止裁剪
		overflow: visible;
	}
	
	// 标题区域
	.title-section {
		display: flex;
		flex-direction: column;
		margin-bottom: 48rpx;
		background: linear-gradient(135deg, #2563eb 0%, #60a5fa 100%);
		border-radius: 22rpx;
		padding: 24px 20rpx;
		color: #fff;
		
		.main-title {
			font-size: 24rpx;
			font-weight: bold;
			margin-bottom: 16rpx;
		}
		
		.sub-title {
			font-size: 50rpx;
			font-weight: bold;
			margin-bottom: 24rpx;
		}
		
		.desc-text {
			font-size: 24rpx;
		}
	}
	
	// 卡号查询卡片
	.card-box {
		display: flex;
		flex-direction: column;
		background-color: #ffffff;
		border: 1rpx solid #e2e8f0;
		border-radius: 32rpx;
		padding: 32rpx;
		margin-bottom: 48rpx;
		box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
		// 同上：候选浮层挂在搜索行下方，会溢出本卡片，禁止裁剪
		overflow: visible;
		
		.card-label {
			font-size: 32rpx;
			font-weight: 600;
			color: #1f2937;
			margin-bottom: 10rpx;
		}

		.search-tips{
			font-size: 20rpx;
			color: #64748b;
			margin-bottom: 24rpx;
		}
		
		.search-value {
			position: relative;
			// z-index 低于候选浮层(200)、高于全屏遮罩(90)：遮罩只负责「点空白收起」，不能盖住输入行
			z-index: 91;
			// 关键：候选浮层用 position:absolute + top:100% 挂在本行盒子之外，
			// 本行若沿用 uni-view 默认的 overflow:hidden，浮层会被整块裁掉（有 DOM 但看不见）
			overflow: visible;
			display: flex;
			flex-direction: row;
			align-items: center;
			border: 2rpx solid #e5e7eb;
			border-radius: 24rpx;
			background-color: #f9fafb;
			margin-bottom: 24rpx;
			
			.search-input {
				flex: 1;
				padding: 24rpx 28rpx;
				height: 88rpx;
				border: none;
				background: transparent;
				color: #1f2937;
				font-size: 28rpx;
			}
			
			.scan-btn {
				display: flex;
				flex-direction: row;
				align-items: center;
				justify-content: center;
				width: 88rpx;
				height: 88rpx;
				border-left: 2rpx solid #e5e7eb;

			}

			// 历史卡号候选浮层：挂在整个搜索行下方，宽度与搜索行对齐
			.history-panel {
				position: absolute;
				left: 0;
				right: 0;
				top: 100%;
				margin-top: 8rpx;
				z-index: 200;
				background-color: #ffffff;
				border: 2rpx solid #e5e7eb;
				border-radius: 16rpx;
				box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.12);
				overflow: hidden;

				.history-item {
					display: flex;
					flex-direction: row;
					align-items: center;
					height: 96rpx;
					padding: 0 28rpx;
					box-sizing: border-box;
					border-bottom: 2rpx solid #f1f5f9;

					&:active {
						background-color: #f5f7fa;
					}

					&:last-child {
						border-bottom: none;
					}

					.history-text {
						flex: 1;
						font-size: 28rpx;
						color: #334155;
						line-height: 1.4;
					}
				}
			}
		}
		
		// 选择国家/地区样式
		.select-country-wrapper {
			margin-bottom: 32rpx;
			
			.select-label {
				font-size: 28rpx;
				color: #666;
				margin-bottom: 16rpx;
			}
			
			.select-trigger {
				display: flex;
				flex-direction: row;
				align-items: center;
				justify-content: space-between;
				border: 2rpx solid #e5e7eb;
				border-radius: 24rpx;
				background-color: #f9fafb;
				padding: 24rpx 28rpx;
				min-height: 88rpx;
				
				.select-value {
					flex: 1;
					font-size: 28rpx;
					color: #1f2937;
					
					&.placeholder {
						color: #999;
					}
				}
				
				.select-arrow {
					font-size: 24rpx;
					color: #999;
					margin-left: 16rpx;
				}

			}
		}
		
		.query-btn {
			display: flex;
			flex-direction: row;
			align-items: center;
			justify-content: center;
			background: linear-gradient(135deg, #2563eb, #1d4ed8);
			border-radius: 24rpx;
			padding: 20rpx 0;
			
			.query-btn-text {
				color: #ffffff;
				font-size: 32rpx;
				font-weight: 600;
			}

		}
	}
	
	// 使用说明
	.instruction-box {
		display: flex;
		flex-direction: column;
		background: #fff;
		border: 1rpx solid #e2e8f0;
		border-radius: 18rpx;
		padding: 24rpx;
		box-shadow: 0 8rpx 20rpx rgba(15, 23, 42, .04);
		
		.instruction-title {
			font-size: 30rpx;
			font-weight: 600;
			color: #1f2937;
			margin-bottom: 24rpx;
		}
		
		.instruction-list {
			display: flex;
			flex-direction: column;
			
			.instruction-item {
				font-size: 26rpx;
				color: #6b7280;
				line-height: 1.6;
			}
		}
	}
	
	// 弹窗头部样式
	.popup-header {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		padding: 32rpx 32rpx 16rpx;
		border-bottom: 2rpx solid #f0f0f0;
		background-color: #ffffff;
		
		.popup-title {
			font-size: 32rpx;
			font-weight: 600;
			color: #1f2937;
		}
		
		.popup-close {
			width: 56rpx;
			height: 56rpx;
			display: flex;
			flex-direction: row;
			align-items: center;
			justify-content: center;
			font-size: 44rpx;
			color: #999;

		}
	}
</style>
