<template>
	<!-- #ifndef MP-WEIXIN -->
	<topNavBar title="支付结果" :show-back="false" backgroundColor="#f4f7fb" textColor="#333" :showCapsule="false"></topNavBar>
	<!-- #endif -->
	<view class="container">
		<!-- 失败状态区域 -->
		<view class="status-section">
			<view class="fail-icon">
				<text class="close-icon">✕</text>
			</view>
			<text class="status-text">支付失败</text>
			<text class="fail-tip">{{ tipText }}</text>
		</view>

		<!-- 卡片详情区域：仅展示实际传入的字段，避免展示假数据 -->
		<view class="card-container">
			<!-- 卡号 -->
			<view class="info-row" v-if="ds('rechargeNo')">
				<text class="label">卡号</text>
				<text class="value">{{ ds('rechargeNo') }}</text>
			</view>
			
			<!-- ICCID -->
			<view class="info-row" v-if="ds('iccid')">
				<text class="label">ICCID</text>
				<text class="value">{{ ds('iccid') }}</text>
			</view>
			
			<!-- 订单编号 -->
			<view class="info-row" v-if="ds('orderNo')">
				<text class="label">订单编号</text>
				<text class="value">{{ ds('orderNo') }}</text>
			</view>
			
			<!-- 套餐名称 -->
			<view class="info-row" v-if="ds('pkgName')">
				<text class="label">套餐名称</text>
				<text class="value">{{ ds('pkgName') }}</text>
			</view>
			
			<!-- 套餐类型 -->
			<view class="info-row" v-if="ds('pkgCategory')">
				<text class="label">套餐类型</text>
				<text class="value">{{ ds('pkgCategory') }}</text>
			</view>
			
			<!-- 支付方式 -->
			<view class="info-row" v-if="ds('payType')">
				<text class="label">支付方式</text>
				<text class="value">{{ ds('payType') }}</text>
			</view>
			
			<!-- 支付金额 -->
			<view class="info-row" v-if="ds('payAmount')">
				<text class="label">支付金额</text>
				<text class="value amount">￥{{ ds('payAmount') }}</text>
			</view>
			
			<!-- 失败原因 -->
			<view class="info-row fail-reason" v-if="ds('reason')">
				<text class="label">失败原因</text>
				<text class="value fail-reason-text">{{ ds('reason') }}</text>
			</view>

			<!-- 无订单信息时的兜底提示 -->
			<view class="info-row" v-if="!hasDetail">
				<text class="value fail-reason-text">暂无可展示的订单信息，请到订单列表查看</text>
			</view>
		</view>
		
		<!-- 按钮区域 -->
		<view class="button-section">
			<button class="action-btn primary-btn" @click="handleRetryPay">重新支付</button>
			<button class="action-btn secondary-btn" @click="handleBackCard">返回卡片详情</button>
		</view>
	</view>
</template>

<script setup lang="uts">
	const orderId = ref<string>('')
	const rechargeNo = ref<string>('')
	const detail = ref<any>({})

	/** 模板中安全访问订单属性 */
	function ds(key: string): string {
		const val = (detail.value as UTSJSONObject)[key]
		return val != null ? '' + val : ''
	}

	// 失败提示：优先使用传入的失败原因
	const tipText = computed<string>(() => {
		const reason = ds('reason')
		return reason !== '' ? reason : '订单尚未支付，请重新尝试'
	})

	// 是否拿到可展示的订单信息
	const hasDetail = computed<boolean>(() => ds('orderNo') !== '' || ds('rechargeNo') !== '')

	// 重新支付：回到订单详情，由用户再次发起支付
	const handleRetryPay = () => {
		if (!orderId.value) {
			uni.showToast({
				title: '订单号缺失，请到订单列表重试',
				icon: 'none'
			})
			return
		}
		uni.redirectTo({
			url: '/pages/orderDetail/orderDetail?orderNo=' + orderId.value
		})
	}
	
	// 返回卡片详情点击处理
	const handleBackCard = () => {
		if (!rechargeNo.value) {
			uni.showToast({
				title: '卡号缺失，请返回首页查看',
				icon: 'none'
			})
			return
		}
		uni.reLaunch({
			url: '/pages/cardDetail/cardDetail?cardNumber=' + rechargeNo.value
		})
	}

	onLoad((options: UTSJSONObject) => {
		const oid = options['orderNo'] as string
		orderId.value = oid != null ? oid : ''
		const rn = options['rechargeNo'] as string
		rechargeNo.value = rn != null ? rn : ''

		// 仅收集实际传入的字段，未传的字段不展示
		const params: UTSJSONObject = {}
		const keys = ['orderNo', 'rechargeNo', 'iccid', 'pkgName', 'pkgCategory', 'payType', 'payAmount', 'reason']
		for (let i = 0; i < keys.length; i++) {
			const key = keys[i]
			const value = options[key]
			if (value != null && '' + value !== '') {
				params[key] = value
			}
		}
		detail.value = params
	})
</script>

<style lang="scss" scoped>
	.container {
		min-height: 1000rpx;
		padding: 40rpx 32rpx;
		display: flex;
		flex-direction: column;
		box-sizing: border-box;
	}
	
	// 失败状态区域
	.status-section {
		display: flex;
		flex-direction: column;
		align-items: center;
		margin-bottom: 40rpx;
		
		.fail-icon {
			width: 120rpx;
			height: 120rpx;
			background-color: #f56c6c;
			border-radius: 50%;
			display: flex;
			flex-direction: row;
			align-items: center;
			justify-content: center;
			margin-bottom: 20rpx;
			
			.close-icon {
				color: #ffffff;
				font-size: 80rpx;
				font-weight: 600;
				line-height: 1;
			}
		}
		
		.status-text {
			font-size: 40rpx;
			font-weight: 500;
			color: #333333;
			margin-bottom: 16rpx;
		}
		
		.fail-tip {
			font-size: 26rpx;
			color: #f56c6c;
		}
	}
	
	// 卡片容器
	.card-container {
		background-color: #ffffff;
		border: 1px solid #e7edf5;
		border-radius: 24rpx;
		padding: 32rpx;
		margin-bottom: 60rpx;
		box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
	}
	
	// 信息行
	.info-row {
		display: flex;
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		padding: 24rpx 0;
		border-bottom: 1rpx solid #f0f0f0;

		
		.label {
			font-size: 24rpx;
			color: #64748b;
			flex-shrink: 0;
			width: 160rpx;
		}
		
		.value {
			font-size: 25rpx;
			color: #0f172a;
			font-weight: bold;
			text-align: right;
			flex: 1;
		}

		.amount {
			font-weight: bold;
			color: #ff6b00;
		}
		
		&.fail-reason {
			margin-top: 8rpx;
			padding-top: 16rpx;
			
			.fail-reason-text {
				color: #f56c6c;
				font-weight: normal;
			}
		}
	}
	
	// 按钮区域
	.button-section {
		display: flex;
		flex-direction: column;
		
		.action-btn {
			width: 100%;
			height: 88rpx;
			line-height: 88rpx;
			border-radius: 44rpx;
			font-size: 30rpx;
			font-weight: 500;
			text-align: center;
			border: none;
			padding: 0;
			
			&::after {
				border: none;
			}
		}
		
		.primary-btn {
			background-color: #f56c6c;
			color: #ffffff;
		}
		
		.secondary-btn {
			background-color: #ffffff;
			color: #f56c6c;
			border: 2rpx solid #f56c6c;
		}
	}
</style>
