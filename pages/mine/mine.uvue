<template>
	<topNavBar title="我的" :show-back="false" backgroundColor="#f4f7fb" textColor="#333" :showCapsule="false"></topNavBar>
	<view class="container">
		
		<view class="card-info mb-24">
			<view class="persion-card">
				<view class="persion-card-item">
					<text class="persion-card-item-title">我的卡片</text>
					<text class="persion-card-item-content"> {{ cardListSum.all != null ? cardListSum.all : 0 }}</text>
				</view>
				<view class="persion-card-item">
					<text class="persion-card-item-title">在用卡片</text>
					<text class="persion-card-item-content"> {{ cardListSum.inUse != null ? cardListSum.inUse : 0 }}</text>
				</view>
				<view class="persion-card-item">
					<text class="persion-card-item-title">异常卡片</text>
					<text class="persion-card-item-content"> {{ cardListSum.inNotUse != null ? cardListSum.inNotUse : 0 }}</text>
				</view>
			</view>
		</view>
		<view class="card-box">
			<view class="item"  @click="toOrder">
				<text class="order-label">我的订单</text>
				<rice-icon name="arrow-right" size="20rpx"></rice-icon>
			</view>
			<view class="item" v-if="false">
				<text class="order-label">绑定卡片</text>
				<rice-icon name="arrow-right" size="20rpx"></rice-icon>
			</view>
			<view class="item" v-if="false">
				<text class="order-label">常见问题</text>
				<rice-icon name="arrow-right" size="20rpx"></rice-icon>
			</view>
		</view>
		<view class="btn-box" v-if="isWechatEnv">
			<rice-button v-if="isLoginState" type="primary" width="100%" shape="round" @click="handleLogin">登录</rice-button>
			<rice-button v-else-if="getStorageSync('usePhoneNumber')" type="error" width="100%" shape="round"  @click="handleLogout">退出登录</rice-button>
		</view>
		<!-- 页脚备案号：合规展示项，匿名接口未登录也可查看。
		     logo 与小程序名称改由登录页 / 导航栏展示，本页不再重复；
		     网安备案小程序与公众号不需要，故不展示。
		     备案号为空时整块隐藏（有则展示、没有就不占位）。 -->
		<view class="icp-footer" v-if="platformInfo?.icpNo">
			<text class="icp-label">ICP备案</text>
			<text class="icp-value">{{ platformInfo.icpNo }}</text>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref, computed } from 'vue'
	import { login,getTenantInfo,queryCardListSum,getPlatformInfo} from '@/api/http.uts'
	import type { CardListSumData, PlatformInfoData } from '@/api/types.uts'
	import { getStorageSync,getTenantId,getToken ,clearToken,removeStorageSync,isWechat,config,setToken,setStorageSync} from '@/common/config.uts'


	const title = ref('用户');
	const wxGetPhoneLogin = ref<string>('')
	const isWechatEnv = computed<boolean>(() => isWechat())
	

	const checkToken = (): boolean => {
		const token = getToken()
		return !!token
	}
	const isLoginState = computed<boolean>(() => !checkToken())

	// 检查是否登录
	const isLogin = (): boolean => {
		if (!checkToken()) {
			uni.showToast({
				title: '请先登录',
				icon: 'none'
			})
			return false
		}
		return true
	}

	// 跳转订单记录
	const toOrder = () => {
		if (!isLogin()) return
		uni.navigateTo({
			url: '/pages/myOrder/myOrder'
		})
	}

	//登录
	const userId = ref<string>('')
	const userLoginByOpenid = async (codes: string) => {
		console.log('userLoginByOpenid:', codes)
		const res = await login({
			xcxCode: codes,
			isLogin: '1',
		})
		
		if(res.code == 200){
			userId.value = '' + res.data.id
			setStorageSync('userId', userId.value)
			uni.navigateTo({
				url: '/pages/login/login?wxGetPhoneLogin=' + wxGetPhoneLogin.value + '&userId=' + userId.value
			})
		}
	}

	//获取 code
	const code = ref<string>('')
	const getCode = async () => {
		uni.login({
			success: (res) => {
				code.value = res.code
				console.log('wxGetPhoneLogin:', wxGetPhoneLogin.value)
				if( wxGetPhoneLogin.value == '1'){
					const params = {
						isLogin: "1",
						xcxCode: code.value,
					}
					login(params).then((res) => {
						if(res.code == 200){
							console.log('登录成功:', res.data.access_token)
							// 小程序静默登录成功后必须落库 token，否则后续接口仍以游客身份请求
							setToken(res.data.access_token, res.data.refreshToken)
							uni.reLaunch({
								url: '/pages/card/card'
							})
						}
					})
				}else{
					userLoginByOpenid(res.code);
				}
			}
		})
	}

	// 获取租户页面配置
	const getTenantInfos = async () => {
		const res = await getTenantInfo(getTenantId(),false)
		if(res.code == 200){
			const tenantInfo = res.data
			console.log('tenantInfo:', tenantInfo)
			wxGetPhoneLogin.value = '' + tenantInfo.wxGetPhoneLogin
			setStorageSync('wxGetPhoneLogin', tenantInfo.wxGetPhoneLogin)
		}
	}

	const handleLogin = () => {
		const token = getToken()
		if(!token){
			getTenantInfos().then(() => {
				getCode()
			})
		}
	}

	// 退出登录
	const handleLogout = () => {
		clearToken()
		removeStorageSync('usePhoneNumber')
		uni.showToast({
			title: '退出登录成功',
			icon: 'none'
		})
		uni.reLaunch({
			url: '/pages/card/card'
		})
	}

	// 查询卡列表统计
	const cardListSum = ref<CardListSumData>({ all: 0, inUse: 0, inNotUse: 0 })
	const getCardListSum = async () => {
		try {
			const res = await queryCardListSum()
			if (res.code === 200) {
				cardListSum.value = res.data
			}
		} catch (error) {
			console.error('查询卡列表统计异常:', error)
		}
	}

	// 平台品牌与备案信息：匿名接口，未登录也要展示（备案号属合规展示项）
	const platformInfo = ref<PlatformInfoData>({
		tenantId: '',
		platformName: '',
		platformLogoUrl: '',
		platformCopyright: '',
		icpNo: '',
		cybersecurityNo: ''
	})
	const getPlatformInfoData = async () => {
		try {
			const res = await getPlatformInfo(getTenantId())
			if (res.code === 200 && res.data != null) {
				platformInfo.value = res.data
			}
		} catch (error) {
			console.error('查询平台信息异常:', error)
		}
	}

	onShow(() => {
		// 平台信息先加载：与登录态无关
		getPlatformInfoData()
		if (isWechat()) {
			if (!checkToken()) return;
		}
		getCardListSum()
	})
</script>

<style lang="scss" scoped>
.container{
	display: flex;
	flex-direction: column;
	// 只占「导航栏占位之后」的剩余空间：flex:1 由父级（页面根）按剩余高度分配。
	// 原来写的是 min-height: 100%，而 100% 是【整页高度】——topNavBar 已经额外占位了
	// 状态栏 + 导航栏（默认 20 + 44px），两者相加必然比可视区高出一个导航栏，
	// 于是无论内容多少都会出现纵向滚动条。
	flex: 1;
	background-color: #f4f7fb;
	// 给固定在底部的备案号留出位置，长内容滚动时不会被它盖住
	padding-bottom: 60rpx;
	.card-info{
		display: flex;
		flex-direction: column;
		padding: 24rpx;
		margin: 0 24rpx;
		border: none;
		border-radius: 24rpx;
		background: linear-gradient(135deg, #2f6de8 0%, #4d88f5 65%, #67a4ff 100%);
		color: #ffffff;
		box-shadow: 0 8rpx 18rpx rgba(37, 99, 235, 0.14);
		.persion-name{
			font-size: 30rpx;
			font-weight: bold;
			color: #ffffff;
		}
		.persion-card{
			display: flex;
			flex-direction: row;

			.persion-card-item{
				flex:1;
				margin: 0 10rpx;
				min-height: 120rpx;
				border-radius: 18rpx;
				padding: 20rpx 24rpx;
				background: rgba(255, 255, 255, 0.12);
				box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.18);
			}
			.persion-card-item-title{
				font-size: 22rpx;
				line-height: 1.4;
				color: #ffffff;
			}
			.persion-card-item-content{
				margin-top: 20rpx;
				font-size: 40rpx;
				font-weight: 800;
				line-height: 1;
			}
		}
	}
	.card-box{
		display: flex;
		flex-direction: column;
		border-radius: 24rpx;
		margin: 0 24rpx;
		background-color: #ffffff;
		.item{
			display: flex;
			flex-direction: row;
			align-items: center;
			justify-content: space-between;
			padding: 24rpx;
			border-bottom: 1px solid #e7edf5;
			.order-label{
				font-weight: bold;
			}
		}

	}
	.btn-box{
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		margin: 30rpx 24rpx 0 24rpx;
	}
	// 页脚备案号：固定在 tabBar 上方 20rpx（有备案号才渲染，没有则整块不占位）。
	// 用 fixed 而不是流式布局：本页 .container 带 min-height:100% 且位于 topNavBar 之下，
	// 流式放置会被推到「导航栏高度 + 一整屏」处，首屏看不到。
	.icp-footer{
		position: fixed;
		left: 0;
		right: 0;
		// #ifdef MP-WEIXIN
		// 微信原生 tabBar 在页面视口之外，bottom 相对页面区域，故 20rpx 即「tabBar 上方 20rpx」
		bottom: 20rpx;
		// #endif
		// #ifdef H5
		// H5 的 tabBar 由 uni-app 渲染在窗口底部（默认高度 50px），需额外让开它的高度
		bottom: calc(50px + 20rpx);
		// #endif
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		.icp-label{
			margin-right: 8rpx;
			font-size: 22rpx;
			color: #9ca3af;
		}
		.icp-value{
			font-size: 22rpx;
			color: #9ca3af;
		}
	}
}
</style>
