:host{display:flex;flex-direction:column}

.payment-content.data-v-0c94e3a5 {
	background-color: #fff;
	padding: 32rpx 32rpx 48rpx;
	box-sizing: border-box;
}
.payment-info.data-v-0c94e3a5 {
	margin-bottom: 32rpx;
}
.info-title.data-v-0c94e3a5 {
	font-size: 36rpx;
	font-weight: 600;
	color: #333;
	text-align: center;
	border-bottom: 1px solid #eef2f7;
	margin-bottom: 40rpx;
	padding-bottom: 20rpx;
}
.info-item.data-v-0c94e3a5 {
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	padding: 20rpx 0;
}
.item-label.data-v-0c94e3a5 {
	font-size: 28rpx;
	color: #64748b;
}
.item-value.data-v-0c94e3a5 {
	font-size: 30rpx;
	color: #333;
	font-weight: bold;
}
.amount.data-v-0c94e3a5 {
	color: #f23030;
	font-size: 32rpx;
	font-weight: 700;
}
.method-section.data-v-0c94e3a5 {
	margin-top: 8rpx;
}
.section-title.data-v-0c94e3a5 {
	font-size: 24rpx;
	color: #64748b;
	margin-bottom: 24rpx;
	display: block;
}
.method-option.data-v-0c94e3a5 {
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	align-items: center;
	padding: 24rpx;
	margin-bottom: 24rpx;
	border: 2rpx solid #e5e5e5;
	border-radius: 16rpx;
	background-color: #fff;
	transition: all 0.3s ease;
}

/* 支付方式选中状态 */
.method-option.method-selected.data-v-0c94e3a5 {
	border-color: #2563eb;
	background-color: #f8fbff;
}
.method-left.data-v-0c94e3a5 {
	flex: 1;
	display: flex;
	flex-direction: column;
}

/* 图标和文字头部布局 */
.method-header.data-v-0c94e3a5 {
	display: flex;
	flex-direction: row;
	align-items: center;
	gap: 16rpx;
}

/* 支付图标样式 */
.method-icon.data-v-0c94e3a5 {
	width: 48rpx;
	height: 48rpx;
	flex-shrink: 0;
}
.method-label.data-v-0c94e3a5 {
	font-size: 28rpx;
	color: #333;
	font-weight: 500;
}
.method-desc.data-v-0c94e3a5 {
	font-size: 22rpx;
	color: #999;
	margin-top: 6rpx;
}
.method-right.data-v-0c94e3a5 {
	padding-left: 20rpx;
}

/* 自定义单选按钮 */
.radio.data-v-0c94e3a5 {
	width: 25rpx;
	height: 25rpx;
	border-radius: 50%;
	border: 2rpx solid #ddd;
	background-color: #fff;
	position: relative;
	box-sizing: border-box;
	transition: all 0.2s ease;
}
.radio-selected.data-v-0c94e3a5 {
	border-color: #2563eb;
	background-color: #2563eb;
}
.action-buttons.data-v-0c94e3a5 {
	display: flex;
	flex-direction: row;
	justify-content: space-between;
	gap: 24rpx;
}
.btn.data-v-0c94e3a5 {
	flex: 1;
	text-align: center;
	border-radius: 20rpx;
	font-size: 32rpx;
	font-weight: 500;
	border: none;
	background-color: transparent;
	height: 88rpx;
	line-height: 88rpx;
}
.cancel-btn.data-v-0c94e3a5 {
	background-color: #ffffff;
	border: 1rpx solid #dbe5f0;
	color: #334155;
}
.confirm-btn.data-v-0c94e3a5 {
	background: linear-gradient(135deg, #2563eb 0%, #4c88f4 100%);
	color: #ffffff;
}
.mr-24.data-v-0c94e3a5 {
	margin-right: 24rpx;
}
.ml-24.data-v-0c94e3a5 {
	margin-left: 24rpx;
}