<template>
	<topNavBar title="我的反馈" :show-back="true" @back="goBack" backgroundColor="#f4f7fb" textColor="#333" :showCapsule="false"></topNavBar>
	<view class="page-container">
		<!-- 反馈列表 -->
		<view class="feedback-list" v-if="feedbackList.length > 0">
			<view class="feedback-item" v-for="(item, index) in feedbackList" :key="index" @click="handleDetail(item.id)">
				<view class="item-header">
					<text class="feedback-no">{{ item.feedbackNo }}</text>
				</view>
				<view class="item-content">{{ item.feedbackContent || '-' }}</view>
				<view v-if="item.replyContent" class="latest-reply">
					<text class="latest-reply-label">最新回复</text>
					<text class="latest-reply-content">{{ item.replyContent }}</text>
				</view>
				<view class="order-no">订单编号：{{ item.orderNo || '-' }}</view>
				<view class="item-footer">
					<text class="time">{{ item.createTime }}</text>
					<rice-tag :type="getStatusType(item.status)" :text="getStatusText(item.status)" size="small" plain-fill></rice-tag>
				</view>
			</view>
		</view>

		<!-- 空状态 -->
		<view class="empty-state" v-else-if="!loading">
			<text class="empty-text">暂无反馈记录</text>
		</view>
	</view>
</template>

<script setup lang="uts">
	import { ref } from 'vue'
	import { getFeedbackList } from '@/api/http.uts'

	type FeedbackItem = {
		id: number,
		feedbackNo: string,
		feedbackType: string,
		feedbackContent: string,
		status: string,
		createTime: string,
		userPhone: string,
		imgOssUrl: string,
		orderNo: string,
		packageName: string,
		replyContent: string
	}

	const rechargeNo = ref('')
	const loading = ref(true)
	const feedbackList = ref<FeedbackItem[]>([])

	// 获取状态标签类型
	const getStatusType = (status: string): string => {
		const typeMap = new Map<string, string>()
		typeMap.set('0', 'warning')
		typeMap.set('1', 'primary')
		typeMap.set('2', 'success')
		typeMap.set('3', 'default')
		return typeMap.get(status) ?? 'default'
	}

	// 获取状态文字
	const getStatusText = (status: string): string => {
		const textMap = new Map<string, string>()
		textMap.set('0', '待处理')
		textMap.set('1', '处理中')
		textMap.set('2', '已回复')
		textMap.set('3', '已关闭')
		return textMap.get(status) ?? status
	}

	// 查询反馈列表
	const loadFeedbackList = async () => {
		loading.value = true
		try {
			const res = await getFeedbackList(rechargeNo.value, false)
			if (res.code == 200) {
				const rows = res.data as FeedbackItem[]
				if (rows != null && Array.isArray(rows)) {
					feedbackList.value = rows
				} else {
					feedbackList.value = []
				}
			} else {
				uni.showToast({ title: res.msg ?? '查询失败', icon: 'none' })
			}
		} catch (error) {
			uni.__f__('error','at pages/questionFeedback/list.uvue:88','查询反馈列表异常:', error)
		} finally {
			loading.value = false
		}
	}

	// 查看详情
	const handleDetail = (id: number) => {
		uni.navigateTo({
			url: `/pages/questionFeedback/detail?feedbackId=${id}`
		})
	}

	const goBack = () => {
		uni.navigateBack({ delta: 1 })
	}

	onLoad((options) => {
		rechargeNo.value = options.rechargeNo ?? ''
		loadFeedbackList()
	})
</script>

<style lang="scss" scoped>
.page-container {
	display: flex;
	flex-direction: column;

	min-height: 100%;

	background-color: #f5f7fa;
	padding-bottom: 48rpx;
}

.feedback-list {
	padding: 20rpx;
}

.feedback-item {
	margin-bottom: 20rpx;
	padding: 28rpx;
	border: 0;
	border-radius: 20rpx;
	background-color: #ffffff;

	.item-header {
		display: flex;
		flex-direction: row;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 16rpx;

		.feedback-no {
			font-size: 26rpx;
			color: #303133;
			font-weight: 600;
		}
	}

	.item-content {
		font-size: 28rpx;
		color: #303133;
		line-height: 1.6;
		margin-bottom: 16rpx;
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		overflow: hidden;
	}

	.latest-reply {
		display: flex;
		flex-direction: column;
		gap: 8rpx;
		margin: 20rpx 0;
		padding: 16rpx;
		border-radius: 16rpx;
		background-color: #f4f4f4;

		.latest-reply-label {
			font-size: 24rpx;
			color: #909399;
		}

		.latest-reply-content {
			display: -webkit-box;
			overflow: hidden;
			color: #606266;
			font-size: 26rpx;
			line-height: 1.5;
			-webkit-box-orient: vertical;
			-webkit-line-clamp: 2;
		}
	}

	.order-no {
		margin-bottom: 20rpx;
		font-size: 26rpx;
		color: #606266;
	}

	.item-footer {
		display: flex;
		flex-direction: row;
		justify-content: space-between;
		align-items: center;

		.time {
			font-size: 22rpx;
			color: #909399;
		}
	}
}

.empty-state {
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	padding: 120rpx 32rpx;

	.empty-text {
		font-size: 28rpx;
		color: #9ca3af;
	}
}

.loading-box {
	display: flex;
	flex-direction: column;
	align-items: center;
	justify-content: center;
	padding: 60px 0;
	color: #909399;
	font-size: 16px;
	gap: 12px;
}

.loading-box .el-icon {
	font-size: 28px;
}
</style>