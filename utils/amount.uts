/**
 * 金额工具类
 * 提供金额格式化、加减乘除等安全计算方法
 * 核心思路：基于"分"（整数）进行计算，避免 JavaScript 浮点数精度问题
 */

export class AmountUtil {

	/**
	 * 将金额字符串/数值解析为安全的数字（保留两位小数）
	 * 处理 null、undefined、空字符串、NaN 等边界情况
	 */
	static parse(amount: any): number {
		if (amount == null || amount === '') return 0
		const num = parseFloat(String(amount))
		if (isNaN(num) || !isFinite(num)) return 0
		return num
	}

	/**
	 * 元 → 分（用于安全计算）
	 * 例：12.34 → 1234
	 */
	static yuanToFen(amount: any): number {
		const yuan = AmountUtil.parse(amount)
		// 乘以100并四舍五入，避免浮点数精度问题
		return Math.round(yuan * 100)
	}

	/**
	 * 分 → 元
	 * 例：1234 → 12.34
	 */
	static fenToYuan(fen: any): number {
		const f = AmountUtil.parse(fen)
		return f / 100
	}

	/**
	 * 加法（安全，基于分计算）
	 * 例：add(0.1, 0.2) → 0.3 而非 0.30000000000000004
	 */
	static add(a: any, b: any): number {
		const fenA = AmountUtil.yuanToFen(a)
		const fenB = AmountUtil.yuanToFen(b)
		return (fenA + fenB) / 100
	}

	/**
	 * 减法（安全，基于分计算）
	 * 例：subtract(1.0, 0.9) → 0.1 而非 0.09999999999999998
	 */
	static subtract(a: any, b: any): number {
		const fenA = AmountUtil.yuanToFen(a)
		const fenB = AmountUtil.yuanToFen(b)
		return (fenA - fenB) / 100
	}

	/**
	 * 乘法（安全，基于分计算）
	 * 例：multiply(0.57, 100) → 57 而非 56.99999999999999
	 */
	static multiply(a: any, b: any): number {
		const fenA = AmountUtil.yuanToFen(a)
		const bNum = AmountUtil.parse(b)
		// (fenA * bNum) / 100，先乘后除
		return Math.round(fenA * bNum) / 100
	}

	/**
	 * 除法（安全，基于分计算）
	 * decimal: 保留小数位数，默认2位
	 */
	static divide(a: any, b: any, decimal: number = 2): number {
		const fenA = AmountUtil.yuanToFen(a)
		const bNum = AmountUtil.parse(b)
		if (bNum === 0) {
			console.warn('AmountUtil.divide: 除数不能为0')
			return 0
		}
		const result = fenA / bNum / 100
		const factor = Math.pow(10, decimal)
		return Math.round(result * factor) / factor
	}

	/**
	 * 格式化金额为显示字符串
	 * @param amount 金额（元）
	 * @param options.symbol 货币符号，默认 ¥
	 * @param options.decimal 小数位数，默认 2
	 * @param options.showSymbol 是否显示符号，默认 true
	 * @param options.separator 千分位分隔符，默认 ,
	 * @returns 格式化后的字符串，如 "¥1,234.56"
	 */
	static format(amount: any, options?: {
		symbol?: string,
		decimal?: number,
		showSymbol?: boolean,
		separator?: string
	}): string {
		const num = AmountUtil.parse(amount)
		const symbol = options?.symbol ?? '¥'
		const decimal = options?.decimal ?? 2
		const showSymbol = options?.showSymbol ?? true
		const separator = options?.separator ?? ','

		// 处理负数
		const isNegative = num < 0
		const absNum = Math.abs(num)

		// 保留指定小数位
		const fixed = absNum.toFixed(decimal)
		const parts = fixed.split('.')
		const intPart = parts[0]
		const decPart = parts.length > 1 ? parts[1] : ''

		// 添加千分位分隔符
		let formattedInt = ''
		const len = intPart.length
		for (let i = 0; i < len; i++) {
			if (i > 0 && (len - i) % 3 === 0) {
				formattedInt += separator
			}
			formattedInt += intPart.charAt(i)
		}

		// 组装结果
		let result = formattedInt
		if (decimal > 0) {
			result += '.' + decPart
		}

		if (isNegative) {
			result = '-' + result
		}

		if (showSymbol) {
			result = symbol + result
		}

		return result
	}

	/**
	 * 格式化为人民币大写
	 * 例：1234.56 → "壹仟贰佰叁拾肆元伍角陆分"
	 */
	static formatChinese(amount: any): string {
		const num = AmountUtil.parse(amount)
		if (num === 0) return '零元整'

		const digits = ['零', '壹', '贰', '叁', '肆', '伍', '陆', '柒', '捌', '玖']
		const radices = ['', '拾', '佰', '仟', '万', '拾', '佰', '仟', '亿']
		const bigRadices = ['', '万', '亿', '万亿']

		// 处理负数
		const isNegative = num < 0
		let absNum = Math.abs(num)

		// 分离整数和小数部分
		const intPart = Math.floor(absNum)
		const decPart = Math.round((absNum - intPart) * 100)

		let result = ''

		// 处理整数部分
		if (intPart === 0) {
			result = '零元'
		} else {
			let intStr = ''
			const intStrNum = intPart.toString()
			const len = intStrNum.length

			for (let i = 0; i < len; i++) {
				const d = parseInt(intStrNum.charAt(i))
				const radix = len - i - 1

				if (d === 0) {
					// 万、亿需要保留单位
					if (radix % 4 === 0 && intStr.length > 0) {
						intStr += radices[radix]
					} else {
						// 连续的零只保留一个
						if (!intStr.endsWith('零')) {
							intStr += '零'
						}
					}
				} else {
					intStr += digits[d] + radices[radix % radices.length]
					// 万、亿位置需要额外处理
					if (radix % 4 === 0 && radix > 0) {
						intStr += bigRadices[Math.floor(radix / 4)]
					}
				}
			}

			// 去掉末尾的零
			intStr = intStr.replace(/零+$/, '')
			result = intStr + '元'
		}

		// 处理小数部分
		if (decPart === 0) {
			result += '整'
		} else {
			const jiao = Math.floor(decPart / 10)
			const fen = decPart % 10

			if (jiao > 0) {
				result += digits[jiao] + '角'
			} else {
				result += '零'
			}

			if (fen > 0) {
				result += digits[fen] + '分'
			}
		}

		if (isNegative) {
			result = '负' + result
		}

		return result
	}

	/**
	 * 判断两个金额是否相等
	 */
	static equal(a: any, b: any): boolean {
		return AmountUtil.yuanToFen(a) === AmountUtil.yuanToFen(b)
	}

	/**
	 * 判断 a 是否大于 b
	 */
	static greaterThan(a: any, b: any): boolean {
		return AmountUtil.yuanToFen(a) > AmountUtil.yuanToFen(b)
	}

	/**
	 * 判断 a 是否小于 b
	 */
	static lessThan(a: any, b: any): boolean {
		return AmountUtil.yuanToFen(a) < AmountUtil.yuanToFen(b)
	}

	/**
	 * 取最大值
	 */
	static max(...amounts: any[]): number {
		if (amounts.length === 0) return 0
		let maxFen = AmountUtil.yuanToFen(amounts[0])
		for (let i = 1; i < amounts.length; i++) {
			const fen = AmountUtil.yuanToFen(amounts[i])
			if (fen > maxFen) maxFen = fen
		}
		return maxFen / 100
	}

	/**
	 * 取最小值
	 */
	static min(...amounts: any[]): number {
		if (amounts.length === 0) return 0
		let minFen = AmountUtil.yuanToFen(amounts[0])
		for (let i = 1; i < amounts.length; i++) {
			const fen = AmountUtil.yuanToFen(amounts[i])
			if (fen < minFen) minFen = fen
		}
		return minFen / 100
	}
}
